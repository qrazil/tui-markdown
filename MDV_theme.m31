// What a span looks like: style bits to terminal colours.
//
// A layout says what each run IS (`MDV_model` style bits); this module is the
// only place that says what that looks like. A theme is a small palette of
// named colours (background, text, a dim grey, and the six or seven hues of a
// colour scheme) from which everything else is derived: tints for block
// quotes, callouts, code cards and table headers are mixes of the background
// with a hue, so a new scheme is one table of hex values and nothing else.
//
// Colours are 24-bit; `TUI_style.sgr` folds them to the 256 or 16 colours a
// terminal has when it must, so no theme needs a second table. `plain()` is
// the theme for NO_COLOR: no colour and no attribute either, so a pipe gets
// text.
//
// Transparency (docs/TRANSPARENCY.md): a terminal shows the desktop through a
// cell only when the cell's background is the terminal's own, so a theme that
// paints every surface is opaque on a terminal with opacity or blur.
// `Theme.transparency` (OFF, ALL, POPUPS) makes every style that leaves this
// module pass through `transparent_style`, the one place that decides which
// backgrounds survive. Nothing outside this module builds a colour of its own.

import MDV_model;
import tui.core.TUI_style;

/// The colours a scheme is made of, each 0xRRGGBB.
pub type Palette {
    pub int page = 0;
    pub int ink = 0;
    /// Comments and chrome.
    pub int dim = 0;
    pub int red = 0;
    pub int orange = 0;
    pub int yellow = 0;
    pub int green = 0;
    pub int cyan = 0;
    pub int blue = 0;
    pub int purple = 0;
    /// The selection's background.
    pub int selection = 0;
}

/// Transparency off: every style is the theme's own.
pub const int OFF = 0;
/// Every surface drops its background.
pub const int ALL = 1;
/// Only popups, menus and the find bar drop theirs.
pub const int POPUPS = 2;
/// What a style is, for `transparent_style`.
/// A surface: the page, bars, the sidebar, tints behind text.
const int SURFACE = 0;
/// A highlight (selection, search hit, the focused link, a chosen row): keeps its background.
const int HIGHLIGHT = 1;
/// A badge (a mode label, a button, the open tab): a colour block that becomes coloured text.
const int BADGE = 2;
/// A popup or a bar over the page: the surfaces POPUPS also makes transparent.
const int POPUP = 3;

pub type Theme {
    pub str name;
    pub bool is_dark;
    /// No colour, no attributes: text only.
    pub bool is_plain = false;
    pub Palette colours = Palette();
    /// OFF, ALL or POPUPS.
    pub int transparency = 0;
}

/// `theme` with transparency `mode`.
pub Theme with_transparency(Theme theme, int mode) {
    return Theme(theme.name, theme.is_dark, is_plain: theme.is_plain, colours: theme.colours, transparency: mode);
}

/// The mode a word names: on / 1 / true, popups, off / 0 / false (and nothing at all); -1 for anything else.
pub int mode_of(str word) {
    str lower = word.to_lower();
    if (lower == "on" || lower == "1" || lower == "true" || lower == "all") {
        return ALL;
    }
    if (lower == "popups") {
        return POPUPS;
    }
    if (lower == "off" || lower == "0" || lower == "false" || lower == "") {
        return OFF;
    }
    return -1;
}

Palette palette(int page, int ink, int dim, int red, int orange, int yellow, int green, int cyan, int blue, int purple, int selection) {
    Palette out = Palette();
    out.page = page;
    out.ink = ink;
    out.dim = dim;
    out.red = red;
    out.orange = orange;
    out.yellow = yellow;
    out.green = green;
    out.cyan = cyan;
    out.blue = blue;
    out.purple = purple;
    out.selection = selection;
    return out;
}

/// GitHub's dark palette.
pub Theme dark() {
    return Theme("dark", true, colours: palette(0x0d1117, 0xe6edf3, 0x8b949e, 0xf85149, 0xdb6d28, 0xd29922, 0x3fb950, 0x39c5cf, 0x58a6ff, 0xa371f7, 0x264f78));
}

/// GitHub's light palette.
pub Theme light() {
    return Theme("light", false, colours: palette(0xffffff, 0x1f2328, 0x59636e, 0xd1242f, 0xbc4c00, 0x9a6700, 0x1a7f37, 0x0a7ea4, 0x0969da, 0x8250df, 0xb6e3ff));
}

pub Theme tokyonight() {
    return Theme("tokyonight", true, colours: palette(0x1a1b26, 0xc0caf5, 0x565f89, 0xf7768e, 0xff9e64, 0xe0af68, 0x9ece6a, 0x7dcfff, 0x7aa2f7, 0xbb9af7, 0x283457));
}

pub Theme nightfox() {
    return Theme("nightfox", true, colours: palette(0x192330, 0xcdcecf, 0x738091, 0xc94f6d, 0xf4a261, 0xdbc074, 0x81b29a, 0x63cdcf, 0x719cd6, 0x9d79d6, 0x2b3b51));
}

pub Theme gruvbox() {
    return Theme("gruvbox-material", true, colours: palette(0x282828, 0xd4be98, 0x928374, 0xea6962, 0xe78a4e, 0xd8a657, 0xa9b665, 0x89b482, 0x7daea3, 0xd3869b, 0x45403d));
}

pub Theme plain() {
    return Theme("plain", true, is_plain: true);
}

/// The names `named` knows, in the order a menu shows them.
pub List<str> names() {
    return ["dark", "light", "tokyonight", "nightfox", "gruvbox-material", "plain"];
}

/// The theme called `name`, if there is one.
pub Option<Theme> named(str name) {
    if (name == "dark") {
        return Option<Theme>.Some(dark());
    }
    if (name == "light") {
        return Option<Theme>.Some(light());
    }
    if (name == "tokyonight") {
        return Option<Theme>.Some(tokyonight());
    }
    if (name == "nightfox") {
        return Option<Theme>.Some(nightfox());
    }
    if (name == "gruvbox-material" || name == "gruvbox") {
        return Option<Theme>.Some(gruvbox());
    }
    if (name == "plain") {
        return Option<Theme>.Some(plain());
    }
    return Option<Theme>.None;
}

/// The theme after `current` in `names()`, wrapping; plain is skipped.
pub Theme next_after(Theme current) {
    List<str> all = names();
    int slot = all.index_of(current.name).or(0);
    int target = (slot + 1) % (all.size() - 1);
    return with_transparency(named(all[target]).or(dark()), current.transparency);
}

// --- colour arithmetic ---------------------------------------------------------------

/// `from` moved `percent` of the way to `toward`, per channel.
pub int mix(int from, int toward, int percent) {
    int red = channel(from, 16) + (channel(toward, 16) - channel(from, 16)) * percent / 100;
    int green = channel(from, 8) + (channel(toward, 8) - channel(from, 8)) * percent / 100;
    int blue = channel(from, 0) + (channel(toward, 0) - channel(from, 0)) * percent / 100;
    return red * 65536 + green * 256 + blue;
}

int channel(int rgb, int shift) {
    if (shift == 16) {
        return rgb / 65536 % 256;
    }
    if (shift == 8) {
        return rgb / 256 % 256;
    }
    return rgb % 256;
}

TUI_style.Colour colour(int rgb) {
    return TUI_style.Colour.Rgb(channel(rgb, 16), channel(rgb, 8), channel(rgb, 0));
}

// --- derived shades ------------------------------------------------------------------

int card_bg(Palette pal) {
    return mix(pal.page, pal.ink, 7);
}

int chip_bg(Palette pal) {
    return mix(pal.page, pal.ink, 16);
}

int zebra_bg(Palette pal) {
    return mix(pal.page, pal.ink, 5);
}

int head_bg(Palette pal) {
    return mix(pal.page, pal.blue, 18);
}

int band_bg(Palette pal) {
    return mix(pal.page, pal.blue, 34);
}

/// The hue of callout `kind` (1 note .. 5 caution).
pub int callout_hue(Palette pal, int kind) {
    if (kind == 1) {
        return pal.blue;
    }
    if (kind == 2) {
        return pal.green;
    }
    if (kind == 3) {
        return pal.purple;
    }
    if (kind == 4) {
        return pal.yellow;
    }
    if (kind == 5) {
        return pal.red;
    }
    return pal.dim;
}

int tint_bg(Palette pal, int kind) {
    if (kind == 0) {
        return mix(pal.page, pal.dim, 16);
    }
    return mix(pal.page, callout_hue(pal, kind), 11);
}

int heading_hue(Palette pal, int level) {
    if (level == 1) {
        return pal.ink;
    }
    if (level == 2) {
        return pal.blue;
    }
    if (level == 3) {
        return pal.green;
    }
    if (level == 4) {
        return pal.yellow;
    }
    if (level == 5) {
        return pal.purple;
    }
    return pal.cyan;
}

int syntax_hue(Palette pal, int class_value) {
    // COMMENT STRING NUMBER KEYWORD TYPE FUNCTION PREPROC CONSTANT OPERATOR SPECIAL TITLE
    if (class_value == 1) {
        return pal.dim;
    }
    if (class_value == 2) {
        return pal.green;
    }
    if (class_value == 3) {
        return pal.orange;
    }
    if (class_value == 4) {
        return pal.purple;
    }
    if (class_value == 5) {
        return pal.yellow;
    }
    if (class_value == 6) {
        return pal.blue;
    }
    if (class_value == 7) {
        return pal.cyan;
    }
    if (class_value == 8) {
        return pal.orange;
    }
    if (class_value == 9) {
        return pal.cyan;
    }
    if (class_value == 10) {
        return pal.cyan;
    }
    if (class_value == 11) {
        return pal.yellow;
    }
    return pal.ink;
}

bool is_on(int bits, int bit) {
    return (bits & bit) != 0;
}

/// The style of a span whose style bits are `bits`: the theme's look, then
/// what transparency leaves of it.
pub TUI_style.Style style_for(Theme theme, int bits) {
    TUI_style.Style look = look_for(theme, bits);
    if (theme.transparency == OFF) {
        return look;
    }
    if (is_on(bits, MDV_model.SELECTED)) {
        return transparent_style(theme.transparency, HIGHLIGHT, look);
    }
    TUI_style.Style out = transparent_style(theme.transparency, SURFACE, look);
    if (theme.transparency == ALL && is_on(bits, MDV_model.ZEBRA) && !theme.is_plain) {
        // The shade is gone: the alternate rows are told apart by being dim.
        out = out.with_attrs(out.attrs | TUI_style.DIM);
    }
    return out;
}

TUI_style.Style look_for(Theme theme, int bits) {
    if (theme.is_plain) {
        return TUI_style.Style();
    }
    Palette pal = theme.colours;
    int attrs = 0;
    int fore = pal.ink;
    int back = pal.page;
    int level = MDV_model.level_of(bits);
    int kind = MDV_model.callout_of(bits);
    if (is_on(bits, MDV_model.BOLD)) {
        attrs = attrs | TUI_style.BOLD;
    }
    if (is_on(bits, MDV_model.ITALIC)) {
        attrs = attrs | TUI_style.ITALIC;
    }
    if (is_on(bits, MDV_model.STRIKE)) {
        attrs = attrs | TUI_style.STRIKE;
        fore = mix(pal.ink, pal.dim, 55);
    }
    if (is_on(bits, MDV_model.QUOTE)) {
        back = tint_bg(pal, kind);
        fore = mix(pal.ink, pal.dim, 15);
    }
    if (is_on(bits, MDV_model.ZEBRA)) {
        back = zebra_bg(pal);
    }
    if (is_on(bits, MDV_model.HEAD_CELL)) {
        back = head_bg(pal);
        fore = pal.blue;
        attrs = attrs | TUI_style.BOLD;
    }
    if (level > 0) {
        fore = heading_hue(pal, level);
        attrs = attrs | TUI_style.BOLD;
        if (level == 1 && is_on(bits, MDV_model.BANNER)) {
            back = band_bg(pal);
        }
        if (level == 5) {
            attrs = attrs | TUI_style.ITALIC;
        }
    }
    if (is_on(bits, MDV_model.CODE)) {
        fore = pal.orange;
        back = chip_bg(pal);
    }
    if (is_on(bits, MDV_model.LINK)) {
        attrs = attrs | TUI_style.UNDERLINE;
        fore = pal.cyan;
    }
    if (is_on(bits, MDV_model.BLOCK) || is_on(bits, MDV_model.META)) {
        back = card_bg(pal);
        fore = pal.ink;
        int class_value = MDV_model.syntax_of(bits);
        if (class_value >= 0) {
            fore = syntax_hue(pal, class_value + 0);
            if (class_value == 1) {
                attrs = attrs | TUI_style.ITALIC;
            }
        }
        if (is_on(bits, MDV_model.META)) {
            fore = pal.dim;
        }
    }
    if (is_on(bits, MDV_model.RAW)) {
        int source_class = MDV_model.syntax_of(bits);
        if (source_class >= 0) {
            fore = syntax_hue(pal, source_class + 0);
            if (source_class == 1) {
                attrs = attrs | TUI_style.ITALIC;
            }
            if (source_class == 11) {
                attrs = attrs | TUI_style.BOLD;
            }
        }
    }
    if (is_on(bits, MDV_model.CHIP)) {
        back = chip_bg(pal);
        fore = pal.cyan;
        attrs = attrs | TUI_style.BOLD;
    }
    if (is_on(bits, MDV_model.GUTTER)) {
        fore = pal.dim;
    }
    if (is_on(bits, MDV_model.IMAGE)) {
        attrs = attrs | TUI_style.ITALIC;
    }
    if (is_on(bits, MDV_model.FOOT)) {
        fore = pal.purple;
    }
    if (is_on(bits, MDV_model.DECO)) {
        if (is_on(bits, MDV_model.BULLET) || is_on(bits, MDV_model.TASK)) {
            fore = pal.blue;
            attrs = attrs | TUI_style.BOLD;
        } else if (is_on(bits, MDV_model.GUIDE) || is_on(bits, MDV_model.RULE) || is_on(bits, MDV_model.GUTTER)) {
            fore = mix(pal.page, pal.dim, 70);
        } else if (is_on(bits, MDV_model.BORDER)) {
            fore = mix(pal.page, pal.dim, 80);
            if (kind > 0) {
                fore = callout_hue(pal, kind);
            }
        } else if (is_on(bits, MDV_model.TITLE)) {
            fore = callout_hue(pal, kind);
            attrs = attrs | TUI_style.BOLD;
        } else if (is_on(bits, MDV_model.UNDER)) {
            fore = mix(pal.page, heading_hue(pal, level), 60);
            if (level == 1) {
                fore = mix(pal.page, pal.blue, 75);
            }
            back = pal.page;
        } else if (is_on(bits, MDV_model.BANNER) && level > 1) {
            fore = heading_hue(pal, level);
        } else if (is_on(bits, MDV_model.QUOTE)) {
            fore = mix(pal.page, pal.dim, 90);
            if (kind > 0) {
                fore = callout_hue(pal, kind);
            }
        } else if (is_on(bits, MDV_model.IMAGE)) {
            fore = pal.dim;
        }
        if (is_on(bits, MDV_model.BANNER) && level == 1 && !is_on(bits, MDV_model.UNDER)) {
            fore = pal.ink;
        }
    }
    if (is_on(bits, MDV_model.SELECTED)) {
        back = pal.selection;
    }
    return TUI_style.Style(foreground: colour(fore), background: colour(back), attrs: attrs);
}

/// The base style of the whole screen: text on the scheme's background.
pub TUI_style.Style base_style(Theme theme) {
    return transparent_style(theme.transparency, SURFACE, base_look(theme));
}

TUI_style.Style base_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style();
    }
    return TUI_style.Style(foreground: colour(theme.colours.ink), background: colour(theme.colours.page));
}

/// The style of a search hit; the current one stands out from the rest.
pub TUI_style.Style hit_style(Theme theme, bool is_current) {
    return transparent_style(theme.transparency, HIGHLIGHT, hit_look(theme, is_current));
}

TUI_style.Style hit_look(Theme theme, bool is_current) {
    if (theme.is_plain) {
        if (is_current) {
            return TUI_style.Style(attrs: TUI_style.REVERSE | TUI_style.BOLD | TUI_style.UNDERLINE);
        }
        return TUI_style.Style(attrs: TUI_style.REVERSE);
    }
    Palette pal = theme.colours;
    if (is_current) {
        return TUI_style.Style(foreground: colour(pal.page), background: colour(pal.orange), attrs: TUI_style.BOLD);
    }
    return TUI_style.Style(foreground: colour(pal.page), background: colour(pal.yellow));
}

/// `base`, marked as the focused link.
pub TUI_style.Style focus_style(Theme theme, TUI_style.Style base) {
    if (theme.transparency != ALL || theme.is_plain) {
        return base.with_attrs(base.attrs | TUI_style.REVERSE | TUI_style.BOLD);
    }
    // Reverse video would paint the terminal's own text colour as a background:
    // the same swap with the theme's colours, and no colour read from the desktop.
    TUI_style.Colour block = base.foreground;
    if (block.eq(TUI_style.Colour.Default)) {
        block = colour(theme.colours.ink);
    }
    return TUI_style.Style(foreground: readable_on(block), background: block, attrs: base.attrs | TUI_style.BOLD);
}

/// The status line and the toolbar.
pub TUI_style.Style status_style(Theme theme) {
    return transparent_style(theme.transparency, SURFACE, status_look(theme));
}

TUI_style.Style status_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style(attrs: TUI_style.REVERSE);
    }
    Palette pal = theme.colours;
    return TUI_style.Style(foreground: colour(pal.ink), background: colour(mix(pal.page, pal.ink, 12)));
}

/// A status-line segment that is a button or a mode label.
pub TUI_style.Style accent_style(Theme theme) {
    return transparent_style(theme.transparency, BADGE, accent_look(theme));
}

/// The chosen row of a list (the command palette, the outline popup): the
/// accent look, kept as a highlight.
pub TUI_style.Style select_style(Theme theme) {
    return transparent_style(theme.transparency, HIGHLIGHT, accent_look(theme));
}

TUI_style.Style accent_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style(attrs: TUI_style.REVERSE | TUI_style.BOLD);
    }
    Palette pal = theme.colours;
    return TUI_style.Style(foreground: colour(pal.page), background: colour(pal.blue), attrs: TUI_style.BOLD);
}

/// The dim text of chrome outside the document (breadcrumb separators).
pub TUI_style.Style quiet_style(Theme theme) {
    return transparent_style(theme.transparency, SURFACE, quiet_look(theme));
}

TUI_style.Style quiet_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style(attrs: TUI_style.DIM);
    }
    Palette pal = theme.colours;
    return TUI_style.Style(foreground: colour(pal.dim), background: colour(mix(pal.page, pal.ink, 12)));
}

/// Popups sit on a background of their own so the text under them does not
/// show through.
pub TUI_style.Style popup_style(Theme theme) {
    return transparent_style(theme.transparency, POPUP, popup_look(theme));
}

TUI_style.Style popup_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style();
    }
    Palette pal = theme.colours;
    return TUI_style.Style(foreground: colour(pal.ink), background: colour(mix(pal.page, pal.ink, 9)));
}

/// The sidebar's background: a hair off the page.
pub TUI_style.Style side_style(Theme theme) {
    return transparent_style(theme.transparency, SURFACE, side_look(theme));
}

TUI_style.Style side_look(Theme theme) {
    if (theme.is_plain) {
        return TUI_style.Style();
    }
    Palette pal = theme.colours;
    return TUI_style.Style(foreground: colour(pal.ink), background: colour(mix(pal.page, pal.ink, 4)));
}

/// The scrollbar thumb and track.
pub TUI_style.Style thumb_style(Theme theme, bool is_thumb) {
    return transparent_style(theme.transparency, SURFACE, thumb_look(theme, is_thumb));
}

TUI_style.Style thumb_look(Theme theme, bool is_thumb) {
    if (theme.is_plain) {
        return TUI_style.Style();
    }
    Palette pal = theme.colours;
    if (is_thumb) {
        return TUI_style.Style(foreground: colour(mix(pal.page, pal.dim, 90)), background: colour(pal.page));
    }
    return TUI_style.Style(foreground: colour(mix(pal.page, pal.dim, 25)), background: colour(pal.page));
}

// --- transparency ---------------------------------------------------------------------

/// The relative luminance of 0xRRGGBB in thousandths (sRGB approximated by squaring each
/// channel): near-black text reads on a background above 179, near-white below it, which
/// is where the two have the same contrast ratio.
int luminance(int rgb) {
    int red = channel(rgb, 16);
    int green = channel(rgb, 8);
    int blue = channel(rgb, 0);
    return (299 * red * red + 587 * green * green + 114 * blue * blue) / 65025;
}

/// Near-black or near-white, whichever reads on `block` (a background); the
/// colour itself when it cannot be told (the terminal's default).
TUI_style.Colour readable_on(TUI_style.Colour block) {
    int rgb = 0;
    match (block) {
        case Default: {
            return block;
        }
        case Indexed(int index): {
            rgb = TUI_style.palette_rgb(index);
        }
        case Rgb(int red, int green, int blue): {
            rgb = red * 65536 + green * 256 + blue;
        }
    }
    if (luminance(rgb) >= 179) {
        return colour(0x101010);
    }
    return colour(0xf5f5f5);
}

/// What is left of `style` (of kind `kind`) when the terminal is asked to show the
/// desktop. This is the one place that says so: a terminal paints every explicit
/// background opaque, so only a highlight may keep one.
///
///   HIGHLIGHT  keeps its background and gets text that reads on it (ALL);
///   BADGE      the block goes, its colour becomes the (bold) text colour (ALL);
///   POPUP      loses its background in ALL and in POPUPS;
///   SURFACE    loses its background in ALL.
///
/// A reversed style that is not a highlight loses its reversal (reverse video
/// paints the terminal's text colour as a block); no colour of the desktop is
/// ever read or mixed.
pub TUI_style.Style transparent_style(int mode, int kind, TUI_style.Style style) {
    if (mode == OFF) {
        return style;
    }
    if (kind == HIGHLIGHT) {
        if (mode == ALL && !style.background.eq(TUI_style.Colour.Default)) {
            return style.with_foreground(readable_on(style.background));
        }
        return style;
    }
    if (kind == BADGE) {
        if (mode != ALL) {
            return style;
        }
        int attrs = style.attrs | TUI_style.BOLD;
        if ((style.attrs & TUI_style.REVERSE) != 0) {
            return TUI_style.Style(foreground: style.foreground, attrs: attrs ^ TUI_style.REVERSE);
        }
        if (style.background.eq(TUI_style.Colour.Default)) {
            return style.with_attrs(attrs);
        }
        return TUI_style.Style(foreground: style.background, attrs: attrs);
    }
    if (mode == POPUPS || mode == ALL) {
        if (kind == SURFACE && mode == POPUPS) {
            return style;
        }
        int attrs = style.attrs;
        if ((attrs & TUI_style.REVERSE) != 0) {
            attrs = attrs ^ TUI_style.REVERSE;
            if ((attrs & TUI_style.BOLD) == 0) {
                attrs = attrs | TUI_style.DIM;
            }
        }
        return TUI_style.Style(foreground: style.foreground, attrs: attrs);
    }
    return style;
}
