// The program around a `Viewer`: the files it reads, the clipboard it writes
// to, and the clock that notices a file changing.
//
// `Viewer` decides and says what it wants as `Request`s; this carries them
// out. Reading a file is `read_text`; copying is an OSC 52 sequence queued on
// the loop to write; auto-reload is a `stat` on every timer tick,
// comparing size and modification time with the last look.

import MDV_caps;
import MDV_render;
import MDV_theme;
import MDV_viewer;
import date;
import fs;
import io;
import os;
import proc;
import term;
import tui.app.TUI_app;

/// The name shown for text that came from standard input.
pub const str STDIN_NAME = "<stdin>";
/// Longest text put in one OSC 52 sequence (`Loop.copy_limit`). Terminals cap
/// the payload (xterm at 100000 bytes of base64); this stays under that.
pub const int MAX_COPY = 60000;

/// The text of `path`. Bytes that are not UTF-8 are read as Latin-1, so a
/// file in an old encoding still shows rather than failing.
pub Result<str, io.Error> read_text(str path) {
    bytes raw = io.read_bytes(path)?;
    return Result<str, io.Error>.Ok(text_of(raw));
}

/// `raw` as text: UTF-8 when it is, Latin-1 when it is not.
pub str text_of(bytes raw) {
    match (raw.utf8()) {
        case Some(str text): {
            return text;
        }
        case None: {
            List<int> chars = [];
            for (int value in raw) {
                chars.push(value);
            }
            return str.from_chars(chars);
        }
    }
}

/// All of standard input.
pub Result<str, io.Error> read_stdin() {
    io.File input = io.stdin();
    bytes raw = input.read_all()?;
    return Result<str, io.Error>.Ok(text_of(raw));
}

/// What `stat` says about `path` as one comparable string, "" when it cannot.
pub str stamp_of(str path) {
    match (fs.stat(path)) {
        case Ok(fs.Stat info): {
            return str(info.size) + ":" + str(info.mtime_ns);
        }
        case Err(io.Error error): {
            return "";
        }
    }
}

pub type App {
    pub MDV_viewer.Viewer viewer;
    pub MDV_render.Screen screen;
    /// The loop that runs the program: clipboard writes are queued on it.
    pub TUI_app.Loop loop = TUI_app.Loop();
    /// `stamp_of` the file as last read.
    pub str stamp = "";
    /// Should a change on disk reload the file?
    pub bool is_watching = true;
    /// Does `open` rather than `xdg-open` open a URL (macOS)?
    pub bool is_mac = false;
    /// The last left press, for counting double and triple clicks.
    pub int last_press_ns = 0;
    pub int last_press_col = -1;
    pub int last_press_row = -1;
    pub int press_count = 0;
}

void App.reload() {
    if (viewer.name == STDIN_NAME) {
        viewer.message = "standard input cannot be reloaded";
        return;
    }
    match (read_text(viewer.name)) {
        case Ok(str text): {
            stamp = stamp_of(viewer.name);
            viewer.refresh(text);
        }
        case Err(io.Error error): {
            viewer.message = viewer.name + ": " + error.to_str();
        }
    }
}

void App.open_file(str path) {
    match (read_text(path)) {
        case Ok(str text): {
            stamp = stamp_of(path);
            viewer.opened(path, text);
        }
        case Err(io.Error error): {
            viewer.load_failed(path + ": " + error.to_str());
        }
    }
}

/// Write `text` to `path`, and tell the viewer how it went.
void App.save_file(str path, str text) {
    match (io.write(path, text)) {
        case Ok(int count): {
            stamp = stamp_of(path);
            viewer.saved(path);
        }
        case Err(io.Error error): {
            viewer.save_failed(path + ": " + error.to_str());
        }
    }
}

/// Put `text` on the system clipboard with whichever tool there is (OSC 52
/// has already been queued for terminals that take it, such as over ssh).
void App.copy_system(str text) {
    for (List<str> tool in copy_tools()) {
        match (proc.run(tool, input: text.to_bytes(), timeout_ms: 2000, should_check: false, is_quiet: true)) {
            case Ok(proc.Completed done): {
                if (done.is_success()) {
                    return;
                }
            }
            case Err(proc.Error error): {
            }
        }
    }
}

/// Ask the system clipboard for its text and paste it; when there is no
/// tool (or nothing in it) paste what was last copied here.
void App.paste_clipboard() {
    for (List<str> tool in paste_tools()) {
        match (proc.run(tool, timeout_ms: 2000, should_check: false, is_quiet: true)) {
            case Ok(proc.Completed done): {
                if (done.is_success() && done.stdout.size() > 0) {
                    viewer.paste_text(text_of(done.stdout), "");
                    return;
                }
            }
            case Err(proc.Error error): {
            }
        }
    }
    if (viewer.clipboard.size() > 0) {
        viewer.paste_text(viewer.clipboard, "");
    } else {
        viewer.message = "the clipboard is empty";
    }
}

/// Hand `url` to the desktop's opener; when there is none, copy it.
void App.open_url(str url) {
    str opener = "xdg-open";
    match (os.env("OSTYPE")) {
        case Some(str kind): {
            if (kind.starts_with("darwin")) {
                opener = "open";
            }
        }
        case None: {
        }
    }
    if (is_mac) {
        opener = "open";
    }
    match (proc.run([opener, url], timeout_ms: 3000, should_check: false, is_quiet: true)) {
        case Ok(proc.Completed done): {
            if (done.is_success()) {
                return;
            }
        }
        case Err(proc.Error error): {
        }
    }
    loop.copy(url);
    viewer.message = "could not open, copied " + url;
}

/// Do what the viewer asked for since the last key.
pub void App.serve() {
    for (MDV_viewer.Request request in viewer.drain()) {
        match (request) {
            case Reload: {
                reload();
            }
            case Open(str path): {
                open_file(path);
            }
            case Copy(str text): {
                loop.copy(text);
                copy_system(text);
            }
            case OpenUrl(str url): {
                open_url(url);
            }
            case Save(str path, str text): {
                save_file(path, text);
            }
            case Paste: {
                paste_clipboard();
            }
        }
    }
}

pub TUI_app.Action App.handle(term.Event event) {
    match (event) {
        case Key(term.Key pressed): {
            TUI_app.Action action = viewer.key(pressed);
            serve();
            return settle(action);
        }
        case Mouse(term.Mouse mouse): {
            count_clicks(mouse);
            TUI_app.Action action = viewer.mouse(mouse);
            serve();
            return settle(action);
        }
        case Paste(str text): {
            viewer.paste_text(text, classify_paste(text));
            serve();
            return TUI_app.Action.Redraw;
        }
        case Unknown(bytes raw): {
            return TUI_app.Action.Continue;
        }
    }
}

/// A save that was the last thing before quitting lets the quit through.
TUI_app.Action App.settle(TUI_app.Action action) {
    if (viewer.should_quit) {
        return TUI_app.Action.Quit;
    }
    return action;
}

/// Tell the viewer whether a left press is the first, second or third of a
/// run of clicks on the same cell (within 450 ms).
void App.count_clicks(term.Mouse report) {
    match (report.kind) {
        case Down(int button): {
            if (button != 0) {
                return;
            }
            int now = date.now_ns();
            bool is_same = report.col == last_press_col && report.row == last_press_row;
            if (is_same && now - last_press_ns < 450000000 && press_count < 3) {
                press_count = press_count + 1;
            } else {
                press_count = 1;
            }
            last_press_ns = now;
            last_press_col = report.col;
            last_press_row = report.row;
            viewer.click_count = press_count;
        }
        case Up(int released): {
        }
        case Drag(int dragged): {
        }
        case Moved: {
        }
        case ScrollUp: {
        }
        case ScrollDown: {
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
    }
}

/// The loop's timer (`Loop.animate_ms`): has the file changed on disk?
pub TUI_app.Action App.tick(int elapsed_ms) {
    if (needs_redraw()) {
        return TUI_app.Action.Redraw;
    }
    return TUI_app.Action.Continue;
}

/// Idle: has the file changed on disk?
bool App.needs_redraw() {
    if (!is_watching || viewer.name == STDIN_NAME) {
        return false;
    }
    str now = stamp_of(viewer.name);
    if (now.size() == 0 || now == stamp) {
        return false;
    }
    if (viewer.buffer.is_dirty()) {
        // Never read over unsaved work without asking.
        stamp = now;
        viewer.disk_changed();
        return true;
    }
    reload();
    return true;
}

/// The programs that read and write the system clipboard, tried in order; the
/// first that exists and succeeds is used.
List<List<str>> copy_tools() {
    return [["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]];
}

List<List<str>> paste_tools() {
    return [["pbpaste"], ["wl-paste", "--no-newline"], ["xclip", "-selection", "clipboard", "-o"], ["xsel", "--clipboard", "--output"]];
}

/// What a bracketed paste is: "image" or "file" when it is one path to a
/// file that exists (a dragged file arrives as its path), else "".
str classify_paste(str text) {
    str one = text.trim();
    if (one.size() == 0 || one.contains("\n")) {
        return "";
    }
    str path = one;
    if (path.starts_with("file://")) {
        path = path.substr(7, path.size());
    }
    if (path.starts_with("'") && path.ends_with("'") && path.size() > 2) {
        path = path.substr(1, path.size() - 1);
    }
    if (!(path.starts_with("/") || path.starts_with("~/") || path.starts_with("./"))) {
        return "";
    }
    if (!fs.is_file(path)) {
        return "";
    }
    str lower = path.to_lower();
    if (lower.ends_with(".png") || lower.ends_with(".jpg") || lower.ends_with(".jpeg") || lower.ends_with(".gif") || lower.ends_with(".webp") || lower.ends_with(".svg")) {
        return "image";
    }
    return "file";
}

pub App open(MDV_viewer.Viewer viewer, MDV_theme.Theme theme, MDV_caps.Caps caps) {
    MDV_render.Screen screen = MDV_render.Screen(viewer, theme);
    screen.caps = caps;
    App app = App(viewer, screen);
    app.stamp = stamp_of(viewer.name);
    return app;
}
