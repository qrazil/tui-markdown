// term-markdown's block tree to the viewer's model.
//
//   MD_blocks.parse(source)   blocks holding raw inline source
//   MD_inlines.render         that source as HTML (the only inline output)
//   MDV_inline.parse          the HTML as styled spans
//
// Three things the upstream tree does not carry are added here:
//
//   - source lines. A block does not know where it came from, so each leaf
//     block is searched for in the source, forward from the end of the one
//     before. That is exact for anything the parser does not rewrite and a
//     near miss for the rest; a miss only moves a `Row.line` by a few lines
//     (it is used to keep the place across a reload, never to show text).
//   - heading anchors (GitHub's slugs), for `[text](#anchor)` links.
//   - task-list markers. `- [x] done` is an ordinary item upstream; here the
//     item is flagged and the marker's three characters get their own span.

import MDV_code;
import MDV_inline;
import MDV_model;
import markdown.MD_blocks;
import markdown.MD_doc;
import markdown.MD_inlines;

type Prep {
    List<str> lines;
    /// Index into `lines` where the next search starts.
    int cursor = 0;
    List<MDV_model.Link> links;
    Map<str, int> slugs;
    Map<str, MD_doc.Reference> references;
    /// Footnote definitions by label, and the labels in order of first use.
    Map<str, str> notes;
    List<str> used;
}

/// Find `needle` on a source line at or after the cursor; the 1-based line,
/// or the cursor's own line when it is not found (the cursor stays).
int Prep.locate(str needle) {
    if (needle.size() > 0) {
        for (int index in cursor .. lines.size()) {
            if (lines[index].contains(needle)) {
                cursor = index;
                return index + 1;
            }
        }
    }
    return cursor + 1;
}

/// Step the cursor past a block that took `count` source lines from `line`.
void Prep.advance(int line, int count) {
    int target = line - 1 + count;
    if (target > cursor && target <= lines.size()) {
        cursor = target;
    }
}

List<MDV_model.Span> Prep.inline(str raw, int style) {
    return decorate(MDV_inline.parse(MD_inlines.render(raw, references), links, style));
}

/// Strikethrough (`~~x~~`) and footnote references (`[^x]`), which the
/// parser leaves as text.
List<MDV_model.Span> Prep.decorate(List<MDV_model.Span> spans) {
    int markers = 0;
    bool has_ref = false;
    for (MDV_model.Span span in spans) {
        if (span.has_bits(MDV_model.CODE)) {
            continue;
        }
        if (span.text.contains("~~")) {
            markers = markers + span.text.split("~~").size() - 1;
        }
        if (notes.size() > 0 && span.text.contains("[^")) {
            has_ref = true;
        }
    }
    if (markers < 2 && !has_ref) {
        return spans;
    }
    int usable = markers - markers % 2;
    int seen = 0;
    bool is_struck = false;
    List<MDV_model.Span> out = [];
    for (MDV_model.Span span in spans) {
        if (span.has_bits(MDV_model.CODE)) {
            out.push(span);
            continue;
        }
        List<str> pieces = span.text.split("~~");
        for (int index in 0 .. pieces.size()) {
            if (index > 0) {
                if (seen < usable) {
                    is_struck = !is_struck;
                } else {
                    out.push(MDV_model.Span("~~", style: span.style, link: span.link));
                }
                seen = seen + 1;
            }
            int bits = span.style;
            if (is_struck) {
                bits = bits | MDV_model.STRIKE;
            }
            note_refs(out, pieces[index], bits, span.link);
        }
    }
    return out;
}

/// `text` onto `out`, its known footnote references as superscript spans.
void Prep.note_refs(List<MDV_model.Span> out, str text, int bits, int link) {
    str rest = text;
    while (rest.size() > 0) {
        int slot = -1;
        match (rest.index_of("[^")) {
            case Some(int found): {
                slot = found;
            }
            case None: {
            }
        }
        if (slot < 0) {
            break;
        }
        int shut = -1;
        match (rest.substr(slot, rest.size()).index_of("]")) {
            case Some(int found): {
                shut = slot + found;
            }
            case None: {
            }
        }
        if (shut < 0) {
            break;
        }
        str label = rest.substr(slot + 2, shut);
        if (!notes.contains(label)) {
            out.push(MDV_model.Span(rest.substr(0, shut + 1), style: bits, link: link));
            rest = rest.substr(shut + 1, rest.size());
            continue;
        }
        if (slot > 0) {
            out.push(MDV_model.Span(rest.substr(0, slot), style: bits, link: link));
        }
        int number = 0;
        match (used.index_of(label)) {
            case Some(int seen_slot): {
                number = seen_slot + 1;
            }
            case None: {
                used.push(label);
                number = used.size();
            }
        }
        out.push(MDV_model.Span(superscript(number), style: bits | MDV_model.FOOT, link: link));
        rest = rest.substr(shut + 1, rest.size());
    }
    if (rest.size() > 0) {
        out.push(MDV_model.Span(rest, style: bits, link: link));
    }
}

MDV_model.Block Prep.paragraph(str raw) {
    int line = locate(first_line(raw));
    advance(line, line_count(raw));
    return MDV_model.Block.Para(MDV_model.Text(inline(raw, 0), line: line));
}

MDV_model.Block Prep.heading_block(MD_doc.Heading heading) {
    int line = locate(first_line(heading.text));
    int skip = 1;
    if (line < lines.size() && is_underline(lines[line]) && !lines[line - 1].trim().starts_with("#")) {
        skip = 2;
    }
    advance(line, skip);
    List<MDV_model.Span> spans = inline(heading.text, MDV_model.heading_style(heading.level));
    str plain = MDV_inline.plain(spans).trim();
    str base = slugify(plain);
    str slug = base;
    match (slugs.get(base)) {
        case Some(int seen): {
            slug = base + "-" + str(seen);
            slugs.set(base, seen + 1);
        }
        case None: {
            slugs.set(base, 1);
        }
    }
    return MDV_model.Block.Head(MDV_model.HeadingBlock(heading.level, spans, plain, slug, line: line));
}

MDV_model.Block Prep.fence(MD_doc.Code code) {
    List<str> body = [];
    if (code.body.size() > 0) {
        body = code.body.split("\n");
        // `body` ends with a newline, which leaves one empty field.
        if (body.size() > 0 && body[body.size() - 1] == "") {
            body.pop();
        }
    }
    int line = locate(first_line(code.body));
    if (code.body.size() > 0 && line >= 2 && (lines[line - 2].trim().starts_with("```") || lines[line - 2].trim().starts_with("~~~"))) {
        line = line - 1;
    }
    advance(line, body.size() + 2);
    return MDV_model.Block.Code(MDV_model.CodeBlock(code.info, body, shown: MDV_code.highlight(MDV_code.language_of(code.info), body), line: line));
}

MDV_model.Block Prep.rule() {
    for (int index in cursor .. lines.size()) {
        if (is_rule_line(lines[index])) {
            cursor = index + 1;
            return MDV_model.Block.Rule(index + 1);
        }
    }
    return MDV_model.Block.Rule(cursor + 1);
}

MDV_model.Block Prep.table(MD_doc.Table grid) {
    str head = "";
    if (grid.heads.size() > 0) {
        head = first_line(grid.heads[0]);
    }
    int line = locate(head);
    List<MDV_model.Cell> heads = [];
    for (str cell in grid.heads) {
        heads.push(MDV_model.Cell(inline(cell, MDV_model.HEAD_CELL | MDV_model.BOLD)));
    }
    List<List<MDV_model.Cell>> rows = [];
    for (List<str> row in grid.rows) {
        List<MDV_model.Cell> cells = [];
        for (str cell in row) {
            cells.push(MDV_model.Cell(inline(cell, 0)));
        }
        rows.push(cells);
    }
    advance(line, grid.rows.size() + 2);
    return MDV_model.Block.Table(MDV_model.Grid(grid.align, heads, rows, line: line));
}

MDV_model.Block Prep.listing_block(MD_doc.Listing listing) {
    List<MDV_model.ListItem> items = [];
    for (MD_doc.Item item in listing.items) {
        List<MDV_model.Block> kids = blocks(item.kids);
        int task = task_of(kids);
        if (task > 0) {
            kids = mark_task(kids, task);
        }
        items.push(MDV_model.ListItem(kids, task: task));
    }
    return MDV_model.Block.Items(MDV_model.ListBlock(listing.is_ordered, listing.start, listing.is_tight, items));
}

List<MDV_model.Block> Prep.blocks(List<MD_doc.Block> source) {
    List<MDV_model.Block> out = [];
    for (MD_doc.Block block in source) {
        match (block) {
            case Rule: {
                out.push(rule());
            }
            case Paragraph(str raw): {
                out.push(paragraph(raw));
            }
            case Heading(MD_doc.Heading heading): {
                out.push(heading_block(heading));
            }
            case Fence(MD_doc.Code code): {
                out.push(fence(code));
            }
            case Quoted(MD_doc.Quote quote): {
                out.push(quote_block(quote));
            }
            case Bullets(MD_doc.Listing listing): {
                out.push(listing_block(listing));
            }
            case Grid(MD_doc.Table grid): {
                out.push(table(grid));
            }
        }
    }
    return out;
}

/// A block quote, or a callout when it opens with `[!NOTE]` and the like.
MDV_model.Block Prep.quote_block(MD_doc.Quote quote) {
    if (quote.kids.size() > 0) {
        match (quote.kids[0]) {
            case Paragraph(str raw): {
                str head = raw.trim();
                if (head.starts_with("[!")) {
                    int shut = -1;
                    match (head.index_of("]")) {
                        case Some(int found): {
                            shut = found;
                        }
                        case None: {
                        }
                    }
                    int kind = 0;
                    if (shut > 2) {
                        kind = callout_kind(head.substr(2, shut));
                    }
                    if (kind > 0) {
                        str tail = head.substr(shut + 1, head.size());
                        if (tail.starts_with("-") || tail.starts_with("+")) {
                            tail = tail.substr(1, tail.size());
                        }
                        str title = callout_title(kind);
                        str body = "";
                        match (tail.index_of("\n")) {
                            case Some(int newline): {
                                if (tail.substr(0, newline).trim().size() > 0) {
                                    title = tail.substr(0, newline).trim();
                                }
                                body = tail.substr(newline + 1, tail.size());
                            }
                            case None: {
                                if (tail.trim().size() > 0) {
                                    title = tail.trim();
                                }
                            }
                        }
                        int line = locate(first_line(raw));
                        List<MD_doc.Block> rest = [];
                        for (int index in 1 .. quote.kids.size()) {
                            rest.push(quote.kids[index]);
                        }
                        List<MDV_model.Block> kids = [];
                        if (body.trim().size() > 0) {
                            kids.push(paragraph(body));
                        }
                        for (MDV_model.Block more in blocks(rest)) {
                            kids.push(more);
                        }
                        return MDV_model.Block.Callout(MDV_model.CalloutBlock(kind, title, kids, line: line));
                    }
                }
            }
            case Rule: {
            }
            case Heading(MD_doc.Heading skipped_heading): {
            }
            case Fence(MD_doc.Code skipped_code): {
            }
            case Quoted(MD_doc.Quote skipped_quote): {
            }
            case Bullets(MD_doc.Listing skipped_list): {
            }
            case Grid(MD_doc.Table skipped_grid): {
            }
        }
    }
    return MDV_model.Block.Quote(blocks(quote.kids));
}

/// Superscript digits for footnote number `number`.
str superscript(int number) {
    List<str> marks = ["\u{2070}", "\u{b9}", "\u{b2}", "\u{b3}", "\u{2074}", "\u{2075}", "\u{2076}", "\u{2077}", "\u{2078}", "\u{2079}"];
    List<str> out = [];
    for (int digit in str(number).chars()) {
        out.push(marks[digit - '0']);
    }
    return out.join("");
}

int callout_kind(str name) {
    str upper = name.to_upper();
    if (upper == "NOTE" || upper == "INFO") {
        return 1;
    }
    if (upper == "TIP" || upper == "HINT") {
        return 2;
    }
    if (upper == "IMPORTANT") {
        return 3;
    }
    if (upper == "WARNING") {
        return 4;
    }
    if (upper == "CAUTION" || upper == "DANGER") {
        return 5;
    }
    return 0;
}

str callout_title(int kind) {
    if (kind == 1) {
        return "Note";
    }
    if (kind == 2) {
        return "Tip";
    }
    if (kind == 3) {
        return "Important";
    }
    if (kind == 4) {
        return "Warning";
    }
    return "Caution";
}

/// GitHub's anchor for heading text: lower case, punctuation dropped, spaces
/// and hyphens as hyphens. Non-ASCII letters stay as they are.
pub str slugify(str heading) {
    List<int> out = [];
    for (int code in heading.to_lower().chars()) {
        if (code == ' ' || code == '-') {
            out.push('-');
        } else if (code == '_' || (code >= '0' && code <= '9') || (code >= 'a' && code <= 'z') || code >= 128) {
            out.push(code);
        }
    }
    return str.from_chars(out);
}

bool is_rule_line(str line) {
    str trimmed = line.trim();
    if (trimmed.size() < 3) {
        return false;
    }
    for (int code in trimmed.chars()) {
        if (code != '-' && code != '*' && code != '_' && code != ' ') {
            return false;
        }
    }
    return true;
}

bool is_underline(str line) {
    str trimmed = line.trim();
    if (trimmed.size() == 0) {
        return false;
    }
    for (int code in trimmed.chars()) {
        if (code != '-' && code != '=') {
            return false;
        }
    }
    return true;
}

/// The first non-blank line of `raw`, trimmed.
str first_line(str raw) {
    for (str line in raw.split("\n")) {
        if (line.trim().size() > 0) {
            return line.trim();
        }
    }
    return "";
}

int line_count(str raw) {
    return raw.trim().split("\n").size();
}

/// The task state of a list item whose first block is a paragraph that opens
/// with `[ ] ` or `[x] `: 0 for none, 1 unchecked, 2 checked.
int task_of(List<MDV_model.Block> kids) {
    if (kids.size() == 0) {
        return 0;
    }
    match (kids[0]) {
        case Para(MDV_model.Text text): {
            if (text.spans.size() == 0) {
                return 0;
            }
            str head = text.spans[0].text;
            if (head.starts_with("[ ] ")) {
                return 1;
            }
            if (head.starts_with("[x] ") || head.starts_with("[X] ")) {
                return 2;
            }
            return 0;
        }
        case Callout(MDV_model.CalloutBlock callout_item): {
            return 0;
        }
        case Meta(MDV_model.MetaBlock meta_item): {
            return 0;
        }
        case Notes(MDV_model.NoteBlock notes_item): {
            return 0;
        }
        case Rule(int rule_line): {
            return 0;
        }
        case Head(MDV_model.HeadingBlock heading_item): {
            return 0;
        }
        case Code(MDV_model.CodeBlock code_item): {
            return 0;
        }
        case Quote(List<MDV_model.Block> quote_kids): {
            return 0;
        }
        case Items(MDV_model.ListBlock list_item): {
            return 0;
        }
        case Table(MDV_model.Grid grid_item): {
            return 0;
        }
    }
}

/// `kids` with the first paragraph's `[x]` split off into a TASK span.
List<MDV_model.Block> mark_task(List<MDV_model.Block> kids, int task) {
    List<MDV_model.Block> out = [];
    for (int index in 0 .. kids.size()) {
        if (index > 0) {
            out.push(kids[index]);
            continue;
        }
        match (kids[0]) {
            case Para(MDV_model.Text text): {
                MDV_model.Span first = text.spans[0];
                List<MDV_model.Span> spans = [];
                spans.push(MDV_model.Span(first.text.substr(0, 3), style: MDV_model.TASK, link: -1));
                spans.push(MDV_model.Span(first.text.substr(3, first.text.size()), style: first.style, link: first.link));
                for (int rest in 1 .. text.spans.size()) {
                    spans.push(text.spans[rest]);
                }
                out.push(MDV_model.Block.Para(MDV_model.Text(spans, line: text.line)));
            }
            case Callout(MDV_model.CalloutBlock callout_item): {
                out.push(kids[0]);
            }
            case Meta(MDV_model.MetaBlock meta_item): {
                out.push(kids[0]);
            }
            case Notes(MDV_model.NoteBlock notes_item): {
                out.push(kids[0]);
            }
            case Rule(int rule_line): {
                out.push(kids[0]);
            }
            case Head(MDV_model.HeadingBlock heading_item): {
                out.push(kids[0]);
            }
            case Code(MDV_model.CodeBlock code_item): {
                out.push(kids[0]);
            }
            case Quote(List<MDV_model.Block> quote_kids): {
                out.push(kids[0]);
            }
            case Items(MDV_model.ListBlock list_item): {
                out.push(kids[0]);
            }
            case Table(MDV_model.Grid grid_item): {
                out.push(kids[0]);
            }
        }
    }
    return out;
}

/// `source` split into front matter lines (none when it has none) and the
/// rest, the front matter's lines blanked so line numbers still count.
type Front {
    List<str> meta;
    str body;
    int count;
}

Front split_front(str source) {
    List<str> lines = source.split("\n");
    if (lines.size() < 2 || lines[0].trim() != "---") {
        return Front([], source, 0);
    }
    int limit = lines.size();
    if (limit > 200) {
        limit = 200;
    }
    for (int index in 1 .. limit) {
        str each = lines[index].trim();
        if (each == "---" || each == "...") {
            List<str> meta = [];
            List<str> rest = [];
            for (int slot in 0 .. lines.size()) {
                if (slot <= index) {
                    rest.push("");
                    if (slot > 0 && slot < index) {
                        meta.push(lines[slot]);
                    }
                } else {
                    rest.push(lines[slot]);
                }
            }
            return Front(meta, rest.join("\n"), index + 1);
        }
    }
    return Front([], source, 0);
}

/// Pull `[^label]: text` definitions out of `body` (blanking their lines);
/// fenced code is left alone.
str take_notes(str body, Map<str, str> notes, List<str> order) {
    if (!body.contains("[^")) {
        return body;
    }
    List<str> lines = body.split("\n");
    List<str> out = [];
    bool is_fenced = false;
    str current = "";
    for (str line in lines) {
        str trimmed = line.trim();
        if (trimmed.starts_with("```") || trimmed.starts_with("~~~")) {
            is_fenced = !is_fenced;
        }
        if (!is_fenced && line.starts_with("[^")) {
            match (line.index_of("]:")) {
                case Some(int shut): {
                    current = line.substr(2, shut);
                    notes.set(current, line.substr(shut + 2, line.size()).trim());
                    order.push(current);
                    out.push("");
                    continue;
                }
                case None: {
                }
            }
        }
        if (!is_fenced && current.size() > 0 && (line.starts_with("  ") || line.starts_with("\t")) && trimmed.size() > 0) {
            notes.set(current, notes.get(current).or("") + " " + trimmed);
            out.push("");
            continue;
        }
        current = "";
        out.push(line);
    }
    return out.join("\n");
}

/// The viewer's model of the markdown in `source`.
pub MDV_model.Document prepare(str source) {
    Front front = split_front(source);
    Map<str, str> notes = {};
    List<str> defined = [];
    str body = take_notes(front.body, notes, defined);
    MD_doc.Document parsed = MD_blocks.parse(body);
    List<str> lines = body.split("\n");
    Prep prep = Prep(lines, [], {}, parsed.references, notes, []);
    List<MDV_model.Block> blocks = prep.blocks(parsed.blocks);
    if (front.meta.size() > 0) {
        blocks.insert(0, MDV_model.Block.Meta(MDV_model.MetaBlock(front.meta, line: 1)));
    }
    if (notes.size() > 0) {
        List<str> order = [];
        for (str label in prep.used) {
            order.push(label);
        }
        for (str label in defined) {
            if (!order.contains(label)) {
                order.push(label);
            }
        }
        List<MDV_model.Text> texts = [];
        for (str label in order) {
            List<MDV_model.Span> shown = prep.inline(notes.get(label).or(""), MDV_model.FOOT);
            texts.push(MDV_model.Text(shown, line: 0));
        }
        blocks.push(MDV_model.Block.Notes(MDV_model.NoteBlock(texts)));
    }
    int count = lines.size();
    if (count > 0 && lines[count - 1] == "") {
        count = count - 1;
    }
    return MDV_model.Document(blocks, prep.links, line_count: count);
}
