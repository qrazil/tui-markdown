// Layout: the model slot one width, as rows of styled spans.
//
// Pure: the same document, options and width always give the same rows, and
// nothing here knows about colours (see `MDV_theme`) or the terminal. A row's
// spans say what each run IS through style bits; `DECO` marks everything that
// is chrome (bullets, quote bars, table borders, a rule, padding, a callout's
// title) so that what is left over is exactly the document's text, which the
// oracle test checks against term-markdown's own HTML.
//
// Backgrounds (a block quote's tint, a code card, an H1 band) are made by
// padding every row of the block out to the full width with spaces that carry
// the block's bit, so the colour is a property of the spans, never of the
// renderer, and `--dump` and the screen agree.

import MDV_model;
import MDV_wrap;
import tui.core.TUI_text;

const str BAR = "\u{258e} ";
const str DASH = "\u{2500}";
const str DOUBLE = "\u{2550}";

/// What a layout may vary on besides the width.
pub type Options {
    pub int width;
    /// H1 is written as OSC 66 scaled text (two rows, two columns a letter).
    pub bool is_scaled = false;
    /// Alternate table rows get a shade.
    pub bool is_zebra = false;
    /// Line numbers in code cards.
    pub bool has_numbers = false;
    /// Code and metadata cards are drawn with a box-drawing rule above and below and a bar
    /// at the left, for a terminal that shows the desktop through the page: the card's tint
    /// is not there to tell it from the text.
    pub bool is_framed = false;
}

/// Rows and the headings found among them, rows counted from this part's own
/// first row.
type Part {
    List<MDV_model.Row> rows;
    List<MDV_model.Heading> heads;
}

void Part.append(Part other) {
    int offset = rows.size();
    for (MDV_model.Heading head in other.heads) {
        heads.push(MDV_model.Heading(head.level, head.text, head.slug, head.row + offset, head.line));
    }
    for (MDV_model.Row row in other.rows) {
        rows.push(row);
    }
}

void Part.blank() {
    rows.push(blank_row());
}

/// What the whole layout shares while it runs.
type Context {
    List<MDV_model.Link> links;
    /// The yankable text of each leaf block.
    List<str> texts;
    Options options;
    /// How deep in lists the block being laid out is.
    int depth = 0;
}

str spaces(int count) {
    if (count <= 0) {
        return "";
    }
    return " ".repeat(count);
}

MDV_model.Span chrome(str text, int extra) {
    return MDV_model.Span(text, style: MDV_model.DECO | extra, link: -1);
}

MDV_model.Row blank_row() {
    return MDV_model.Row([]);
}

/// `spans` with `bits` added to every one.
List<MDV_model.Span> with_bits(List<MDV_model.Span> spans, int bits) {
    List<MDV_model.Span> out = [];
    for (MDV_model.Span span in spans) {
        out.push(MDV_model.Span(span.text, style: span.style | bits, link: span.link));
    }
    return out;
}

/// `spans` padded with spaces carrying `bits` to `width` columns.
List<MDV_model.Span> filled(List<MDV_model.Span> spans, int width, int bits) {
    int pad = width - MDV_wrap.spans_width(spans);
    if (pad <= 0) {
        return spans;
    }
    List<MDV_model.Span> out = [];
    for (MDV_model.Span span in spans) {
        out.push(span);
    }
    out.push(chrome(spaces(pad), bits));
    return out;
}

/// Every row of `part` with `bits` on all its spans and padded to `width`;
/// blank rows become a row of the fill alone.
Part tinted(Part part, int width, int bits) {
    Part out = Part([], part.heads);
    for (MDV_model.Row row in part.rows) {
        List<MDV_model.Span> spans = filled(with_bits(row.spans, bits), width, bits);
        out.rows.push(MDV_model.Row(spans, line: row.line, block: row.block, big: row.big));
    }
    return out;
}

/// `part` with a prefix on every row: `first` on the first, `rest` on the
/// others. Blank rows get `rest` only when `is_blank_marked`.
Part indent(Part part, MDV_model.Span first, MDV_model.Span rest, bool is_blank_marked) {
    Part out = Part([], part.heads);
    for (int index in 0 .. part.rows.size()) {
        MDV_model.Row row = part.rows[index];
        MDV_model.Span lead = rest;
        if (index == 0) {
            lead = first;
        }
        if (row.spans.size() == 0 && !is_blank_marked && index > 0) {
            out.rows.push(row);
            continue;
        }
        List<MDV_model.Span> spans = [lead];
        for (MDV_model.Span span in row.spans) {
            spans.push(span);
        }
        out.rows.push(MDV_model.Row(spans, line: row.line, block: row.block, big: row.big));
    }
    return out;
}

/// Lay out the lines of one leaf block: wrapped spans, tagged with the block.
Part leaf(Context context, List<List<MDV_model.Span>> lines, int line, str text) {
    context.texts.push(text);
    int block = context.texts.size() - 1;
    Part part = Part([], []);
    for (List<MDV_model.Span> spans in lines) {
        part.rows.push(MDV_model.Row(spans, line: line, block: block));
    }
    return part;
}

str plain_of(List<MDV_model.Span> spans) {
    List<str> parts = [];
    for (MDV_model.Span span in spans) {
        if (span.has_bits(MDV_model.BREAK)) {
            parts.push("\n");
        } else if (!(span.has_bits(MDV_model.IMAGE) && span.has_bits(MDV_model.DECO))) {
            parts.push(span.text);
        }
    }
    return parts.join("");
}

Part paragraph(Context context, MDV_model.Text text, int width) {
    return leaf(context, MDV_wrap.wrap(text.spans, width), text.line, plain_of(text.spans));
}

// --- headings -----------------------------------------------------------------

str head_marker(int level) {
    if (level == 3) {
        return "\u{25c6} ";
    }
    if (level == 4) {
        return "\u{25c7} ";
    }
    if (level == 5) {
        return "\u{25b8} ";
    }
    return "\u{b7} ";
}

Part heading(Context context, MDV_model.HeadingBlock block, int width) {
    int level = block.level;
    int tag = MDV_model.BANNER | MDV_model.heading_style(level);
    List<List<MDV_model.Span>> lines = [];
    int big = 0;
    if (level == 1) {
        int inner = width - 4;
        if (context.options.is_scaled) {
            // Two columns a letter: half the room.
            inner = (width - 2) / 2;
        }
        List<List<MDV_model.Span>> wrapped = MDV_wrap.wrap(with_bits(block.spans, 0), inner);
        if (context.options.is_scaled) {
            big = 2;
            for (List<MDV_model.Span> one in wrapped) {
                List<MDV_model.Span> first = [chrome("  ", tag)];
                for (MDV_model.Span span in one) {
                    first.push(span);
                }
                lines.push(first);
                lines.push([chrome("  ", tag)]);
            }
        } else {
            lines.push([chrome(spaces(width), tag)]);
            for (List<MDV_model.Span> one in wrapped) {
                List<MDV_model.Span> row = [chrome("  ", tag)];
                for (MDV_model.Span span in with_bits(one, MDV_model.BANNER)) {
                    row.push(span);
                }
                lines.push(filled(row, width, tag));
            }
            lines.push([chrome(spaces(width), tag)]);
        }
        lines.push([chrome(DOUBLE.repeat(width), tag | MDV_model.UNDER)]);
    } else if (level == 2) {
        List<List<MDV_model.Span>> wrapped = MDV_wrap.wrap(block.spans, width - 2);
        for (int index in 0 .. wrapped.size()) {
            List<MDV_model.Span> row = [];
            if (index == 0) {
                row.push(chrome("\u{258c} ", tag));
            } else {
                row.push(chrome("\u{258c} ", tag));
            }
            for (MDV_model.Span span in wrapped[index]) {
                row.push(span);
            }
            lines.push(row);
        }
        lines.push([chrome(DASH.repeat(width), tag | MDV_model.UNDER)]);
    } else {
        str marks = head_marker(level);
        List<List<MDV_model.Span>> wrapped = MDV_wrap.wrap(block.spans, width - 2);
        for (int index in 0 .. wrapped.size()) {
            List<MDV_model.Span> row = [];
            if (index == 0) {
                row.push(chrome(marks, tag));
            } else {
                row.push(chrome("  ", tag));
            }
            for (MDV_model.Span span in wrapped[index]) {
                row.push(span);
            }
            lines.push(row);
        }
    }
    Part part = leaf(context, lines, block.line, block.plain);
    if (big > 0) {
        // Pairs of rows: the first of each pair holds the scaled text, the
        // second is covered by it; the under-rule slot the end is ordinary.
        List<MDV_model.Row> marked = [];
        for (int index in 0 .. part.rows.size()) {
            MDV_model.Row row = part.rows[index];
            int mark = 0;
            if (index + 1 < part.rows.size()) {
                mark = -1;
                if (index % 2 == 0) {
                    mark = 2;
                }
            }
            marked.push(MDV_model.Row(row.spans, line: row.line, block: row.block, big: mark));
        }
        part = Part(marked, []);
    }
    part.heads.push(MDV_model.Heading(level, block.plain, block.slug, 0, block.line));
    return part;
}

// --- code -------------------------------------------------------------------------

/// Tabs to four-column stops; the rest of a code line is left alone.
str expand_tabs(str code_line) {
    if (!code_line.contains("\t")) {
        return code_line;
    }
    List<str> out = [];
    int column = 0;
    for (str piece in code_line.split("\t")) {
        out.push(piece);
        column = column + TUI_text.width(piece);
        out.push(spaces(4 - column % 4));
        column = column + 4 - column % 4;
    }
    out.pop();
    return out.join("");
}

/// `spans` cut into lines of slot most `room` columns, every space kept.
List<List<MDV_model.Span>> cut_spans(List<MDV_model.Span> spans, int room) {
    List<List<MDV_model.Span>> lines = [];
    List<MDV_model.Span> line = [];
    int used = 0;
    for (MDV_model.Span span in spans) {
        str rest = span.text;
        while (rest.size() > 0) {
            int free = room - used;
            str piece = "";
            if (free > 0) {
                piece = TUI_text.cut(rest, free);
            }
            if (piece.size() == 0) {
                if (used > 0) {
                    lines.push(line);
                    line = [];
                    used = 0;
                    continue;
                }
                // A cluster wider than the room: take it whole.
                piece = TUI_text.cut(rest, 2);
                if (piece.size() == 0) {
                    piece = rest;
                }
            }
            line.push(MDV_model.Span(piece, style: span.style, link: span.link));
            used = used + TUI_text.width(piece);
            rest = rest.substr(piece.size(), rest.size());
        }
    }
    lines.push(line);
    return lines;
}

Part code(Context context, MDV_model.CodeBlock block, int width) {
    int digits = str(block.lines.size()).size();
    int gutter = 0;
    if (context.options.has_numbers) {
        gutter = digits + 1;
    }
    int inner = width - 4 - gutter;
    if (inner < 1) {
        inner = 1;
    }
    int fill = MDV_model.BLOCK | MDV_model.DECO;
    List<List<MDV_model.Span>> lines = [];
    List<str> plain = [];
    str language = codelang(block.info);
    // The top row carries the language chip slot the right.
    List<MDV_model.Span> top = [];
    if (language.size() > 0 && width > language.size() + 4) {
        top.push(chrome(rule_text(context, "\u{256d}", width - language.size() - 2), edge_bits(context, fill)));
        top.push(chrome(" " + language + " ", fill | MDV_model.CHIP));
    } else {
        top.push(chrome(rule_text(context, "\u{256d}", width), edge_bits(context, fill)));
    }
    lines.push(top);
    for (int index in 0 .. block.lines.size()) {
        plain.push(block.lines[index]);
        List<MDV_model.Span> shown = [];
        if (index < block.shown.size()) {
            for (MDV_model.Span each in block.shown[index]) {
                shown.push(MDV_model.Span(expand_tabs(each.text), style: each.style));
            }
        } else {
            shown.push(MDV_model.Span(expand_tabs(block.lines[index]), style: MDV_model.BLOCK));
        }
        bool is_first = true;
        for (List<MDV_model.Span> piece in cut_spans(shown, inner)) {
            List<MDV_model.Span> spans = [side_bar(context, fill)];
            if (gutter > 0) {
                str number = "";
                if (is_first) {
                    number = str(index + 1);
                }
                spans.push(chrome(spaces(digits - number.size()) + number + " ", fill | MDV_model.GUTTER));
            }
            is_first = false;
            for (MDV_model.Span span in piece) {
                spans.push(span);
            }
            lines.push(filled(spans, width, fill));
        }
    }
    lines.push([chrome(rule_text(context, "\u{2570}", width), edge_bits(context, fill))]);
    return leaf(context, lines, block.line, plain.join("\n"));
}

/// The top or bottom row of a card, `width` columns: blank when the card is tinted, a
/// rounded corner and a rule when it is framed.
str rule_text(Context context, str corner, int width) {
    if (!context.options.is_framed) {
        return spaces(width);
    }
    if (width < 1) {
        return "";
    }
    return corner + DASH.repeat(width - 1);
}

/// The bits of a card's top or bottom row: the fill, or a dim border when framed.
int edge_bits(Context context, int fill) {
    if (context.options.is_framed) {
        return MDV_model.BORDER;
    }
    return fill;
}

/// The two columns before a card's text: blank, or a bar when framed.
MDV_model.Span side_bar(Context context, int fill) {
    if (context.options.is_framed) {
        return chrome("\u{2502} ", MDV_model.BORDER);
    }
    return chrome("  ", fill);
}

/// The label of a fence: its first word.
str codelang(str info) {
    str word = info.trim();
    for (int index in 0 .. word.size()) {
        int byte_value = word.byte_at(index);
        if (byte_value == ' ' || byte_value == ',' || byte_value == '{' || byte_value == '}') {
            return word.substr(0, index);
        }
    }
    return word;
}

Part meta(Context context, MDV_model.MetaBlock block, int width) {
    int fill = MDV_model.META | MDV_model.DECO;
    List<List<MDV_model.Span>> lines = [];
    List<MDV_model.Span> top = [chrome(rule_text(context, "\u{256d}", width - 10), edge_bits(context, fill)), chrome(" metadata ", fill | MDV_model.CHIP)];
    if (width <= 12) {
        top = [chrome(rule_text(context, "\u{256d}", width), edge_bits(context, fill))];
    }
    lines.push(top);
    for (str each in block.lines) {
        MDV_model.Span whole = MDV_model.Span(expand_tabs(each), style: MDV_model.META | MDV_model.DECO);
        for (List<MDV_model.Span> piece in cut_spans([whole], width - 4)) {
            List<MDV_model.Span> spans = [side_bar(context, fill)];
            for (MDV_model.Span span in piece) {
                spans.push(span);
            }
            lines.push(filled(spans, width, fill));
        }
    }
    lines.push([chrome(rule_text(context, "\u{2570}", width), edge_bits(context, fill))]);
    return leaf(context, lines, block.line, "");
}

Part rule(Context context, int line, int width) {
    int side = (width - 3) / 2;
    str text = DASH.repeat(width);
    if (side > 1) {
        text = DASH.repeat(side) + " \u{25c6} " + DASH.repeat(width - side - 3);
    }
    List<List<MDV_model.Span>> lines = [[chrome(text, MDV_model.RULE)]];
    return leaf(context, lines, line, "");
}

Part notes(Context context, MDV_model.NoteBlock block, int width) {
    Part out = Part([], []);
    List<List<MDV_model.Span>> head = [[chrome(DASH.repeat(8), MDV_model.RULE)]];
    out.append(leaf(context, head, 0, ""));
    for (int index in 0 .. block.notes.size()) {
        MDV_model.Text note = block.notes[index];
        List<MDV_model.Span> mark = [chrome(superscript_of(index + 1) + " ", MDV_model.FOOT)];
        Part body = leaf(context, MDV_wrap.wrap(note.spans, width - 3), note.line, plain_of(note.spans));
        int spare = TUI_text.width(superscript_of(index + 1)) + 1;
        out.append(indent(body, mark[0], chrome(spaces(spare), 0), false));
    }
    return out;
}

str superscript_of(int number) {
    List<str> marks = ["\u{2070}", "\u{b9}", "\u{b2}", "\u{b3}", "\u{2074}", "\u{2075}", "\u{2076}", "\u{2077}", "\u{2078}", "\u{2079}"];
    List<str> out = [];
    for (int digit in str(number).chars()) {
        out.push(marks[digit - '0']);
    }
    return out.join("");
}

// --- quotes and callouts ------------------------------------------------------------

Part quote(Context context, List<MDV_model.Block> blocks, int width) {
    Part inner = blocks_part(context, blocks, width - 2, true);
    MDV_model.Span bar = chrome(BAR, MDV_model.QUOTE);
    Part body = indent(inner, bar, bar, true);
    return tinted(body, width, MDV_model.QUOTE);
}

str callout_icon(int kind) {
    if (kind == 1) {
        return "\u{24d8}";
    }
    if (kind == 2) {
        return "\u{2726}";
    }
    if (kind == 3) {
        return "\u{2756}";
    }
    if (kind == 4) {
        return "\u{25b2}";
    }
    return "\u{2716}";
}

Part callout(Context context, MDV_model.CalloutBlock block, int width) {
    int kind_bits = MDV_model.callout_style(block.kind) | MDV_model.QUOTE;
    Part inner = Part([], []);
    List<MDV_model.Span> title = [chrome(callout_icon(block.kind) + " ", MDV_model.TITLE), MDV_model.Span(block.title, style: MDV_model.DECO | MDV_model.TITLE | MDV_model.BOLD)];
    inner.append(leaf(context, [title], block.line, ""));
    if (block.kids.size() > 0) {
        inner.append(blocks_part(context, block.kids, width - 2, true));
    }
    // The title is one row; the body follows it directly.
    MDV_model.Span bar = chrome(BAR, kind_bits | MDV_model.BORDER);
    Part body = indent(inner, bar, bar, true);
    return tinted(body, width, kind_bits);
}

// --- lists ---------------------------------------------------------------------------

str bullet_of(int depth) {
    int slot = depth % 3;
    if (slot == 0) {
        return "\u{2022} ";
    }
    if (slot == 1) {
        return "\u{25e6} ";
    }
    return "\u{25aa} ";
}

str marker_of(Context context, MDV_model.ListBlock list, int index, MDV_model.ListItem item, int digits) {
    if (item.task == 1) {
        return "\u{2610} ";
    }
    if (item.task == 2) {
        return "\u{2611} ";
    }
    if (list.is_ordered) {
        str number = str(list.start + index);
        return spaces(digits - number.size()) + number + ". ";
    }
    return bullet_of(context.depth);
}

/// The first paragraph's `[ ]` / `[x]` span as chrome (the glyph stands for
/// it), so the text after it is all that is left of the item's words.
List<MDV_model.Block> without_box(List<MDV_model.Block> kids) {
    List<MDV_model.Block> out = [];
    for (int index in 0 .. kids.size()) {
        if (index > 0) {
            out.push(kids[index]);
            continue;
        }
        match (kids[0]) {
            case Para(MDV_model.Text text): {
                List<MDV_model.Span> spans = [];
                for (int slot in 0 .. text.spans.size()) {
                    MDV_model.Span span = text.spans[slot];
                    if (slot == 0 && span.has_bits(MDV_model.TASK)) {
                        continue;
                    }
                    if (slot == 1 && span.text.starts_with(" ")) {
                        spans.push(MDV_model.Span(span.text.substr(1, span.text.size()), style: span.style, link: span.link));
                        continue;
                    }
                    spans.push(span);
                }
                out.push(MDV_model.Block.Para(MDV_model.Text(spans, line: text.line)));
            }
            case Callout(MDV_model.CalloutBlock skipped_callout): {
                out.push(kids[0]);
            }
            case Meta(MDV_model.MetaBlock skipped_meta): {
                out.push(kids[0]);
            }
            case Notes(MDV_model.NoteBlock skipped_notes): {
                out.push(kids[0]);
            }
            case Rule(int skipped_line): {
                out.push(kids[0]);
            }
            case Head(MDV_model.HeadingBlock skipped_head): {
                out.push(kids[0]);
            }
            case Code(MDV_model.CodeBlock skipped_code): {
                out.push(kids[0]);
            }
            case Quote(List<MDV_model.Block> skipped_quote): {
                out.push(kids[0]);
            }
            case Items(MDV_model.ListBlock skipped_list): {
                out.push(kids[0]);
            }
            case Table(MDV_model.Grid skipped_grid): {
                out.push(kids[0]);
            }
        }
    }
    return out;
}

bool is_list(MDV_model.Block block) {
    match (block) {
        case Items(MDV_model.ListBlock skipped): {
            return true;
        }
        case Callout(MDV_model.CalloutBlock skipped_callout): {
            return false;
        }
        case Meta(MDV_model.MetaBlock skipped_meta): {
            return false;
        }
        case Notes(MDV_model.NoteBlock skipped_notes): {
            return false;
        }
        case Rule(int skipped_line): {
            return false;
        }
        case Para(MDV_model.Text skipped_text): {
            return false;
        }
        case Head(MDV_model.HeadingBlock skipped_head): {
            return false;
        }
        case Code(MDV_model.CodeBlock skipped_code): {
            return false;
        }
        case Quote(List<MDV_model.Block> skipped_quote): {
            return false;
        }
        case Table(MDV_model.Grid skipped_grid): {
            return false;
        }
    }
}

Part items(Context context, MDV_model.ListBlock list, int width) {
    // Numbers are as wide as the widest one and right-aligned, and every
    // marker is as wide as the widest, so the text lines up.
    int digits = str(list.start + list.items.size() - 1).size();
    int lead = 2;
    for (int index in 0 .. list.items.size()) {
        int marker_width = TUI_text.width(marker_of(context, list, index, list.items[index], digits));
        if (marker_width > lead) {
            lead = marker_width;
        }
    }
    Part out = Part([], []);
    for (int index in 0 .. list.items.size()) {
        MDV_model.ListItem item = list.items[index];
        if (index > 0 && !list.is_tight) {
            out.blank();
        }
        List<MDV_model.Block> kids = item.kids;
        if (item.task > 0) {
            kids = without_box(kids);
        }
        context.depth = context.depth + 1;
        Part body = Part([], []);
        MDV_model.Span guide = chrome("\u{2502} ", MDV_model.GUIDE);
        for (int slot in 0 .. kids.size()) {
            if (slot > 0 && !list.is_tight) {
                body.blank();
            }
            Part one = blocks_part(context, [kids[slot]], width - lead, false);
            if (slot > 0 && is_list(kids[slot])) {
                one = indent(one, guide, guide, true);
            }
            body.append(one);
        }
        context.depth = context.depth - 1;
        str marker = marker_of(context, list, index, item, digits);
        int marker_bits = MDV_model.BULLET;
        if (item.task > 0) {
            marker_bits = marker_bits | MDV_model.TASK;
        }
        str shown = marker + spaces(lead - TUI_text.width(marker));
        if (body.rows.size() == 0) {
            body.rows.push(blank_row());
        }
        out.append(indent(body, chrome(shown, marker_bits), chrome(spaces(lead), 0), false));
    }
    return out;
}

// --- tables --------------------------------------------------------------------------

/// Shrink `widths` until their table, borders included, fits in `width`.
void fit_columns(List<int> widths, int width) {
    int count = widths.size();
    int total = count * 3 + 1;
    for (int each in widths) {
        total = total + each;
    }
    while (total > width) {
        int widest = 0;
        for (int index in 1 .. count) {
            if (widths[index] > widths[widest]) {
                widest = index;
            }
        }
        if (widths[widest] <= 1) {
            return;
        }
        widths[widest] = widths[widest] - 1;
        total = total - 1;
    }
}

List<MDV_model.Span> border(str left, str middle, str right, str dash, List<int> widths) {
    List<str> parts = [left];
    for (int index in 0 .. widths.size()) {
        parts.push(dash.repeat(widths[index] + 2));
        if (index + 1 < widths.size()) {
            parts.push(middle);
        }
    }
    parts.push(right);
    return [chrome(parts.join(""), MDV_model.BORDER)];
}

/// One table row of cells as terminal rows: cells wrapped to their column and
/// padded to a common height. `bits` shade the cells (header, zebra).
List<List<MDV_model.Span>> table_row(List<MDV_model.Cell> cells, List<int> widths, List<int> align, int bits) {
    List<List<List<MDV_model.Span>>> columns = [];
    int height = 1;
    for (int column in 0 .. widths.size()) {
        List<MDV_model.Span> spans = [];
        if (column < cells.size()) {
            spans = with_bits(cells[column].spans, bits & MDV_model.ZEBRA);
        }
        List<List<MDV_model.Span>> wrapped = MDV_wrap.wrap(spans, widths[column]);
        if (wrapped.size() > height) {
            height = wrapped.size();
        }
        columns.push(wrapped);
    }
    List<List<MDV_model.Span>> out = [];
    for (int index in 0 .. height) {
        List<MDV_model.Span> spans = [chrome("\u{2502}", MDV_model.BORDER), chrome(" ", bits)];
        for (int column in 0 .. widths.size()) {
            List<MDV_model.Span> cell_line = [];
            if (index < columns[column].size()) {
                cell_line = columns[column][index];
            }
            int pad = widths[column] - MDV_wrap.spans_width(cell_line);
            int mode = 0;
            if (column < align.size()) {
                mode = align[column];
            }
            int before = 0;
            if (mode == 3) {
                before = pad;
            } else if (mode == 2) {
                before = pad / 2;
            }
            int after = pad - before;
            if (before > 0) {
                spans.push(chrome(spaces(before), bits));
            }
            for (MDV_model.Span span in cell_line) {
                spans.push(span);
            }
            spans.push(chrome(spaces(after) + " ", bits));
            spans.push(chrome("\u{2502}", MDV_model.BORDER));
            if (column + 1 < widths.size()) {
                spans.push(chrome(" ", bits));
            }
        }
        out.push(spans);
    }
    return out;
}

Part table(Context context, MDV_model.Grid grid, int width) {
    int count = grid.heads.size();
    List<int> widths = [];
    for (int column in 0 .. count) {
        int natural = 1;
        List<MDV_model.Cell> column_cells = [grid.heads[column]];
        for (List<MDV_model.Cell> row in grid.rows) {
            if (column < row.size()) {
                column_cells.push(row[column]);
            }
        }
        for (MDV_model.Cell cell in column_cells) {
            for (List<MDV_model.Span> piece in MDV_wrap.wrap(cell.spans, 100000)) {
                int cell_width = MDV_wrap.spans_width(piece);
                if (cell_width > natural) {
                    natural = cell_width;
                }
            }
        }
        widths.push(natural);
    }
    fit_columns(widths, width);
    List<List<MDV_model.Span>> lines = [];
    lines.push(border("\u{256d}", "\u{252c}", "\u{256e}", DASH, widths));
    for (List<MDV_model.Span> row_line in table_row(grid.heads, widths, grid.align, MDV_model.HEAD_CELL)) {
        lines.push(row_line);
    }
    lines.push(border("\u{255e}", "\u{256a}", "\u{2561}", DOUBLE, widths));
    for (int index in 0 .. grid.rows.size()) {
        int bits = 0;
        if (context.options.is_zebra && index % 2 == 1) {
            bits = MDV_model.ZEBRA;
        }
        for (List<MDV_model.Span> row_line in table_row(grid.rows[index], widths, grid.align, bits)) {
            lines.push(row_line);
        }
    }
    lines.push(border("\u{2570}", "\u{2534}", "\u{256f}", DASH, widths));
    List<str> texts = [cells_text(grid.heads)];
    for (List<MDV_model.Cell> row in grid.rows) {
        texts.push(cells_text(row));
    }
    return leaf(context, lines, grid.line, texts.join("\n"));
}

str cells_text(List<MDV_model.Cell> cells) {
    List<str> parts = [];
    for (MDV_model.Cell cell in cells) {
        parts.push(plain_of(cell.spans));
    }
    return parts.join(" | ");
}

/// Blocks one under another, a blank row between them when `is_spaced`.
Part blocks_part(Context context, List<MDV_model.Block> blocks, int width, bool is_spaced) {
    Part out = Part([], []);
    int room = width;
    if (room < 1) {
        room = 1;
    }
    for (int index in 0 .. blocks.size()) {
        if (index > 0 && is_spaced) {
            out.blank();
        }
        match (blocks[index]) {
            case Callout(MDV_model.CalloutBlock note): {
                out.append(callout(context, note, room));
            }
            case Meta(MDV_model.MetaBlock card): {
                out.append(meta(context, card, room));
            }
            case Notes(MDV_model.NoteBlock foot): {
                out.append(notes(context, foot, room));
            }
            case Rule(int rule_line): {
                out.append(rule(context, rule_line, room));
            }
            case Para(MDV_model.Text text): {
                out.append(paragraph(context, text, room));
            }
            case Head(MDV_model.HeadingBlock head): {
                out.append(heading(context, head, room));
            }
            case Code(MDV_model.CodeBlock block): {
                out.append(code(context, block, room));
            }
            case Quote(List<MDV_model.Block> inner): {
                out.append(quote(context, inner, room));
            }
            case Items(MDV_model.ListBlock list): {
                out.append(items(context, list, room));
            }
            case Table(MDV_model.Grid grid): {
                out.append(table(context, grid, room));
            }
        }
    }
    return out;
}

/// `doc` laid out to `width` columns with the default options.
pub MDV_model.Layout layout(MDV_model.Document doc, int width) {
    return layout_with(doc, Options(width));
}

/// `doc` laid out as `options` say.
pub MDV_model.Layout layout_with(MDV_model.Document doc, Options options) {
    Context context = Context([], [], options);
    Part part = blocks_part(context, doc.blocks, options.width, true);
    List<MDV_model.Link> links = [];
    for (MDV_model.Link link in doc.links) {
        links.push(MDV_model.Link(link.href, link.title, link.label, row: -1));
    }
    for (int index in 0 .. part.rows.size()) {
        for (MDV_model.Span span in part.rows[index].spans) {
            if (span.link >= 0 && links[span.link].row < 0) {
                MDV_model.Link link = links[span.link];
                links[span.link] = MDV_model.Link(link.href, link.title, link.label, row: index);
            }
        }
    }
    return MDV_model.Layout(part.rows, part.heads, links, options.width, context.texts);
}
