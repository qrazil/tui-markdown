// The command line: what to show, and whether to print it or run it.

import MDV_app;
import MDV_caps;
import MDV_cat;
import MDV_layout;
import MDV_prepare;
import MDV_render;
import MDV_theme;
import MDV_viewer;
import args;
import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_style;

pub const int DEFAULT_CAT_WIDTH = 80;
/// Keep in step with `version` in the `deps` file.
pub const str VERSION = "0.9.0";
/// What `--theme` accepts, as the usage error lists them.
const str THEME_NAMES = "dark, light, tokyonight, nightfox, gruvbox-material, plain";

args.Parser parser() {
    args.Parser cli = args.Parser("tui-markdown", summary: "Read markdown in the terminal, with vim keys.");
    cli.version = VERSION;
    cli.epilog = "exit status: 0 ok, 1 could not read a file or run the terminal, 2 usage error";
    cli.flag("cat", short: "c", help: "print the rendering and exit (the default when standard output is not a terminal)");
    cli.integer("width", short: "w", help: "columns for --cat (default: the terminal's, or 80)", placeholder: "N", min: "1");
    cli.flag("dump", help: "print the page as the screen shows it (theme background, margins) at --width, with no terminal needed");
    cli.integer("max-width", help: "widest text column, 0 for the whole window (default 100)", placeholder: "N", min: "0");
    cli.value("theme", help: "dark, light, tokyonight, nightfox, gruvbox-material or plain (default: from COLORFGBG; plain when NO_COLOR is set)", placeholder: "NAME");
    cli.value("scale", help: "H1 as scaled text (OSC 66): on, off or auto (from the environment: kitty)", placeholder: "MODE");
    cli.value("links", help: "OSC 8 hyperlinks: on, off or auto (from the environment: not Terminal.app or a dumb terminal)", placeholder: "MODE");
    cli.value("sync", help: "synchronized output (DEC 2026, asked of the terminal first): on, off or auto", placeholder: "MODE");
    cli.value("colors", help: "16, 256 or 24bit (default: from the terminal)", placeholder: "DEPTH");
    cli.flag("zebra", help: "shade alternate table rows");
    cli.flag("numbers", help: "line numbers in code blocks");
    cli.flag("side", help: "open with the outline sidebar");
    cli.value("mode", help: "start in preview, source or live (default preview)", placeholder: "PANE");
    cli.flag("edit", help: "start in live mode (same as --mode live)");
    cli.flag("smart", help: "smart typography while typing: curly quotes, en dashes, ellipses");
    cli.flag("no-watch", help: "do not reload when the file changes");
    cli.tail("files", help: "markdown files; with none, standard input; - is standard input", placeholder: "FILE");
    cli.completions();
    return cli;
}

/// Is `NO_COLOR` set to something? (no-color.org: any non-empty value.)
bool has_no_color() {
    match (os.env("NO_COLOR")) {
        case Some(str value): {
            return value.size() > 0;
        }
        case None: {
            return false;
        }
    }
}

/// Dark unless COLORFGBG ("fg;bg", set by some terminals) says the
/// background is a light colour.
bool is_light_background() {
    match (os.env("COLORFGBG")) {
        case Some(str value): {
            List<str> parts = value.split(";");
            match (parts[parts.size() - 1].parse_int()) {
                case Some(int background): {
                    return background >= 7 && background != 8;
                }
                case None: {
                    return false;
                }
            }
        }
        case None: {
            return false;
        }
    }
}

MDV_theme.Theme pick_theme(args.Parsed given) {
    match (given.value("theme")) {
        case Some(str name): {
            match (MDV_theme.named(name)) {
                case Some(MDV_theme.Theme chosen): {
                    return chosen;
                }
                case None: {
                    io.eprint("tui-markdown: unknown theme " + name + " (dark, light, plain); using dark");
                }
            }
        }
        case None: {
        }
    }
    if (has_no_color()) {
        return MDV_theme.plain();
    }
    if (is_light_background()) {
        return MDV_theme.light();
    }
    return MDV_theme.dark();
}

/// What a switch (`--scale`, `--links`) comes to: `on` and `off` are what they
/// say; `auto` is what the environment says (`is_detected`, from
/// `MDV_caps.detect`), whether or not the output is a screen.
pub bool is_switched_on(str mode, bool is_current, bool is_detected) {
    if (mode == "on") {
        return true;
    }
    if (mode == "off") {
        return false;
    }
    if (mode == "auto") {
        return is_detected;
    }
    return is_current;
}

/// The capabilities to use: what the environment says, overridden by the
/// flags.
MDV_caps.Caps pick_caps(args.Parsed given, bool is_screen) {
    MDV_caps.Caps caps = MDV_caps.bare();
    if (is_screen) {
        caps = MDV_caps.detect();
    } else {
        caps.depth = MDV_caps.detect().depth;
    }
    match (given.value("colors")) {
        case Some(str depth): {
            if (depth == "16") {
                caps.depth = TUI_style.Depth.Ansi16;
            } else if (depth == "256") {
                caps.depth = TUI_style.Depth.Ansi256;
            } else if (depth == "24bit" || depth == "truecolor") {
                caps.depth = TUI_style.Depth.TrueColour;
            }
        }
        case None: {
        }
    }
    match (given.value("scale")) {
        case Some(str mode): {
            caps.has_scale = is_switched_on(mode, caps.has_scale, MDV_caps.detect().has_scale);
        }
        case None: {
        }
    }
    match (given.value("links")) {
        case Some(str mode): {
            caps.has_links = is_switched_on(mode, caps.has_links, MDV_caps.detect().has_links);
        }
        case None: {
        }
    }
    match (given.value("sync")) {
        case Some(str mode): {
            caps.has_sync = is_switched_on(mode, caps.has_sync, MDV_caps.detect().has_sync);
        }
        case None: {
        }
    }
    return caps;
}

/// One source of text: its name and what it said.
type Source {
    str name;
    str text;
}

Result<Source, str> load(str name) {
    if (name == "-" || name == MDV_app.STDIN_NAME) {
        match (MDV_app.read_stdin()) {
            case Ok(str text): {
                return Result<Source, str>.Ok(Source(MDV_app.STDIN_NAME, text));
            }
            case Err(io.Error error): {
                return Result<Source, str>.Err("standard input: " + error.to_str());
            }
        }
    }
    match (MDV_app.read_text(name)) {
        case Ok(str text): {
            return Result<Source, str>.Ok(Source(name, text));
        }
        case Err(io.Error error): {
            return Result<Source, str>.Err(name + ": " + error.to_str());
        }
    }
}

bool is_written(bytes data) {
    io.File out = io.stdout();
    match (out.write(data)) {
        case Ok(int count): {
            return true;
        }
        case Err(io.Error error): {
            return false;
        }
    }
}

/// What a print of the layout is told: the page and what to switch on.
type Look {
    MDV_theme.Theme theme;
    MDV_caps.Caps caps;
    int width;
    int max_width;
    bool is_dump;
    bool is_zebra;
    bool has_numbers;
    bool is_smart = false;
    str pane = "preview";
}

/// The text column for a page `width` wide, as the viewer picks it.
int text_width(int width, int max_width) {
    int text = width - 1 - 2;
    if (max_width > 0 && text > max_width) {
        text = max_width;
    }
    if (text < 8) {
        text = 8;
    }
    return text;
}

bytes print_one(str text, Look look) {
    if (look.is_dump) {
        int wide = text_width(look.width, look.max_width);
        MDV_layout.Options options = MDV_layout.Options(wide, is_scaled: look.caps.has_scale, is_zebra: look.is_zebra, has_numbers: look.has_numbers);
        int left = (look.width - 1 - wide) / 2;
        if (left < 1) {
            left = 1;
        }
        return MDV_cat.dump(text, options, look.theme, look.caps, left, look.width);
    }
    MDV_layout.Options options = MDV_layout.Options(look.width, is_scaled: look.caps.has_scale, is_zebra: look.is_zebra, has_numbers: look.has_numbers);
    return MDV_cat.render_with(MDV_layout.layout_with(MDV_prepare.prepare(text), options), look.theme, look.caps, 0, 0);
}

int run_cat(List<str> names, Look look) {
    for (int index in 0 .. names.size()) {
        match (load(names[index])) {
            case Ok(Source source): {
                if (index > 0) {
                    if (!is_written("\n".to_bytes())) {
                        return 0;
                    }
                }
                if (!is_written(print_one(source.text, look))) {
                    return 0;
                }
            }
            case Err(str why): {
                io.eprint("tui-markdown: " + why);
                return 1;
            }
        }
    }
    return 0;
}

/// How long a read waits, which is also how long a held Escape waits for the
/// rest of a key sequence.
const int ESCAPE_WAIT_MS = 50;
/// How often the timer asks whether the file changed on disk.
const int WATCH_MS = 250;

/// The loop's settings. Mouse reports are asked for with
/// `should_report_raw_mouse` and `should_report_hover` rather than with
/// `should_report_mouse`: the loop would then route them to a `MouseHandler`,
/// and the viewer takes the raw reports. One frame per event
/// (`drain_events`), as it always was.
pub TUI_app.Loop make_loop(MDV_caps.Caps caps) {
    TUI_app.Loop loop = TUI_app.Loop(depth: caps.depth);
    loop.input_fd = TUI_app.INPUT_AUTO;
    loop.tick_ms = ESCAPE_WAIT_MS;
    loop.animate_ms = WATCH_MS;
    loop.drain_events = 0;
    loop.copy_limit = MDV_app.MAX_COPY;
    loop.should_report_raw_mouse = true;
    loop.should_report_hover = true;
    loop.should_report_paste = true;
    loop.should_sync = caps.has_sync;
    // CTRL-L writes every cell again, for a screen something else wrote on
    loop.should_repaint_on_ctrl_l = true;
    return loop;
}

int run_viewer(List<str> names, List<str> files, Look look, bool is_watching, bool is_side) {
    match (load(names[0])) {
        case Err(str why): {
            io.eprint("tui-markdown: " + why);
            return 1;
        }
        case Ok(Source source): {
            term.Size size = TUI_app.screen_size();
            MDV_viewer.Viewer viewer = MDV_viewer.open(files, source.name, source.text, size.columns, size.rows);
            viewer.max_width = look.max_width;
            viewer.is_scaled = look.caps.has_scale;
            viewer.is_zebra = look.is_zebra;
            viewer.has_numbers = look.has_numbers;
            viewer.is_side_open = is_side;
            viewer.resize(size.columns, size.rows);
            viewer.relayout();
            viewer.is_smart = look.is_smart;
            if (look.pane == "source") {
                viewer.set_pane(MDV_viewer.Pane.Source);
            } else if (look.pane == "live") {
                viewer.set_pane(MDV_viewer.Pane.Live);
            }
            MDV_app.App app = MDV_app.open(viewer, look.theme, look.caps);
            app.is_watching = is_watching;
            if (!term.is_terminal(1)) {
                io.eprint("tui-markdown: " + term.Error.NotATerminal.to_str());
                return 1;
            }
            TUI_app.Loop loop = make_loop(look.caps);
            app.loop = loop;
            loop.after_frame = Option<TUI_app.AfterFrame>.Some(app.screen);
            match (loop.run_with(app.screen, app, app, TUI_app.NoMouse())) {
                case Ok(int status): {
                    return 0;
                }
                case Err(term.Error error): {
                    io.eprint("tui-markdown: " + error.to_str());
                    return 1;
                }
            }
        }
    }
}

// A value that is not one of the words its option takes. Said once, up front,
// as a usage error (it used to warn and fall back to dark).
str refuse_values(args.Parsed given) {
    match (given.value("theme")) {
        case Some(str name): {
            if (MDV_theme.named(name).is_none()) {
                return "'--theme' needs one of " + THEME_NAMES + ", and got '" + name + "'";
            }
        }
        case None: {
        }
    }
    List<str> switches = ["scale", "links", "sync"];
    for (str name in switches) {
        match (given.value(name)) {
            case Some(str mode): {
                if (mode != "on" && mode != "off" && mode != "auto") {
                    return "'--" + name + "' needs on, off or auto, and got '" + mode + "'";
                }
            }
            case None: {
            }
        }
    }
    match (given.value("colors")) {
        case Some(str depth): {
            if (depth != "16" && depth != "256" && depth != "24bit" && depth != "truecolor") {
                return "'--colors' needs 16, 256 or 24bit, and got '" + depth + "'";
            }
        }
        case None: {
        }
    }
    match (given.value("mode")) {
        case Some(str pane): {
            str lower = pane.to_lower();
            if (lower != "preview" && lower != "source" && lower != "live") {
                return "'--mode' needs preview, source or live, and got '" + pane + "'";
            }
        }
        case None: {
        }
    }
    return "";
}

/// The whole program: `argv` without the program's own name; the exit status.
pub int run(List<str> argv) {
    args.Parser cli = parser();
    match (cli.parse(argv)) {
        case Err(args.UsageError error): {
            io.eprint("tui-markdown: " + error.to_str());
            io.eprint(cli.usage());
            return 2;
        }
        case Ok(args.Parsed given): {
            match (given.help()) {
                case Some(str text): {
                    print(text);
                    return 0;
                }
                case None: {
                }
            }
            match (given.version()) {
                case Some(str text): {
                    print(text);
                    return 0;
                }
                case None: {
                }
            }
            match (given.completions()) {
                case Some(str script): {
                    print(script);
                    return 0;
                }
                case None: {
                }
            }
            str refusal = refuse_values(given);
            if (refusal != "") {
                cli.fail(refusal);
                return 2;
            }
            List<str> names = given.tail("files");
            if (names.size() == 0) {
                if (term.is_terminal(0)) {
                    io.eprint("tui-markdown: no file given and standard input is a terminal");
                    io.eprint(cli.usage());
                    return 2;
                }
                names = [MDV_app.STDIN_NAME];
            }
            bool is_dump = given.is_flag_set("dump");
            bool is_interactive = !is_dump && !given.is_flag_set("cat") && TUI_app.pick_input_fd(TUI_app.INPUT_AUTO, term.is_terminal(0), term.is_terminal(1)) >= 0 && term.is_terminal(1);
            Look look = Look(pick_theme(given), pick_caps(given, is_interactive), given.integer("width").or(0), given.integer("max-width").or(MDV_viewer.MAX_TEXT_WIDTH), is_dump, given.is_flag_set("zebra"), given.is_flag_set("numbers"));
            look.is_smart = given.is_flag_set("smart");
            if (given.is_flag_set("edit")) {
                look.pane = "live";
            }
            match (given.value("mode")) {
                case Some(str wanted): {
                    look.pane = wanted.to_lower();
                }
                case None: {
                }
            }
            if (!is_interactive) {
                if (look.width < 1) {
                    look.width = DEFAULT_CAT_WIDTH;
                    if (is_dump) {
                        look.width = 100;
                    }
                    if (term.is_terminal(1)) {
                        look.width = TUI_app.screen_size().columns;
                    }
                }
                if (is_dump && given.value("colors").is_none()) {
                    look.caps.depth = TUI_style.Depth.TrueColour;
                }
                return run_cat(names, look);
            }
            List<str> files = [];
            if (names[0] != MDV_app.STDIN_NAME && names[0] != "-") {
                files = names;
            }
            return run_viewer(names, files, look, !given.is_flag_set("no-watch"), given.is_flag_set("side"));
        }
    }
}
