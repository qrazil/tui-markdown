str on_off(bool is_on) {
    if (is_on) {
        return "on";
    }
    return "off";
}

// --- saving, quitting, asking ----------------------------------------------------------------------------

// --- the command palette ------------------------------------------------------------------------------------

// --- find and replace -------------------------------------------------------------------------------------------------

// --- keys -----------------------------------------------------------------------------------------------------------

/// The action a Ctrl-letter means in the editing panes, 0 for none.
int ctrl_action(int value) {
    if (value == 'a') {
        return MDV_actions.SELECT_ALL;
    }
    if (value == 'b') {
        return MDV_actions.BOLD;
    }
    if (value == 'e') {
        return MDV_actions.CODE;
    }
    if (value == 'k') {
        return MDV_actions.LINK;
    }
    if (value == 'c') {
        return MDV_actions.COPY;
    }
    if (value == 'x') {
        return MDV_actions.CUT;
    }
    if (value == 'v') {
        return MDV_actions.PASTE;
    }
    if (value == 'z') {
        return MDV_actions.UNDO;
    }
    if (value == 'y') {
        return MDV_actions.REDO;
    }
    return 0;
}

/// The action an Alt-key means in the editing panes, 0 for none.
int alt_action(int value) {
    if (value == 'i') {
        return MDV_actions.ITALIC;
    }
    if (value == 'd') {
        return MDV_actions.STRIKE;
    }
    if (value == 'm') {
        return MDV_actions.IMAGE;
    }
    if (value >= '1' && value <= '6') {
        return MDV_actions.HEADING_1 + value - '1';
    }
    return 0;
}

// --- checkboxes -----------------------------------------------------------------------------------------------------
