// The viewer's state machine.
//
// Everything the program decides, with no terminal in sight: a `Viewer` holds
// the document, its layout at the current width, where the window is, what is
// being searched for, which link is focused, the back stack and the open
// popup. `key` takes one key and answers whether to redraw or quit. What the
// outside world must do (copy to the clipboard, read a file again, open
// another one) is not done here but left as a `Request` for the loop to
// carry out -- which is what makes the whole key set testable by typing
// names into a struct (tests/t_viewer.m31) rather than through a pty.
//
// Rows are counted from 0; a window shows rows `top .. top + height()`; the
// last terminal row is the status line, so `height()` is `rows - 1`.

import MDV_actions;
import MDV_assist;
import MDV_edit;
import MDV_find;
import MDV_keys;
import MDV_live;
import MDV_layout;
import MDV_model;
import MDV_prepare;
import MDV_theme;
import term;
import tui.core.TUI_syntax;
import tui.core.TUI_text;
import tui.app.TUI_app;
import tui.widgets.TUI_outline;

/// Something the viewer wants done that it cannot do itself.
pub enum Request {
    /// Read the current file again and call `refresh`.
    Reload;
    /// Read this path and call `opened` (or `load_failed`).
    Open(str);
    /// Put this text on the system clipboard (OSC 52).
    Copy(str);
    /// Hand this URL to the system's opener (`xdg-open`, `open`).
    OpenUrl(str);
    /// Write this text to this path, then call `saved` (or `save_failed`).
    Save(str, str);
    /// Read the system clipboard and call `paste_text` with it.
    Paste;
}

/// What the window shows: the rendered page, the raw markdown, or the page
/// with the block under the caret as raw markdown.
pub enum Pane {
    Preview;
    Source;
    Live;
}

/// A clickable region of the header or toolbar: columns `first` up to
/// `stop`, and the action a click runs (see `MDV_actions`).
pub type Button {
    pub int first;
    pub int stop;
    pub int action;
}

/// What the keys mean at the moment.
pub enum Mode {
    Normal;
    /// Typing a search after `/`.
    Search;
    /// The outline popup.
    Outline;
    /// The key help popup.
    Help;
    /// The find (and replace) bar.
    Find;
    /// The command palette.
    Palette;
    /// A question or a name asked on the status line (see `prompt_kind`).
    Prompt;
}

/// A place to come back to: which file, which block, how far into it.
pub type Place {
    pub str name;
    pub int block;
    pub int offset;
    pub int link;
}

/// One search hit: a row, and a byte range of that row's `Row.content()`.
pub type Hit {
    pub int row;
    pub int start;
    pub int end;
}

pub const int MAX_TEXT_WIDTH = 100;
/// The sidebar's widest, in columns.
pub const int SIDE_WIDTH = 32;
pub const int MIN_TEXT_WIDTH = 8;
/// Columns left empty on each side of the text.
pub const int MARGIN = 1;

pub type Viewer {
    /// The files given on the command line, in order; empty for standard input.
    pub List<str> files;
    /// The path being shown ("<stdin>" when there is none).
    pub str name;
    pub MDV_edit.Buffer buffer;
    pub MDV_model.Document doc;
    pub MDV_model.Layout layout;
    pub int columns;
    pub int rows;
    /// First row shown.
    pub int top = 0;
    /// The number typed before a command, 0 for none.
    pub int count = 0;
    /// The first key of a two-key command (`g`, `]`, `[`), "" for none.
    pub str pending = "";
    pub Mode mode = Mode.Normal;
    /// What is being typed after `/`.
    pub str query = "";
    /// The last search that was run; its hits are marked.
    pub str needle = "";
    pub List<Hit> hits = [];
    /// Which of `hits` is current, -1 for none.
    pub int hit = -1;
    /// Which link is focused (an index into `layout.links`), -1 for none.
    pub int link = -1;
    pub List<Place> back = [];
    /// One line for the status bar, until the next key.
    pub str message = "";
    pub TUI_outline.Outline outline = TUI_outline.Outline([]);
    pub int help_top = 0;
    pub List<Request> requests = [];
    /// After an `Open` completes: the heading to jump to, "" for none.
    pub str pending_anchor = "";
    /// After an `Open` completes: the place to restore, if it is a way back.
    pub List<Place> pending_place = [];
    /// Was a place pushed for the `Open` that is under way?
    pub bool did_push = false;
    /// The widest the text gets, 0 for the whole window.
    pub int max_width = MAX_TEXT_WIDTH;
    pub bool is_scaled = false;
    pub bool is_zebra = false;
    pub bool has_numbers = false;
    /// Is the outline docked at the left?
    pub bool is_side_open = false;
    /// Where the header's buttons are, set by the screen on every frame.
    pub List<Button> buttons = [];
    /// The link under the pointer, -1 for none.
    pub int hover_link = -1;
    /// Is the scrollbar being dragged?
    pub bool is_dragging = false;
    /// A theme the screen should switch to ("" for none).
    pub str new_theme = "";
    /// First heading shown in the sidebar.
    pub int side_top = 0;
    pub Pane pane = Pane.Preview;
    pub MDV_find.Finder finder = MDV_find.Finder();
    pub MDV_live.LiveCache live = MDV_live.LiveCache();
    /// Which block Live drew as source, -1 for none.
    pub int live_active = -1;
    /// Bumped whenever `doc` is made again, so a Live cache knows.
    pub int serial = 0;
    /// Must `doc` be made again before the next layout?
    pub bool is_doc_stale = false;
    /// Has the text changed since `doc` was made, even if Live may go on
    /// using the old one until the caret leaves its block?
    pub bool is_doc_old = false;
    pub bool is_smart = false;
    /// Replace row open in the find bar, and which field has the keys.
    pub bool is_replace = false;
    pub bool is_replace_focused = false;
    /// 1, 2 or 3 for single, double and triple click (set by the program).
    pub int click_count = 1;
    pub bool is_selecting = false;
    /// What was last cut or copied here, for a paste with no system clipboard.
    pub str clipboard = "";
    /// What a prompt is asking ("saveas", "quit", "open", "reload", "discard"),
    /// the text typed so far, and what to do afterwards.
    pub str prompt_kind = "";
    pub str prompt_text = "";
    pub str pending_open = "";
    pub bool should_quit = false;
    pub bool is_quit_after_save = false;
    /// The palette's chosen row; where the screen drew it (for clicks).
    pub int palette_pick = 0;
    pub int palette_y = 0;
    pub int palette_x0 = 0;
    pub int palette_x1 = 0;
    pub int palette_rows = 0;
    pub int palette_first = 0;
    /// Toolbar buttons of the editing panes, set by the screen every frame.
    pub List<Button> tools = [];
    /// Highlight caches for source rows: classes and end state per line.
    pub List<List<int>> hl_classes = [];
    pub List<int> hl_states = [];
    pub int hl_valid = 0;
    pub int words_revision = -1;
    pub int words_count = 0;
}

/// Rows of text on screen: all but the header, the toolbar (editing panes),
/// the find bar and the status line.
pub int Viewer.height() {
    int room = rows - top_rows() - bar_rows() - 1;
    if (room < 1) {
        return 1;
    }
    return room;
}

/// Rows above the text: the header, and the toolbar in the editing panes.
pub int Viewer.top_rows() {
    if (is_editing()) {
        return 2;
    }
    return 1;
}

/// Rows the find bar takes between the text and the status line.
pub int Viewer.bar_rows() {
    match (mode) {
        case Find: {
            if (is_replace) {
                return 2;
            }
            return 1;
        }
        case Normal: {
            return 0;
        }
        case Search: {
            return 0;
        }
        case Outline: {
            return 0;
        }
        case Help: {
            return 0;
        }
        case Palette: {
            return 0;
        }
        case Prompt: {
            return 0;
        }
    }
}

/// Are the keys going to the text (no bar, popup or question open)?
pub bool Viewer.is_plain_mode() {
    match (mode) {
        case Normal: {
            return true;
        }
        case Search: {
            return false;
        }
        case Outline: {
            return false;
        }
        case Help: {
            return false;
        }
        case Find: {
            return false;
        }
        case Palette: {
            return false;
        }
        case Prompt: {
            return false;
        }
    }
}

pub bool Viewer.is_live() {
    match (pane) {
        case Live: {
            return true;
        }
        case Preview: {
            return false;
        }
        case Source: {
            return false;
        }
    }
}

pub bool Viewer.is_editing() {
    match (pane) {
        case Preview: {
            return false;
        }
        case Source: {
            return true;
        }
        case Live: {
            return true;
        }
    }
}

/// Columns of the sidebar (0 when it is closed or the window too narrow).
pub int Viewer.side_width() {
    if (!is_side_open || columns < 50) {
        return 0;
    }
    int wide = columns / 3;
    if (wide > SIDE_WIDTH) {
        wide = SIDE_WIDTH;
    }
    return wide;
}

pub int Viewer.total() {
    return layout.rows.size();
}

pub int Viewer.max_top() {
    int most = total() - height();
    if (most < 0) {
        return 0;
    }
    return most;
}

/// Where the text starts on screen: past the sidebar, centred in what is
/// left when that is wider than the longest line.
pub int Viewer.left() {
    int side = side_width();
    int spare = columns - side - 1 - layout.width;
    if (spare < 2 * MARGIN) {
        return side + MARGIN;
    }
    return side + spare / 2;
}

/// Make `doc` from the buffer again if the text has changed since.
void Viewer.ensure_doc() {
    if (is_doc_stale) {
        doc = MDV_prepare.prepare(buffer.text());
        serial = serial + 1;
        is_doc_stale = false;
        is_doc_old = false;
    }
}

MDV_layout.Options Viewer.options() {
    return MDV_layout.Options(text_width(), is_scaled: is_scaled, is_zebra: is_zebra, has_numbers: has_numbers);
}

/// The layout for the window and the pane as they are.
MDV_model.Layout Viewer.build_layout() {
    match (pane) {
        case Preview: {
            ensure_doc();
            return MDV_layout.layout_with(doc, options());
        }
        case Source: {
            live_active = -1;
            return MDV_live.source_layout(buffer.lines, text_width());
        }
        case Live: {
            ensure_doc();
            MDV_layout.Options wanted = options();
            if (live.serial != serial || live.width != wanted.width || live.is_scaled != wanted.is_scaled || live.is_zebra != wanted.is_zebra || live.has_numbers != wanted.has_numbers) {
                MDV_live.build_cache(live, doc, buffer.lines, wanted, serial);
            }
            live_active = MDV_live.block_at(live, buffer.caret.row);
            return MDV_live.live_layout(doc, buffer.lines, buffer.caret.row, live, wanted.width);
        }
    }
}

/// Columns the text gets: the window less the sidebar, the scrollbar and the
/// margins, capped at `max_width`.
pub int Viewer.text_width() {
    int width = columns - side_width() - 1 - 2 * MARGIN;
    if (max_width > 0 && width > max_width) {
        width = max_width;
    }
    if (width < MIN_TEXT_WIDTH) {
        width = MIN_TEXT_WIDTH;
    }
    return width;
}

void Viewer.scroll_to(int target) {
    int limit = max_top();
    if (target > limit) {
        top = limit;
    } else if (target < 0) {
        top = 0;
    } else {
        top = target;
    }
}

/// How far through the document the window is, 0..100.
pub int Viewer.percent() {
    if (max_top() == 0) {
        return 100;
    }
    return top * 100 / max_top();
}

/// Is `row` on screen?
pub bool Viewer.is_visible(int row) {
    return row >= top && row < top + height();
}

/// Bring `row` into view, leaving it a third of the way down when it has to
/// scroll.
void Viewer.reveal(int row) {
    if (is_visible(row)) {
        return;
    }
    scroll_to(row - height() / 3);
}

Anchor Viewer.anchor_here() {
    for (int index in top .. layout.rows.size()) {
        int block = layout.rows[index].block;
        if (block >= 0) {
            int first = index;
            while (first > 0 && layout.rows[first - 1].block == block) {
                first = first - 1;
            }
            return Anchor(block, top - first);
        }
    }
    return Anchor(-1, 0);
}

int Viewer.row_of_anchor(Anchor anchor) {
    if (anchor.block < 0) {
        return 0;
    }
    for (int index in 0 .. layout.rows.size()) {
        if (layout.rows[index].block == anchor.block) {
            return index + anchor.offset;
        }
    }
    return 0;
}

Place Viewer.place_here() {
    Anchor anchor = anchor_here();
    return Place(name, anchor.block, anchor.offset, link);
}

void Viewer.go_to_place(Place place) {
    scroll_to(row_of_anchor(Anchor(place.block, place.offset)));
    if (place.link < layout.links.size()) {
        link = place.link;
    } else {
        link = -1;
    }
}

/// The source line the first mapped row at or below the window starts.
int Viewer.line_here() {
    for (int index in top .. layout.rows.size()) {
        if (layout.rows[index].line > 0) {
            return layout.rows[index].line;
        }
    }
    return 0;
}

/// Lay the document out again for the current width, keeping the place.
pub void Viewer.relayout() {
    Anchor anchor = anchor_here();
    layout = build_layout();
    scroll_to(row_of_anchor(anchor));
    if (link >= layout.links.size()) {
        link = -1;
    }
    find_hits();
}

/// The terminal changed size.
pub void Viewer.resize(int new_columns, int new_rows) {
    columns = new_columns;
    rows = new_rows;
    if (text_width() != layout.width) {
        relayout();
    } else {
        scroll_to(top);
    }
}

/// Show another document from the top (or at the anchor or place a followed
/// link asked for).
pub void Viewer.load(str path, str text) {
    name = path;
    buffer = MDV_edit.Buffer.of(text);
    doc = MDV_prepare.prepare(text);
    serial = serial + 1;
    is_doc_stale = false;
    hl_valid = 0;
    layout = build_layout();
    top = 0;
    link = -1;
    mode = Mode.Normal;
    pending = "";
    count = 0;
    find_hits();
    if (pending_place.size() > 0) {
        go_to_place(pending_place[0]);
    } else if (pending_anchor.size() > 0) {
        jump_to_anchor(pending_anchor);
    }
    pending_place = [];
    pending_anchor = "";
    did_push = false;
}

/// An `Open` request was answered with the file.
pub void Viewer.opened(str path, str text) {
    load(path, text);
}

/// An `Open` request failed: say why, and forget the place pushed for it.
pub void Viewer.load_failed(str why) {
    message = why;
    if (did_push && back.size() > 0) {
        back.pop();
    }
    did_push = false;
    pending_place = [];
    pending_anchor = "";
}

/// The current file changed on disk: show the new text, keeping the place.
pub void Viewer.refresh(str text) {
    int line = line_here();
    int old_link = link;
    MDV_edit.Pos old_caret = buffer.caret;
    buffer = MDV_edit.Buffer.of(text);
    buffer.caret = buffer.clamp(old_caret);
    doc = MDV_prepare.prepare(text);
    serial = serial + 1;
    is_doc_stale = false;
    hl_valid = 0;
    layout = build_layout();
    scroll_to(layout.row_of_line(line));
    if (old_link < layout.links.size()) {
        link = old_link;
    } else {
        link = -1;
    }
    find_hits();
    message = "reloaded";
}

/// Take the requests made since the last call.
pub List<Request> Viewer.drain() {
    List<Request> out = requests;
    requests = [];
    return out;
}

/// All hits of `needle` in the layout. A needle with no capital letter ignores
/// case (smart case).
void Viewer.find_hits() {
    hits = [];
    hit = -1;
    if (needle.size() == 0) {
        return;
    }
    bool is_exact = has_upper(needle) || finder.is_exact;
    str wanted = needle;
    if (!is_exact) {
        wanted = needle.to_lower();
    }
    for (int index in 0 .. layout.rows.size()) {
        str content = layout.rows[index].content();
        if (content.size() < wanted.size()) {
            continue;
        }
        if (!is_exact) {
            str lowered = content.to_lower();
            // A letter whose lower case is longer or shorter would put a hit
            // at the wrong byte; such a row is not searched.
            if (lowered.size() != content.size()) {
                continue;
            }
            content = lowered;
        }
        int from = 0;
        bool is_scanning = true;
        while (is_scanning) {
            match (content.substr(from, content.size()).index_of(wanted)) {
                case Some(int offset): {
                    hits.push(Hit(index, from + offset, from + offset + wanted.size()));
                    from = from + offset + wanted.size();
                }
                case None: {
                    is_scanning = false;
                }
            }
        }
    }
}

/// Make hit `target` (wrapping) the current one and show it.
void Viewer.go_to_hit(int target) {
    if (hits.size() == 0) {
        return;
    }
    int wrapped = target;
    if (target >= hits.size()) {
        wrapped = 0;
        message = "search hit BOTTOM, continuing at TOP";
    } else if (target < 0) {
        wrapped = hits.size() - 1;
        message = "search hit TOP, continuing at BOTTOM";
    }
    hit = wrapped;
    reveal(hits[hit].row);
}

/// The first hit on or below the window's first row.
int Viewer.first_hit_from_top() {
    for (int index in 0 .. hits.size()) {
        if (hits[index].row >= top) {
            return index;
        }
    }
    return 0;
}

void Viewer.commit_search() {
    mode = Mode.Normal;
    if (query.size() > 0) {
        needle = query;
    }
    query = "";
    find_hits();
    if (needle.size() == 0) {
        return;
    }
    if (hits.size() == 0) {
        message = "pattern not found: " + needle;
        return;
    }
    go_to_hit(first_hit_from_top());
    message = str(hits.size()) + " match(es) for " + needle;
}

/// The hits whose rows are in `first .. stop`, for drawing.
pub List<Hit> Viewer.hits_between(int first, int stop) {
    List<Hit> out = [];
    for (Hit each in hits) {
        if (each.row >= first && each.row < stop) {
            out.push(each);
        }
    }
    return out;
}

void Viewer.focus_link(int target) {
    link = target;
    reveal(layout.links[target].row);
    message = layout.links[target].href;
}

void Viewer.next_link(int step) {
    int count_links = layout.links.size();
    if (count_links == 0) {
        message = "no links";
        return;
    }
    if (link < 0) {
        if (step > 0) {
            for (int index in 0 .. count_links) {
                if (layout.links[index].row >= top) {
                    focus_link(index);
                    return;
                }
            }
            focus_link(0);
            return;
        }
        int bottom = top + height();
        for (int index in 0 .. count_links) {
            int back_index = count_links - 1 - index;
            if (layout.links[back_index].row < bottom) {
                focus_link(back_index);
                return;
            }
        }
        focus_link(count_links - 1);
        return;
    }
    int target = link + step;
    if (target >= count_links) {
        target = 0;
    } else if (target < 0) {
        target = count_links - 1;
    }
    focus_link(target);
}

void Viewer.jump_to_anchor(str slug) {
    for (MDV_model.Heading heading in layout.headings) {
        if (heading.slug == slug) {
            scroll_to(heading.row);
            return;
        }
    }
    message = "no heading #" + slug;
}

void Viewer.push_here() {
    back.push(place_here());
    did_push = true;
}

/// Follow `href`: an anchor scrolls, a markdown file is opened, anything else
/// is copied.
void Viewer.follow(str href) {
    if (href.size() == 0) {
        message = "link has no target";
        return;
    }
    if (href.starts_with("#")) {
        Place here = place_here();
        str slug = href.substr(1, href.size());
        bool did_find = false;
        for (MDV_model.Heading heading in layout.headings) {
            if (heading.slug == slug) {
                did_find = true;
            }
        }
        if (!did_find) {
            message = "no heading " + href;
            return;
        }
        back.push(here);
        jump_to_anchor(slug);
        return;
    }
    if (is_external(href)) {
        requests.push(Request.Copy(href));
        message = "copied " + href;
        return;
    }
    str path = href;
    str fragment = "";
    match (href.index_of("#")) {
        case Some(int slot): {
            path = href.substr(0, slot);
            fragment = href.substr(slot + 1, href.size());
        }
        case None: {
        }
    }
    str target = resolve(name, path);
    if (path.size() == 0 || target == name) {
        follow("#" + fragment);
        return;
    }
    if (!is_markdown_path(path)) {
        requests.push(Request.Copy(href));
        message = "not markdown, copied " + href;
        return;
    }
    push_here();
    pending_anchor = fragment;
    ask_open(target);
}

void Viewer.go_back() {
    if (back.size() == 0) {
        message = "nothing to go back to";
        return;
    }
    Place place = back.pop();
    if (place.name == name) {
        go_to_place(place);
        return;
    }
    pending_place = [place];
    ask_open(place.name);
}

void Viewer.open_outline() {
    if (layout.headings.size() == 0) {
        message = "no headings";
        return;
    }
    outline = TUI_outline.Outline(outline_nodes(layout.headings, Cursor(0), 0));
    // The cursor starts on the last heading at or above the window.
    int current = 0;
    for (int index in 0 .. layout.headings.size()) {
        if (layout.headings[index].row <= top) {
            current = index;
        }
    }
    bool did_select = outline.did_select_id(str(current));
    mode = Mode.Outline;
}

TUI_app.Action Viewer.outline_key(str key_name) {
    if (key_name == "esc" || key_name == "q" || key_name == "o") {
        mode = Mode.Normal;
        return TUI_app.Action.Redraw;
    }
    if (key_name == "j" || key_name == "down" || key_name == "ctrl-n") {
        outline.move(1);
    } else if (key_name == "k" || key_name == "up" || key_name == "ctrl-p") {
        outline.move(-1);
    } else if (key_name == "ctrl-d" || key_name == "pgdn") {
        outline.move(10);
    } else if (key_name == "ctrl-u" || key_name == "pgup") {
        outline.move(-10);
    } else if (key_name == "g" || key_name == "home") {
        outline.move(-100000);
    } else if (key_name == "G" || key_name == "end") {
        outline.move(100000);
    } else if (key_name == "l" || key_name == "right") {
        outline.expand();
    } else if (key_name == "h" || key_name == "left") {
        outline.collapse();
    } else if (key_name == "space" || key_name == "tab") {
        outline.toggle();
    } else if (key_name == "enter") {
        match (outline.current()) {
            case Some(TUI_outline.Row row): {
                match (row.node.id.parse_int()) {
                    case Some(int index): {
                        back.push(place_here());
                        scroll_to(layout.headings[index].row);
                        if (is_editing()) {
                            buffer.place(MDV_edit.Pos(layout.headings[index].line - 1, 0), false);
                            after(buffer.caret.row, buffer.lines.size(), false);
                            scroll_to(layout.headings[index].row);
                        }
                    }
                    case None: {
                    }
                }
            }
            case None: {
            }
        }
        mode = Mode.Normal;
    } else if (key_name == "ctrl-c") {
        return TUI_app.Action.Quit;
    }
    return TUI_app.Action.Redraw;
}

/// The number to repeat a command by: what was typed, or 1.
int Viewer.take() {
    int each = count;
    count = 0;
    if (each < 1) {
        return 1;
    }
    return each;
}

void Viewer.page(int step) {
    int size = height() - 1;
    if (size < 1) {
        size = 1;
    }
    scroll_to(top + step * size * take());
}

void Viewer.half_page(int step) {
    int size = height() / 2;
    if (size < 1) {
        size = 1;
    }
    scroll_to(top + step * size * take());
}

/// Move to the `times`-th heading below (step 1) or above (step -1) the top
/// of the window.
void Viewer.heading(int step, int times) {
    int target = -1;
    int found = 0;
    int size = layout.headings.size();
    for (int each in 0 .. size) {
        int index = each;
        if (step < 0) {
            index = size - 1 - each;
        }
        int row = layout.headings[index].row;
        bool is_beyond = row > top;
        if (step < 0) {
            is_beyond = row < top;
        }
        if (is_beyond) {
            found = found + 1;
            target = row;
            if (found == times) {
                break;
            }
        }
    }
    if (target < 0) {
        if (step > 0) {
            message = "no more headings";
        } else if (top > 0) {
            scroll_to(0);
        } else {
            message = "no earlier heading";
        }
        return;
    }
    scroll_to(target);
}

void Viewer.yank() {
    if (link >= 0) {
        MDV_model.Link target = layout.links[link];
        requests.push(Request.Copy(target.href));
        message = "yanked " + target.href;
        return;
    }
    for (int index in top .. layout.rows.size()) {
        int block = layout.rows[index].block;
        if (block >= 0 && layout.blocks[block].size() > 0) {
            requests.push(Request.Copy(layout.blocks[block]));
            message = "yanked " + str(layout.blocks[block].chars().size()) + " characters";
            return;
        }
    }
    message = "nothing to yank";
}

TUI_app.Action Viewer.search_key(term.Key key, str key_name) {
    if (key_name == "esc" || key_name == "ctrl-c") {
        mode = Mode.Normal;
        query = "";
        return TUI_app.Action.Redraw;
    }
    if (key_name == "enter") {
        commit_search();
        return TUI_app.Action.Redraw;
    }
    if (key_name == "backspace") {
        List<int> chars = query.chars();
        if (chars.size() == 0) {
            mode = Mode.Normal;
        } else {
            chars.pop();
            query = str.from_chars(chars);
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "ctrl-u") {
        query = "";
        return TUI_app.Action.Redraw;
    }
    int value = MDV_keys.char_of(key);
    if (value >= 0) {
        query = query + str.from_chars([value]);
    }
    return TUI_app.Action.Redraw;
}

TUI_app.Action Viewer.help_key(str key_name) {
    if (key_name == "j" || key_name == "down" || key_name == "enter") {
        help_top = help_top + 1;
    } else if (key_name == "k" || key_name == "up") {
        if (help_top > 0) {
            help_top = help_top - 1;
        }
    } else if (key_name == "ctrl-d" || key_name == "pgdn" || key_name == "space") {
        help_top = help_top + height() / 2;
    } else if (key_name == "ctrl-u" || key_name == "pgup") {
        help_top = help_top - height() / 2;
        if (help_top < 0) {
            help_top = 0;
        }
    } else if (key_name == "ctrl-c") {
        return TUI_app.Action.Quit;
    } else {
        mode = Mode.Normal;
        help_top = 0;
    }
    return TUI_app.Action.Redraw;
}

/// Open the next (step 1) or previous (-1) file of the set.
void Viewer.step_file(int step) {
    match (files.index_of(name)) {
        case Some(int slot): {
            int target = slot + step;
            if (target < 0 || target >= files.size()) {
                message = "no more files";
                return;
            }
            push_here();
            pending_anchor = "";
            ask_open(files[target]);
        }
        case None: {
            message = "not one of several files";
        }
    }
}

/// The two-key commands: `pending` is the first key, `key_name` the second.
TUI_app.Action Viewer.sequence(str first, str key_name) {
    if (first == "g" && key_name == "g") {
        if (count > 0) {
            scroll_to(take() - 1);
        } else {
            scroll_to(0);
        }
    } else if (first == "]" && key_name == "]") {
        heading(1, take());
    } else if (first == "[" && key_name == "[") {
        heading(-1, take());
    } else {
        count = 0;
    }
    return TUI_app.Action.Redraw;
}

TUI_app.Action Viewer.normal_key(str key_name) {
    if (pending.size() > 0) {
        str first = pending;
        pending = "";
        return sequence(first, key_name);
    }
    if (key_name.size() == 1 && key_name.byte_at(0) >= '0' && key_name.byte_at(0) <= '9' && (count > 0 || key_name != "0")) {
        count = count * 10 + (key_name.byte_at(0) - '0');
        if (count > 1000000) {
            count = 1000000;
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "q" || key_name == "ctrl-c") {
        return TUI_app.Action.Quit;
    }
    if (key_name == "j" || key_name == "down" || key_name == "ctrl-n" || (key_name == "enter" && link < 0)) {
        scroll_to(top + take());
    } else if (key_name == "k" || key_name == "up" || key_name == "ctrl-p") {
        scroll_to(top - take());
    } else if (key_name == "ctrl-d") {
        half_page(1);
    } else if (key_name == "ctrl-u") {
        half_page(-1);
    } else if (key_name == "ctrl-f" || key_name == "pgdn" || key_name == "space") {
        page(1);
    } else if (key_name == "ctrl-b" || key_name == "pgup") {
        page(-1);
    } else if (key_name == "G" || key_name == "end") {
        if (count > 0) {
            scroll_to(take() - 1);
        } else {
            scroll_to(max_top());
        }
    } else if (key_name == "home") {
        scroll_to(0);
    } else if (key_name == "g" || key_name == "]" || key_name == "[") {
        pending = key_name;
    } else if (key_name == "/") {
        mode = Mode.Search;
        query = "";
        count = 0;
    } else if (key_name == "n") {
        go_to_hit_after(take(), 1);
    } else if (key_name == "N") {
        go_to_hit_after(take(), -1);
    } else if (key_name == "o") {
        count = 0;
        open_outline();
    } else if (key_name == "b") {
        toggle_side();
        count = 0;
    } else if (key_name == "e") {
        set_pane(Pane.Live);
        count = 0;
    } else if (key_name == "t") {
        new_theme = "next";
        count = 0;
    } else if (key_name == "tab") {
        next_link(1);
        count = 0;
    } else if (key_name == "backtab") {
        next_link(-1);
        count = 0;
    } else if (key_name == "enter") {
        follow(layout.links[link].href);
        count = 0;
    } else if (key_name == "ctrl-o" || key_name == "backspace" || key_name == "ctrl-h") {
        go_back();
        count = 0;
    } else if (key_name == "r") {
        requests.push(Request.Reload);
        count = 0;
    } else if (key_name == "y") {
        yank();
        count = 0;
    } else if (key_name == "?") {
        mode = Mode.Help;
        help_top = 0;
        count = 0;
    } else if (key_name == ">") {
        step_file(1);
        count = 0;
    } else if (key_name == "<") {
        step_file(-1);
        count = 0;
    } else if (key_name == "esc") {
        count = 0;
        link = -1;
        needle = "";
        find_hits();
    } else {
        count = 0;
    }
    return TUI_app.Action.Redraw;
}

void Viewer.go_to_hit_after(int times, int step) {
    if (needle.size() == 0) {
        message = "no previous search";
        return;
    }
    if (hits.size() == 0) {
        message = "pattern not found: " + needle;
        return;
    }
    int target = hit;
    if (target < 0) {
        target = first_hit_from_top() - step;
    }
    go_to_hit(target + step * times);
}

/// One key.
pub TUI_app.Action Viewer.key(term.Key pressed) {
    message = "";
    str key_name = MDV_keys.name_of(pressed);
    match (mode) {
        case Search: {
            return search_key(pressed, key_name);
        }
        case Outline: {
            return outline_key(key_name);
        }
        case Help: {
            return help_key(key_name);
        }
        case Find: {
            return find_key(pressed, key_name);
        }
        case Palette: {
            return palette_key(pressed, key_name);
        }
        case Prompt: {
            return prompt_key(pressed, key_name);
        }
        case Normal: {
            Option<TUI_app.Action> global = global_key(pressed, key_name);
            match (global) {
                case Some(TUI_app.Action done): {
                    return done;
                }
                case None: {
                }
            }
            if (is_editing()) {
                return edit_key(pressed, key_name);
            }
            return normal_key(key_name);
        }
    }
}

/// Type `keys` (see `MDV_keys.key_of`), for a test: the last action answered.
pub TUI_app.Action Viewer.press(List<str> keys) {
    TUI_app.Action last = TUI_app.Action.Continue;
    for (str each in keys) {
        last = key(MDV_keys.key_of(each));
    }
    return last;
}

/// Show or hide the sidebar and lay the text out again for what is left.
pub void Viewer.toggle_side() {
    is_side_open = !is_side_open;
    relayout();
}

/// The heading whose section the row `row` is in: the last heading at or
/// above it, -1 before the first.
pub int Viewer.heading_at(int row) {
    int found = -1;
    for (int index in 0 .. layout.headings.size()) {
        if (layout.headings[index].row <= row) {
            found = index;
        }
    }
    return found;
}

/// The headings above the top of the window, outermost first: where the
/// reader is, as the header's breadcrumb shows it.
pub List<str> Viewer.crumbs() {
    List<str> out = [];
    List<int> levels = [];
    int current = heading_at(top);
    if (current < 0) {
        return out;
    }
    int index = current;
    int limit = 7;
    while (index >= 0) {
        MDV_model.Heading head = layout.headings[index];
        if (head.level < limit) {
            out.insert(0, head.text);
            levels.insert(0, head.level);
            limit = head.level;
        }
        index = index - 1;
    }
    return out;
}

/// The span under column `x` of layout row `at_row`, if any.
pub Option<MDV_model.Span> Viewer.span_at(int at_row, int x) {
    if (at_row < 0 || at_row >= layout.rows.size()) {
        return Option<MDV_model.Span>.None;
    }
    int column = left();
    for (MDV_model.Span span in layout.rows[at_row].spans) {
        int wide = TUI_text.width(span.text);
        if (x >= column && x < column + wide) {
            return Option<MDV_model.Span>.Some(span);
        }
        column = column + wide;
    }
    return Option<MDV_model.Span>.None;
}

/// The link under the cell at column `x` of document row `row`, -1 for none.
pub int Viewer.link_at(int at_row, int x) {
    match (span_at(at_row, x)) {
        case Some(MDV_model.Span span): {
            if (span.link >= 0 && span.has_bits(MDV_model.LINK)) {
                return span.link;
            }
            return -1;
        }
        case None: {
            return -1;
        }
    }
}

void Viewer.click_link(int target) {
    str href = layout.links[target].href;
    link = target;
    if (is_external(href)) {
        requests.push(Request.OpenUrl(href));
        message = "opening " + href;
        return;
    }
    follow(href);
}

void Viewer.drag_to(int y) {
    int track = height();
    if (track < 2 || max_top() == 0) {
        return;
    }
    int along = y - top_rows();
    if (along < 0) {
        along = 0;
    }
    if (along > track - 1) {
        along = track - 1;
    }
    scroll_to(along * max_top() / (track - 1));
}

/// A click on a rendered row (Preview, or a rendered block in Live): a task
/// box ticks, a link follows when it should, anything else is for the caret.
bool Viewer.did_click_rendered(int at_row, int x, bool is_ctrl) {
    match (span_at(at_row, x)) {
        case Some(MDV_model.Span span): {
            if (span.has_bits(MDV_model.TASK) && span.has_bits(MDV_model.DECO)) {
                toggle_task(layout.rows[at_row].line);
                if (message.size() == 0) {
                    message = "toggled; Ctrl-S saves";
                }
                return true;
            }
            if (span.link >= 0 && span.has_bits(MDV_model.LINK) && (!is_editing() || is_ctrl)) {
                click_link(span.link);
                return true;
            }
        }
        case None: {
        }
    }
    return false;
}

/// A left click on text row `at_row` of an editing pane.
void Viewer.editing_click(int at_row, int x, term.Mouse report) {
    MDV_model.Row each = layout.rows[at_row];
    bool is_shift = (report.mods & term.SHIFT) != 0;
    bool is_ctrl = (report.mods & term.CTRL) != 0;
    int old_row = buffer.caret.row;
    int old_lines = buffer.lines.size();
    if (each.spans.size() > 0 && each.spans[0].has_bits(MDV_model.RAW)) {
        MDV_edit.Pos spot = position_at(at_row, x);
        if (click_count >= 3) {
            buffer.select_line(spot);
        } else if (click_count == 2) {
            buffer.select_word(spot);
        } else {
            buffer.place(spot, is_shift);
        }
        is_selecting = true;
    } else if (!did_click_rendered(at_row, x, is_ctrl)) {
        if (each.line > 0) {
            buffer.place(position_at(at_row, x), false);
        }
    }
    after(old_row, old_lines, false);
}

/// Where a menu click lands on the palette: run the row under it, or close
/// the palette when the click is outside the box.
TUI_app.Action Viewer.palette_click(int x, int y) {
    if (x < palette_x0 || x >= palette_x1) {
        mode = Mode.Normal;
        return TUI_app.Action.Redraw;
    }
    int slot = y - palette_y;
    List<MDV_actions.Action> items = palette_items();
    if (slot >= 0 && slot < palette_rows && palette_first + slot < items.size()) {
        mode = Mode.Normal;
        return run_action(items[palette_first + slot].id);
    }
    return TUI_app.Action.Redraw;
}

/// One mouse report (1-based `col` and `row`): the wheel scrolls, a click in
/// the header or the toolbar presses a button, in the sidebar jumps to a
/// heading, on the scrollbar moves the window, on text follows a link (Preview)
/// or places the caret (the editing panes); a drag selects; motion shows the
/// link under the pointer.
pub TUI_app.Action Viewer.mouse(term.Mouse report) {
    int x = report.col - 1;
    int y = report.row - 1;
    message = "";
    bool is_palette = is_palette_open();
    match (report.kind) {
        case ScrollUp: {
            if (!is_palette) {
                scroll_to(top - 3);
            }
            return TUI_app.Action.Redraw;
        }
        case ScrollDown: {
            if (!is_palette) {
                scroll_to(top + 3);
            }
            return TUI_app.Action.Redraw;
        }
        case Down(int button): {
            if (button != 0) {
                return TUI_app.Action.Continue;
            }
            if (is_palette) {
                return palette_click(x, y);
            }
            if (y == 0) {
                for (Button each in buttons) {
                    if (x >= each.first && x < each.stop) {
                        return run_action(each.action);
                    }
                }
                return TUI_app.Action.Redraw;
            }
            if (is_editing() && y == 1) {
                for (Button each in tools) {
                    if (x >= each.first && x < each.stop) {
                        return run_action(each.action);
                    }
                }
                return TUI_app.Action.Redraw;
            }
            int content_row = y - top_rows();
            if (content_row < 0 || content_row >= height()) {
                return TUI_app.Action.Redraw;
            }
            if (x == columns - 1) {
                is_dragging = true;
                drag_to(y);
                return TUI_app.Action.Redraw;
            }
            if (x < side_width()) {
                int index = side_top + content_row;
                if (index >= 0 && index < layout.headings.size()) {
                    back.push(place_here());
                    scroll_to(layout.headings[index].row);
                    if (is_editing()) {
                        buffer.place(MDV_edit.Pos(layout.headings[index].line - 1, 0), false);
                        after(buffer.caret.row, buffer.lines.size(), false);
                    }
                }
                return TUI_app.Action.Redraw;
            }
            int at_row = top + content_row;
            if (at_row >= layout.rows.size()) {
                return TUI_app.Action.Redraw;
            }
            if (is_editing()) {
                editing_click(at_row, x, report);
                return TUI_app.Action.Redraw;
            }
            if (!did_click_rendered(at_row, x, true)) {
                int target = link_at(at_row, x);
                if (target >= 0) {
                    click_link(target);
                }
            }
            return TUI_app.Action.Redraw;
        }
        case Drag(int dragged): {
            if (is_dragging) {
                drag_to(y);
                return TUI_app.Action.Redraw;
            }
            if (is_selecting && is_editing()) {
                int content_row = y - top_rows();
                if (content_row < 0) {
                    scroll_to(top - 1);
                    content_row = 0;
                } else if (content_row >= height()) {
                    scroll_to(top + 1);
                    content_row = height() - 1;
                }
                int at_row = top + content_row;
                if (at_row >= layout.rows.size()) {
                    at_row = layout.rows.size() - 1;
                }
                if (at_row >= 0 && layout.rows[at_row].line > 0) {
                    int old_row = buffer.caret.row;
                    int old_lines = buffer.lines.size();
                    buffer.place(position_at(at_row, x), true);
                    // Dragging must not align a table or change the layout
                    // under the pointer.
                    reveal_caret();
                }
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Up(int released): {
            is_dragging = false;
            if (is_selecting) {
                is_selecting = false;
                after(buffer.caret.row, buffer.lines.size(), false);
            }
            return TUI_app.Action.Continue;
        }
        case Moved: {
            int over = -1;
            int content_row = y - top_rows();
            if (content_row >= 0 && content_row < height() && x >= side_width() && x < columns - 1) {
                over = link_at(top + content_row, x);
            }
            if (over != hover_link) {
                hover_link = over;
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case ScrollLeft: {
            return TUI_app.Action.Continue;
        }
        case ScrollRight: {
            return TUI_app.Action.Continue;
        }
    }
}

bool Viewer.is_palette_open() {
    match (mode) {
        case Palette: {
            return true;
        }
        case Normal: {
            return false;
        }
        case Search: {
            return false;
        }
        case Outline: {
            return false;
        }
        case Help: {
            return false;
        }
        case Find: {
            return false;
        }
        case Prompt: {
            return false;
        }
    }
}

/// Show `target`, keeping the place: the line at the top of the window stays
/// there, and the caret starts on it when editing begins.
pub void Viewer.set_pane(Pane target) {
    int line = 1;
    match (pane) {
        case Preview: {
            line = line_here();
        }
        case Source: {
            line = buffer.caret.row + 1;
            if (line_here() > 0) {
                line = line_here();
            }
        }
        case Live: {
            line = buffer.caret.row + 1;
            if (line_here() > 0) {
                line = line_here();
            }
        }
    }
    bool was_editing = is_editing();
    if (is_doc_old) {
        is_doc_stale = true;
    }
    pane = target;
    mode = Mode.Normal;
    if (is_editing() && !was_editing) {
        buffer.caret = buffer.clamp(MDV_edit.Pos(line - 1, 0));
        buffer.has_anchor = false;
    }
    if (!is_editing() && was_editing) {
        line = buffer.caret.row + 1;
    }
    layout = build_layout();
    link = -1;
    find_hits();
    scroll_to(layout.row_of_line(line));
    if (is_editing()) {
        reveal_caret();
    }
}

/// The index of the layout row the caret is on, -1 when none shows it.
pub int Viewer.caret_row() {
    int wanted = buffer.caret.row + 1;
    int found = -1;
    for (int at_row in 0 .. layout.rows.size()) {
        MDV_model.Row each = layout.rows[at_row];
        if (each.line != wanted || each.spans.size() == 0 || !each.spans[0].has_bits(MDV_model.RAW)) {
            continue;
        }
        int size = each.spans[0].text.size();
        if (buffer.caret.col >= each.col && buffer.caret.col < each.col + size) {
            return at_row;
        }
        found = at_row;
    }
    return found;
}

/// Scroll just enough to show the caret.
pub void Viewer.reveal_caret() {
    int at_row = caret_row();
    if (at_row < 0) {
        return;
    }
    if (at_row < top) {
        scroll_to(at_row);
    } else if (at_row >= top + height()) {
        scroll_to(at_row - height() + 1);
    }
}

/// The buffer position under column `x` of layout row `at_row`.
pub MDV_edit.Pos Viewer.position_at(int at_row, int x) {
    MDV_model.Row each = layout.rows[at_row];
    if (each.line <= 0) {
        return buffer.caret;
    }
    int line_index = each.line - 1;
    if (line_index >= buffer.lines.size()) {
        line_index = buffer.lines.size() - 1;
    }
    if (each.spans.size() > 0 && each.spans[0].has_bits(MDV_model.RAW)) {
        str piece = each.spans[0].text;
        int relative = x - left();
        if (relative < 0) {
            relative = 0;
        }
        int found = MDV_edit.col_for_width(piece, relative);
        str whole = buffer.lines[line_index];
        // Past the end of a wrapped piece is its last character, not the
        // start of the next piece.
        if (found >= piece.size() && each.col + piece.size() < whole.size() && piece.size() > 0) {
            found = MDV_edit.previous_col(piece, found);
        }
        return MDV_edit.Pos(line_index, each.col + found);
    }
    return MDV_edit.Pos(line_index, 0);
}

/// The last source line (0-based) of the Live block that holds `line`.
int Viewer.block_last_line(int line) {
    int found = MDV_live.block_at(live, line);
    if (found < 0) {
        return line;
    }
    return live.lasts[found];
}

/// Move the caret by `delta` screen rows, keeping its column.
void Viewer.move_rows(int delta, bool is_extend) {
    buffer.seal();
    int current = caret_row();
    if (current < 0) {
        current = layout.row_of_line(buffer.caret.row + 1);
    }
    int keep = buffer.want;
    if (keep < 0) {
        MDV_model.Row here = layout.rows[current];
        keep = MDV_edit.display_col(buffer.lines[buffer.caret.row], buffer.caret.col);
        if (here.spans.size() > 0 && here.spans[0].has_bits(MDV_model.RAW)) {
            keep = keep - MDV_edit.display_col(buffer.lines[buffer.caret.row], here.col);
        }
    }
    int target = current + delta;
    if (target < 0) {
        buffer.place(MDV_edit.Pos(0, 0), is_extend);
        buffer.want = -1;
        return;
    }
    if (target >= layout.rows.size()) {
        int last = buffer.lines.size() - 1;
        buffer.place(MDV_edit.Pos(last, buffer.lines[last].size()), is_extend);
        buffer.want = -1;
        return;
    }
    // A row with no line (a gap) is stepped over.
    int step = 1;
    if (delta < 0) {
        step = -1;
    }
    while (target >= 0 && target < layout.rows.size() && layout.rows[target].line <= 0) {
        target = target + step;
    }
    if (target < 0 || target >= layout.rows.size()) {
        return;
    }
    MDV_model.Row there = layout.rows[target];
    MDV_edit.Pos spot = MDV_edit.Pos(there.line - 1, 0);
    if (there.spans.size() > 0 && there.spans[0].has_bits(MDV_model.RAW)) {
        str piece = there.spans[0].text;
        int found = MDV_edit.col_for_width(piece, keep);
        str whole = buffer.lines[there.line - 1];
        if (found >= piece.size() && there.col + piece.size() < whole.size() && piece.size() > 0) {
            found = MDV_edit.previous_col(piece, found);
        }
        spot = MDV_edit.Pos(there.line - 1, there.col + found);
    } else if (delta < 0) {
        spot = MDV_edit.Pos(block_last_line(there.line - 1), 0);
    }
    buffer.place(spot, is_extend);
    buffer.want = keep;
}

/// The markdown classes of every byte of source line `line_index`, found
/// lazily and kept until a splice above it.
pub List<int> Viewer.line_classes(int line_index) {
    if (line_index < 0 || line_index >= buffer.lines.size()) {
        return [];
    }
    while (hl_valid <= line_index && hl_valid < buffer.lines.size()) {
        int state = 0;
        if (hl_valid > 0) {
            state = hl_states[hl_valid - 1];
        }
        TUI_syntax.Tokens tokens = TUI_syntax.classify("markdown", buffer.lines[hl_valid], state);
        if (hl_classes.size() > hl_valid) {
            hl_classes[hl_valid] = tokens.classes;
            hl_states[hl_valid] = tokens.state;
        } else {
            hl_classes.push(tokens.classes);
            hl_states.push(tokens.state);
        }
        hl_valid = hl_valid + 1;
    }
    return hl_classes[line_index];
}

/// How many words the text has (cached per revision).
pub int Viewer.words() {
    if (words_revision == buffer.revision && words_count > 0) {
        return words_count;
    }
    int total = 0;
    for (str line in buffer.lines) {
        bool is_in = false;
        for (int index in 0 .. line.size()) {
            int value = line.byte_at(index);
            bool is_space = value == ' ' || value == '\t';
            if (!is_space && !is_in) {
                total = total + 1;
            }
            is_in = !is_space;
        }
    }
    words_revision = buffer.revision;
    words_count = total;
    return total;
}

/// Bring everything that depends on the text up to date after a command that
/// may have changed it or moved the caret. `old_row` and `old_lines` are what
/// they were before; `is_forced` says the change may reach across blocks.
void Viewer.after(int old_row, int old_lines, bool is_forced) {
    if (old_row != buffer.caret.row && old_row < buffer.lines.size()) {
        List<int> was = MDV_assist.table_range(buffer, old_row);
        if (was.size() == 2) {
            MDV_assist.table_align(buffer, old_row);
            buffer.seal();
        }
    }
    int dirty = buffer.dirty_from;
    bool is_changed = dirty < 1000000000;
    if (is_changed) {
        buffer.dirty_from = 1000000000;
        if (hl_valid > dirty) {
            hl_valid = dirty;
        }
        is_doc_old = true;
        if (is_forced || buffer.lines.size() != old_lines || !is_live()) {
            is_doc_stale = true;
        }
        if (finder.needle.size() > 0) {
            finder.search(buffer.lines);
        }
    }
    bool is_moved_block = is_live() && MDV_live.block_at(live, buffer.caret.row) != live_active;
    if (is_moved_block && is_doc_old) {
        is_doc_stale = true;
    }
    if (is_changed || is_moved_block) {
        layout = build_layout();
        if (needle.size() > 0) {
            find_hits();
        }
    }
    if (top > max_top()) {
        top = max_top();
    }
    reveal_caret();
}

bool Viewer.needs_editing() {
    if (is_editing()) {
        return true;
    }
    message = "switch to Source or Live to edit (Alt-S, Alt-L)";
    return false;
}

str Viewer.copy_text() {
    if (buffer.has_selection()) {
        return buffer.selected_text();
    }
    return buffer.lines[buffer.caret.row] + "\n";
}

/// Run command `id` (see `MDV_actions`).
pub TUI_app.Action Viewer.run_action(int id) {
    int old_row = buffer.caret.row;
    int old_lines = buffer.lines.size();
    if (id == MDV_actions.PREVIEW) {
        set_pane(Pane.Preview);
    } else if (id == MDV_actions.SOURCE) {
        set_pane(Pane.Source);
    } else if (id == MDV_actions.LIVE) {
        set_pane(Pane.Live);
    } else if (id == MDV_actions.CYCLE_PANE) {
        match (pane) {
            case Preview: {
                set_pane(Pane.Live);
            }
            case Live: {
                set_pane(Pane.Source);
            }
            case Source: {
                set_pane(Pane.Preview);
            }
        }
    } else if (id == MDV_actions.SAVE) {
        save();
    } else if (id == MDV_actions.SAVE_AS) {
        mode = Mode.Prompt;
        prompt_kind = "saveas";
        prompt_text = "";
        is_quit_after_save = false;
    } else if (id == MDV_actions.RELOAD) {
        if (buffer.is_dirty()) {
            mode = Mode.Prompt;
            prompt_kind = "discard-reload";
        } else {
            requests.push(Request.Reload);
        }
    } else if (id == MDV_actions.QUIT) {
        return quit_action();
    } else if (id == MDV_actions.FIND) {
        open_find(false);
    } else if (id == MDV_actions.REPLACE) {
        if (!is_editing()) {
            set_pane(Pane.Live);
        }
        open_find(true);
    } else if (id == MDV_actions.FIND_NEXT) {
        step_match(1);
    } else if (id == MDV_actions.FIND_PREVIOUS) {
        step_match(-1);
    } else if (id == MDV_actions.GO_TO_HEADING) {
        open_outline();
    } else if (id == MDV_actions.PALETTE) {
        mode = Mode.Palette;
        query = "";
        palette_pick = 0;
    } else if (id == MDV_actions.CHOOSE_THEME) {
        mode = Mode.Palette;
        query = "Theme: ";
        palette_pick = 0;
    } else if (id == MDV_actions.SIDEBAR) {
        toggle_side();
    } else if (id == MDV_actions.NEXT_THEME) {
        new_theme = "next";
    } else if (id >= MDV_actions.THEME_BASE) {
        List<str> themes = MDV_theme.names();
        if (id - MDV_actions.THEME_BASE < themes.size()) {
            new_theme = themes[id - MDV_actions.THEME_BASE];
        }
    } else if (id == MDV_actions.TOGGLE_SMART) {
        is_smart = !is_smart;
        message = "smart typography " + on_off(is_smart);
    } else if (id == MDV_actions.TOGGLE_ZEBRA) {
        is_zebra = !is_zebra;
        relayout();
    } else if (id == MDV_actions.TOGGLE_NUMBERS) {
        has_numbers = !has_numbers;
        relayout();
    } else if (id == MDV_actions.HELP) {
        mode = Mode.Help;
        help_top = 0;
    } else if ((id == MDV_actions.UNDO || id == MDV_actions.REDO) && !is_editing()) {
        // A tick in Preview is an edit too.
        bool did_step = false;
        if (id == MDV_actions.UNDO) {
            did_step = buffer.did_undo();
        } else {
            did_step = buffer.did_redo();
        }
        if (did_step) {
            is_doc_stale = true;
            int keep = top;
            layout = build_layout();
            scroll_to(keep);
        }
        return TUI_app.Action.Redraw;
    } else if (!needs_editing()) {
        return TUI_app.Action.Redraw;
    } else {
        edit_action(id);
    }
    if (is_editing()) {
        after(old_row, old_lines, true);
    }
    return TUI_app.Action.Redraw;
}

/// The editing commands: the ones that change the text.
void Viewer.edit_action(int id) {
    if (id == MDV_actions.UNDO) {
        if (!buffer.did_undo()) {
            message = "nothing to undo";
        }
    } else if (id == MDV_actions.REDO) {
        if (!buffer.did_redo()) {
            message = "nothing to redo";
        }
    } else if (id == MDV_actions.CUT) {
        cut();
    } else if (id == MDV_actions.COPY) {
        copy();
    } else if (id == MDV_actions.PASTE) {
        requests.push(Request.Paste);
    } else if (id == MDV_actions.SELECT_ALL) {
        buffer.select_all();
    } else if (id == MDV_actions.BOLD) {
        MDV_assist.toggle_inline(buffer, "**");
    } else if (id == MDV_actions.ITALIC) {
        MDV_assist.toggle_inline(buffer, "*");
    } else if (id == MDV_actions.STRIKE) {
        MDV_assist.toggle_inline(buffer, "~~");
    } else if (id == MDV_actions.CODE) {
        MDV_assist.toggle_inline(buffer, "`");
    } else if (id == MDV_actions.LINK) {
        MDV_assist.insert_link(buffer, false);
    } else if (id == MDV_actions.IMAGE) {
        MDV_assist.insert_link(buffer, true);
    } else if (id >= MDV_actions.HEADING_1 && id <= MDV_actions.HEADING_6) {
        MDV_assist.set_heading(buffer, id - MDV_actions.HEADING_1 + 1);
    } else if (id == MDV_actions.BULLETS) {
        MDV_assist.toggle_prefix(buffer, "bullet");
    } else if (id == MDV_actions.NUMBERS) {
        MDV_assist.toggle_prefix(buffer, "number");
    } else if (id == MDV_actions.TASKS) {
        MDV_assist.toggle_prefix(buffer, "task");
    } else if (id == MDV_actions.QUOTE) {
        MDV_assist.toggle_prefix(buffer, "quote");
    } else if (id == MDV_actions.TABLE) {
        MDV_assist.insert_table(buffer);
    } else if (id == MDV_actions.CODE_BLOCK) {
        MDV_assist.insert_code_block(buffer);
    } else if (id == MDV_actions.RULE) {
        MDV_assist.insert_rule(buffer);
    } else if (id == MDV_actions.ALIGN_TABLE) {
        MDV_assist.table_align(buffer, buffer.caret.row);
        buffer.seal();
    }
}

void Viewer.copy() {
    str text = copy_text();
    clipboard = text;
    requests.push(Request.Copy(text));
    message = "copied " + str(text.chars().size()) + " characters";
}

void Viewer.cut() {
    str text = copy_text();
    clipboard = text;
    requests.push(Request.Copy(text));
    buffer.begin("cut");
    if (buffer.has_selection()) {
        bool did_ignore = buffer.did_delete_selection();
    } else {
        int row_here = buffer.caret.row;
        MDV_edit.Pos from = MDV_edit.Pos(row_here, 0);
        MDV_edit.Pos upto = MDV_edit.Pos(row_here + 1, 0);
        if (row_here + 1 >= buffer.lines.size()) {
            upto = MDV_edit.Pos(row_here, buffer.lines[row_here].size());
            if (row_here > 0) {
                from = MDV_edit.Pos(row_here - 1, buffer.lines[row_here - 1].size());
            }
        }
        MDV_edit.Pos finish = buffer.splice(from, upto, "");
        buffer.caret = buffer.clamp(MDV_edit.Pos(from.row, 0));
        if (row_here + 1 >= buffer.lines.size() && row_here > 0) {
            buffer.caret = buffer.clamp(MDV_edit.Pos(row_here - 1, 0));
        }
    }
    buffer.finish();
    buffer.seal();
    message = "cut " + str(text.chars().size()) + " characters";
}

/// Text arrived from the clipboard or as a bracketed paste. `kind` is
/// "image" or "file" when it is a path to one, else "".
pub void Viewer.paste_text(str text, str kind) {
    match (mode) {
        case Find: {
            add_to_find(text.split("\n")[0]);
            return;
        }
        case Palette: {
            query = query + text.split("\n")[0];
            palette_pick = 0;
            return;
        }
        case Prompt: {
            prompt_text = prompt_text + text.split("\n")[0];
            return;
        }
        case Normal: {
        }
        case Search: {
            query = query + text.split("\n")[0];
            return;
        }
        case Outline: {
            return;
        }
        case Help: {
            return;
        }
    }
    if (!is_editing()) {
        message = "switch to Source or Live to paste (Alt-S, Alt-L)";
        return;
    }
    int old_row = buffer.caret.row;
    int old_lines = buffer.lines.size();
    MDV_assist.paste(buffer, text, kind);
    buffer.seal();
    after(old_row, old_lines, true);
}

void Viewer.save() {
    if (name == "<stdin>" || name.size() == 0) {
        mode = Mode.Prompt;
        prompt_kind = "saveas";
        prompt_text = "";
        return;
    }
    requests.push(Request.Save(name, buffer.text()));
}

/// The file was written: the text is clean.
pub void Viewer.saved(str path) {
    name = path;
    buffer.mark_saved();
    message = "saved " + path;
    if (is_quit_after_save) {
        should_quit = true;
    }
    is_quit_after_save = false;
}

/// Writing the file failed.
pub void Viewer.save_failed(str why) {
    message = "could not save: " + why;
    is_quit_after_save = false;
}

/// The answer to a quit: leave, or ask first when there is work to lose.
pub TUI_app.Action Viewer.quit_action() {
    if (buffer.is_dirty()) {
        mode = Mode.Prompt;
        prompt_kind = "quit";
        return TUI_app.Action.Redraw;
    }
    return TUI_app.Action.Quit;
}

/// Open another file, after asking when the text has unsaved changes.
void Viewer.ask_open(str path) {
    if (buffer.is_dirty()) {
        pending_open = path;
        mode = Mode.Prompt;
        prompt_kind = "open";
        return;
    }
    requests.push(Request.Open(path));
}

/// The file changed on disk under unsaved edits.
pub void Viewer.disk_changed() {
    mode = Mode.Prompt;
    prompt_kind = "reload";
}

/// What the prompt shows on the status line.
pub str Viewer.prompt_line() {
    if (prompt_kind == "saveas") {
        return "Save as: " + prompt_text;
    }
    if (prompt_kind == "quit") {
        return "Unsaved changes: [S]ave and quit, [D]iscard and quit, Esc to stay";
    }
    if (prompt_kind == "open") {
        return "Unsaved changes: [D]iscard them and open " + pending_open + ", Esc to stay";
    }
    if (prompt_kind == "discard-reload") {
        return "Discard your changes and read the file again? [Y]es, Esc to keep them";
    }
    return "The file changed on disk: [R]eload it, [K]eep your version";
}

TUI_app.Action Viewer.prompt_key(term.Key pressed, str key_name) {
    if (key_name == "esc") {
        mode = Mode.Normal;
        if (prompt_kind == "open") {
            load_failed("");
            message = "staying";
        }
        prompt_kind = "";
        is_quit_after_save = false;
        return TUI_app.Action.Redraw;
    }
    if (prompt_kind == "saveas") {
        if (key_name == "enter") {
            mode = Mode.Normal;
            str target = prompt_text.trim();
            prompt_kind = "";
            if (target.size() > 0) {
                requests.push(Request.Save(target, buffer.text()));
            }
            return TUI_app.Action.Redraw;
        }
        if (key_name == "backspace") {
            List<int> chars = prompt_text.chars();
            if (chars.size() > 0) {
                chars.pop();
                prompt_text = str.from_chars(chars);
            }
            return TUI_app.Action.Redraw;
        }
        int value = MDV_keys.char_of(pressed);
        if (value > 0) {
            prompt_text = prompt_text + str.from_chars([value]);
        }
        return TUI_app.Action.Redraw;
    }
    str answer = key_name.to_lower();
    mode = Mode.Normal;
    str kind = prompt_kind;
    prompt_kind = "";
    if (kind == "quit") {
        if (answer == "s" || answer == "y") {
            is_quit_after_save = true;
            save();
            if (is_plain_mode() && !buffer.is_dirty()) {
                return TUI_app.Action.Quit;
            }
            return TUI_app.Action.Redraw;
        }
        if (answer == "d" || answer == "n") {
            return TUI_app.Action.Quit;
        }
        return TUI_app.Action.Redraw;
    }
    if (kind == "open") {
        if (answer == "d") {
            buffer.mark_saved();
            requests.push(Request.Open(pending_open));
        } else {
            load_failed("");
        }
        return TUI_app.Action.Redraw;
    }
    if (kind == "discard-reload" && (answer == "y" || answer == "d")) {
        requests.push(Request.Reload);
        return TUI_app.Action.Redraw;
    }
    if (kind == "reload" && answer == "r") {
        requests.push(Request.Reload);
        return TUI_app.Action.Redraw;
    }
    if (kind == "reload") {
        message = "keeping your version; save to overwrite the file";
    }
    return TUI_app.Action.Redraw;
}

pub List<MDV_actions.Action> Viewer.palette_items() {
    return MDV_actions.filter(query);
}

TUI_app.Action Viewer.palette_key(term.Key pressed, str key_name) {
    List<MDV_actions.Action> items = palette_items();
    if (key_name == "esc" || key_name == "ctrl-p" || key_name == "f1") {
        mode = Mode.Normal;
        return TUI_app.Action.Redraw;
    }
    if (key_name == "down" || key_name == "ctrl-n" || key_name == "tab") {
        if (items.size() > 0) {
            palette_pick = (palette_pick + 1) % items.size();
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "up" || key_name == "ctrl-p" || key_name == "backtab") {
        if (items.size() > 0) {
            palette_pick = (palette_pick + items.size() - 1) % items.size();
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "enter") {
        mode = Mode.Normal;
        if (palette_pick < items.size()) {
            return run_action(items[palette_pick].id);
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "backspace") {
        List<int> chars = query.chars();
        if (chars.size() > 0) {
            chars.pop();
            query = str.from_chars(chars);
        }
        palette_pick = 0;
        return TUI_app.Action.Redraw;
    }
    int value = MDV_keys.char_of(pressed);
    if (value > 0) {
        query = query + str.from_chars([value]);
        palette_pick = 0;
    }
    return TUI_app.Action.Redraw;
}

/// Open the find bar (with the replace row when `should_replace`), starting from
/// the selected word when there is one.
pub void Viewer.open_find(bool should_replace) {
    mode = Mode.Find;
    is_replace = should_replace;
    is_replace_focused = false;
    if (is_editing() && buffer.has_selection()) {
        str picked = buffer.selected_text();
        if (!picked.contains("\n") && picked.size() < 200) {
            finder.needle = picked;
        }
    } else if (finder.needle.size() == 0 && needle.size() > 0) {
        finder.needle = needle;
    }
    refind();
}

/// Search again for the finder's needle: the source matches and the hits
/// drawn on the layout.
void Viewer.refind() {
    finder.search(buffer.lines);
    needle = finder.needle;
    find_hits();
    if (needle.size() == 0) {
        return;
    }
    if (is_editing()) {
        int target = finder.first_from(buffer.sel_start());
        if (target >= 0) {
            go_match(target);
        }
    } else if (hits.size() > 0) {
        go_to_hit(first_hit_from_top());
    }
}

/// Select source match `target` and show it.
void Viewer.go_match(int target) {
    if (target < 0 || target >= finder.matches.size()) {
        return;
    }
    finder.current = target;
    MDV_find.Match found = finder.matches[target];
    buffer.select(MDV_edit.Pos(found.row, found.col), MDV_edit.Pos(found.row, found.col + found.length));
    int old_lines = buffer.lines.size();
    after(buffer.caret.row, old_lines, false);
}

/// Go to the next (step 1) or previous (-1) match.
void Viewer.step_match(int step) {
    if (finder.needle.size() == 0) {
        message = "nothing to find: Ctrl-F";
        return;
    }
    if (!is_editing()) {
        if (hits.size() == 0) {
            message = "pattern not found: " + needle;
            return;
        }
        go_to_hit_after(1, step);
        return;
    }
    if (finder.matches.size() == 0) {
        message = "pattern not found: " + finder.needle;
        return;
    }
    int target = 0;
    if (step > 0) {
        MDV_edit.Pos from = buffer.sel_end();
        if (!buffer.has_selection()) {
            from = buffer.caret;
        }
        target = finder.first_from(from);
        if (buffer.has_selection() && target >= 0 && finder.matches[target].row == buffer.sel_start().row && finder.matches[target].col == buffer.sel_start().col) {
            target = target + 1;
            if (target >= finder.matches.size()) {
                target = 0;
            }
        }
    } else {
        target = finder.last_before(buffer.sel_start());
    }
    go_match(target);
}

void Viewer.add_to_find(str text) {
    if (is_replace_focused) {
        finder.replacement = finder.replacement + text;
    } else {
        finder.needle = finder.needle + text;
        refind();
    }
}

TUI_app.Action Viewer.find_key(term.Key pressed, str key_name) {
    if (key_name == "esc") {
        mode = Mode.Normal;
        return TUI_app.Action.Redraw;
    }
    if (key_name == "enter" || key_name == "down" || key_name == "f3") {
        if (is_replace_focused && is_editing()) {
            replace_current();
        } else {
            step_match(1);
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "up" || key_name == "shift-f3" || key_name == "shift-enter") {
        step_match(-1);
        return TUI_app.Action.Redraw;
    }
    if (key_name == "tab" || key_name == "backtab") {
        if (is_replace) {
            is_replace_focused = !is_replace_focused;
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "ctrl-h" || key_name == "ctrl-r") {
        is_replace = !is_replace;
        is_replace_focused = is_replace;
        return TUI_app.Action.Redraw;
    }
    if (key_name == "alt-c") {
        finder.is_exact = !finder.is_exact;
        refind();
        return TUI_app.Action.Redraw;
    }
    if (key_name == "alt-a" || key_name == "ctrl-alt-enter") {
        replace_all();
        return TUI_app.Action.Redraw;
    }
    if (key_name == "ctrl-s") {
        save();
        return TUI_app.Action.Redraw;
    }
    if (key_name == "ctrl-u") {
        if (is_replace_focused) {
            finder.replacement = "";
        } else {
            finder.needle = "";
            refind();
        }
        return TUI_app.Action.Redraw;
    }
    if (key_name == "backspace") {
        if (is_replace_focused) {
            List<int> chars = finder.replacement.chars();
            if (chars.size() > 0) {
                chars.pop();
                finder.replacement = str.from_chars(chars);
            }
        } else {
            List<int> chars = finder.needle.chars();
            if (chars.size() > 0) {
                chars.pop();
                finder.needle = str.from_chars(chars);
            }
            refind();
        }
        return TUI_app.Action.Redraw;
    }
    int value = MDV_keys.char_of(pressed);
    if (value > 0) {
        add_to_find(str.from_chars([value]));
    }
    return TUI_app.Action.Redraw;
}

void Viewer.replace_current() {
    if (finder.matches.size() == 0) {
        message = "nothing to replace";
        return;
    }
    int target = finder.current;
    if (target < 0 || !buffer.has_selection()) {
        target = finder.first_from(buffer.sel_start());
    }
    int old_lines = buffer.lines.size();
    int old_row = buffer.caret.row;
    finder.replace_at(buffer, target);
    after(old_row, old_lines, true);
    finder.search(buffer.lines);
    step_match(1);
}

void Viewer.replace_all() {
    if (!is_editing()) {
        message = "switch to Source or Live to replace (Alt-S, Alt-L)";
        return;
    }
    int old_lines = buffer.lines.size();
    int old_row = buffer.caret.row;
    int done = finder.replace_all(buffer);
    after(old_row, old_lines, true);
    finder.search(buffer.lines);
    message = "replaced " + str(done);
}

/// The keys that mean the same in every pane (and the palette's `ctrl-p`).
Option<TUI_app.Action> Viewer.global_key(term.Key pressed, str key_name) {
    int id = 0;
    if (key_name == "ctrl-s") {
        id = MDV_actions.SAVE;
    } else if (key_name == "ctrl-p" || key_name == "f1") {
        id = MDV_actions.PALETTE;
    } else if (key_name == "ctrl-f") {
        id = MDV_actions.FIND;
    } else if (key_name == "ctrl-h" || key_name == "ctrl-r") {
        id = MDV_actions.REPLACE;
    } else if (key_name == "f2") {
        id = MDV_actions.CYCLE_PANE;
    } else if (key_name == "alt-p") {
        id = MDV_actions.PREVIEW;
    } else if (key_name == "alt-s") {
        id = MDV_actions.SOURCE;
    } else if (key_name == "alt-l") {
        id = MDV_actions.LIVE;
    } else if (key_name == "ctrl-q") {
        id = MDV_actions.QUIT;
    } else if ((key_name == "ctrl-z" || key_name == "ctrl-y") && !is_editing()) {
        id = MDV_actions.UNDO;
        if (key_name == "ctrl-y") {
            id = MDV_actions.REDO;
        }
    } else if (key_name == "ctrl-g") {
        id = MDV_actions.GO_TO_HEADING;
    } else if (key_name == "f3") {
        id = MDV_actions.FIND_NEXT;
    } else if (key_name == "shift-f3") {
        id = MDV_actions.FIND_PREVIOUS;
    } else if (key_name == "f5") {
        id = MDV_actions.RELOAD;
    } else if (key_name == "ctrl-\\") {
        id = MDV_actions.SIDEBAR;
    }
    if (id == 0) {
        return Option<TUI_app.Action>.None;
    }
    return Option<TUI_app.Action>.Some(run_action(id));
}

/// A key in Source or Live: type, move, or run a shortcut.
TUI_app.Action Viewer.edit_key(term.Key pressed, str key_name) {
    bool is_ctrl = pressed.has_modifiers(term.CTRL);
    bool is_alt = pressed.has_modifiers(term.ALT);
    bool is_shift = pressed.has_modifiers(term.SHIFT);
    int old_row = buffer.caret.row;
    int old_lines = buffer.lines.size();
    bool is_forced = false;
    match (pressed.code) {
        case Char(int value): {
            if (is_ctrl && !is_alt) {
                int id = ctrl_action(value);
                if (id > 0) {
                    return run_action(id);
                }
                if (value == 'w') {
                    buffer.delete_word_back();
                }
            } else if (is_alt) {
                int id = alt_action(value);
                if (id > 0) {
                    return run_action(id);
                }
                if (value == 'b') {
                    buffer.move(MDV_edit.Motion.WordLeft, is_shift);
                } else if (value == 'f') {
                    buffer.move(MDV_edit.Motion.WordRight, is_shift);
                }
            } else if (value >= 32 && value != 127) {
                MDV_assist.type_char(buffer, value, is_smart);
            }
        }
        case Enter: {
            MDV_assist.enter(buffer);
            buffer.seal();
        }
        case Tab: {
            MDV_assist.indent_lines(buffer, is_shift);
            buffer.seal();
        }
        case BackTab: {
            MDV_assist.indent_lines(buffer, true);
            buffer.seal();
        }
        case Backspace: {
            if (is_ctrl || is_alt) {
                buffer.delete_word_back();
            } else {
                MDV_assist.backspace(buffer);
            }
        }
        case Delete: {
            if (is_ctrl || is_alt) {
                buffer.delete_word_forward();
            } else {
                buffer.delete_forward();
            }
        }
        case Escape: {
            buffer.clear_selection();
            buffer.seal();
        }
        case Left: {
            if (is_ctrl || is_alt) {
                buffer.move(MDV_edit.Motion.WordLeft, is_shift);
            } else {
                buffer.move(MDV_edit.Motion.Left, is_shift);
            }
        }
        case Right: {
            if (is_ctrl || is_alt) {
                buffer.move(MDV_edit.Motion.WordRight, is_shift);
            } else {
                buffer.move(MDV_edit.Motion.Right, is_shift);
            }
        }
        case Up: {
            move_rows(-1, is_shift);
        }
        case Down: {
            move_rows(1, is_shift);
        }
        case Home: {
            if (is_ctrl) {
                buffer.move(MDV_edit.Motion.DocStart, is_shift);
            } else {
                buffer.move(MDV_edit.Motion.SmartHome, is_shift);
            }
        }
        case End: {
            if (is_ctrl) {
                buffer.move(MDV_edit.Motion.DocEnd, is_shift);
            } else {
                buffer.move(MDV_edit.Motion.LineEnd, is_shift);
            }
        }
        case PageUp: {
            move_rows(-height(), is_shift);
            scroll_to(top - height());
        }
        case PageDown: {
            move_rows(height(), is_shift);
            scroll_to(top + height());
        }
        case Insert: {
        }
        case F(int number): {
        }
    }
    after(old_row, old_lines, is_forced);
    return TUI_app.Action.Redraw;
}

/// Tick or untick the task item on source line `line_number` (1-based).
pub void Viewer.toggle_task(int line_number) {
    int line_index = line_number - 1;
    if (line_index < 0 || line_index >= buffer.lines.size()) {
        message = "could not find the checkbox";
        return;
    }
    str text = buffer.lines[line_index];
    MDV_assist.Item item = MDV_assist.parse_item(text);
    if (item.task == 0) {
        message = "could not find the checkbox";
        return;
    }
    int box = item.marker_end + 1;
    if (box + 2 >= text.size() || text.byte_at(box) != '[') {
        message = "could not find the checkbox";
        return;
    }
    int old_row = buffer.caret.row;
    int old_lines = buffer.lines.size();
    str mark = "x";
    if (item.task == 2) {
        mark = " ";
    }
    buffer.begin("task");
    MDV_edit.Pos finish = buffer.splice(MDV_edit.Pos(line_index, box + 1), MDV_edit.Pos(line_index, box + 2), mark);
    buffer.finish();
    buffer.seal();
    int keep = top;
    after(old_row, old_lines, true);
    if (!is_editing()) {
        layout = build_layout();
        scroll_to(keep);
    }
}

/// A viewer showing `text` (the contents of `name`) in a terminal of `columns` x
/// `rows`.
pub Viewer open(List<str> files, str name, str text, int columns, int rows) {
    MDV_model.Document doc = MDV_prepare.prepare(text);
    MDV_model.Layout layout = MDV_layout.layout(doc, text_width_for(columns));
    return Viewer(files, name, MDV_edit.Buffer.of(text), doc, layout, columns, rows);
}

/// The text width of a window of `columns` with the defaults.
pub int text_width_for(int columns) {
    int width = columns - 1 - 2 * MARGIN;
    if (width > MAX_TEXT_WIDTH) {
        width = MAX_TEXT_WIDTH;
    }
    if (width < MIN_TEXT_WIDTH) {
        width = MIN_TEXT_WIDTH;
    }
    return width;
}

// --- geometry -------------------------------------------------------------------

// --- places ---------------------------------------------------------------------

type Anchor {
    int block;
    int offset;
}

// --- the document ----------------------------------------------------------------

// --- search -------------------------------------------------------------------------

bool has_upper(str text) {
    for (int value in text.chars()) {
        if (value >= 'A' && value <= 'Z') {
            return true;
        }
    }
    return false;
}

// --- links -----------------------------------------------------------------------------

/// Does `href` name something other than a file or an anchor?
pub bool is_external(str href) {
    if (href.starts_with("//")) {
        return true;
    }
    int length = href.size();
    if (length > 40) {
        length = 40;
    }
    for (int index in 0 .. length) {
        int value = href.byte_at(index);
        if (value == ':') {
            return index >= 2;
        }
        bool is_letter = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z');
        bool is_other = (value >= '0' && value <= '9') || value == '+' || value == '-' || value == '.';
        if (!is_letter && !(index > 0 && is_other)) {
            return false;
        }
    }
    return false;
}

bool is_markdown_path(str path) {
    str lower = path.to_lower();
    return lower.ends_with(".md") || lower.ends_with(".markdown") || lower.ends_with(".mdown") || lower.ends_with(".txt");
}

/// The path a link in the file `base` means by `path`: relative to `base`'s
/// directory unless it is absolute.
pub str resolve(str base, str path) {
    if (path.starts_with("/")) {
        return path;
    }
    str rest = path;
    while (rest.starts_with("./")) {
        rest = rest.substr(2, rest.size());
    }
    int cut = -1;
    for (int index in 0 .. base.size()) {
        if (base.byte_at(index) == '/') {
            cut = index;
        }
    }
    if (cut < 0) {
        return rest;
    }
    return base.substr(0, cut + 1) + rest;
}

// --- the outline ----------------------------------------------------------------------------

type Cursor {
    int index;
}

List<TUI_outline.Node> outline_nodes(List<MDV_model.Heading> headings, Cursor cursor, int parent_level) {
    List<TUI_outline.Node> out = [];
    while (cursor.index < headings.size() && headings[cursor.index].level > parent_level) {
        MDV_model.Heading heading = headings[cursor.index];
        int id = cursor.index;
        cursor.index = cursor.index + 1;
        List<TUI_outline.Node> kids = outline_nodes(headings, cursor, heading.level);
        out.push(TUI_outline.Node.section(str(id), heading.text, kids));
    }
    return out;
}

// --- panes ------------------------------------------------------------------------------------

/// The pane's name as the status line shows it.
pub str pane_name(Pane value) {
    match (value) {
        case Preview: {
            return "Preview";
        }
        case Source: {
            return "Source";
        }
        case Live: {
            return "Live";
        }
    }
}

