// A `Viewer` on the screen.
//
// `Screen.render` is a `TUI_widget.Widget`: given a buffer it draws the rows
// the viewer's window shows, the status line, and whichever popup is open.
// It reads the viewer and changes nothing but the window height the viewer
// keeps (so a resize that arrives between two keys is seen).

import MDV_actions;
import MDV_caps;
import MDV_edit;
import MDV_cat;
import MDV_model;
import MDV_theme;
import MDV_viewer;
import tui.app.TUI_app;
import tui.app.TUI_diff;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_menu;
import tui.core.TUI_style;
import tui.core.TUI_text;
import tui.core.TUI_widget;

/// A stretch of the screen the cell buffer cannot describe on its own: a
/// scaled heading (OSC 66), drawn over the cells after the frame. (A link,
/// OSC 8, is a property of the cells and is marked with `Buffer.link`.)
type Region {
    int x;
    int y;
    int width;
    int scale;
    str text;
    int style;
}

pub type Screen {
    pub MDV_viewer.Viewer viewer;
    pub MDV_theme.Theme theme;
    pub MDV_caps.Caps caps = MDV_caps.bare();
    /// The loop the screen is shown by: the scaled headings (which are not
    /// cells) are queued on it to be written once the frame is.
    pub TUI_app.Loop loop = TUI_app.Loop();
    List<Region> regions = [];
    /// The layout row the caret is on this frame, -1 for none.
    int caret_index = -1;
}

/// `spans` of one row drawn at `x`, `y`: the search hits marked, and the
/// focused link reversed.
void Screen.draw_row(TUI_buffer.Buffer buffer, int x, int y, int row_index, MDV_model.Row row, int last_y) {
    List<MDV_viewer.Hit> row_hits = viewer.hits_between(row_index, row_index + 1);
    int column = x;
    // Byte offset into `row.content()`, which skips decoration.
    int offset = 0;
    bool is_big = row.big > 0 && y + 1 <= last_y;
    List<MDV_model.Span> drawn = row.spans;
    if (row.spans.size() > 0 && row.spans[0].has_bits(MDV_model.RAW)) {
        drawn = expand_source(row);
    }
    for (MDV_model.Span span in drawn) {
        TUI_style.Style base = MDV_theme.style_for(theme, span.style);
        if (span.link >= 0 && span.link == viewer.link) {
            base = MDV_theme.focus_style(theme, base);
        } else if (span.link >= 0 && span.link == viewer.hover_link) {
            base = base.with_attrs(base.attrs | TUI_style.BOLD);
        }
        if (is_big && span.has_bits(MDV_model.HEADING) && !span.has_bits(MDV_model.DECO)) {
            // The cells under a scaled heading hold a placeholder, so the diff
            // sees them change when the heading moves; the heading itself is
            // written over them after the frame.
            int wide = 2 * TUI_text.width(span.text);
            buffer.fill(TUI_geometry.Rect(column, y, wide, 2), "\u{2800}", base);
            regions.push(Region(column, y, wide, row.big, span.text, base.pack()));
            column = column + wide;
            continue;
        }
        int region_start = column;
        if (span.has_bits(MDV_model.DECO) || row_hits.size() == 0) {
            column = column + buffer.set_str(column, y, span.text, base);
            if (!span.has_bits(MDV_model.DECO)) {
                offset = offset + span.text.size();
            }
            note_link(buffer, span, region_start, column, y);
            continue;
        }
        // Cut the span wherever a hit starts or ends inside it.
        int length = span.text.size();
        int from = 0;
        while (from < length) {
            int upto = length;
            TUI_style.Style piece_style = base;
            bool is_inside = false;
            for (int index in 0 .. row_hits.size()) {
                MDV_viewer.Hit each = row_hits[index];
                int begin = each.start - offset;
                int finish = each.end - offset;
                if (begin <= from && finish > from) {
                    is_inside = true;
                    if (finish < upto) {
                        upto = finish;
                    }
                    bool is_current = viewer.hit >= 0 && viewer.hits[viewer.hit].row == row_index && viewer.hits[viewer.hit].start == each.start;
                    piece_style = MDV_theme.hit_style(theme, is_current);
                } else if (begin > from && begin < upto) {
                    upto = begin;
                }
            }
            if (!is_inside) {
                piece_style = base;
            }
            column = column + buffer.set_str(column, y, span.text.substr(from, upto), piece_style);
            from = upto;
        }
        offset = offset + length;
        note_link(buffer, span, region_start, column, y);
    }
    if (row_index == caret_index) {
        draw_caret(buffer, x, y, row);
    }
}

/// The text of a source row as spans: coloured by what markdown makes of the
/// byte, and the selected stretch marked.
List<MDV_model.Span> Screen.expand_source(MDV_model.Row row) {
    str text = row.spans[0].text;
    int line_index = row.line - 1;
    List<int> classes = viewer.line_classes(line_index);
    MDV_edit.Buffer text_buffer = viewer.buffer;
    int sel_from = -1;
    int sel_to = -1;
    bool has_newline = false;
    if (text_buffer.has_selection() && line_index < text_buffer.lines.size()) {
        MDV_edit.Pos first = text_buffer.sel_start();
        MDV_edit.Pos last = text_buffer.sel_end();
        if (line_index >= first.row && line_index <= last.row) {
            sel_from = 0;
            sel_to = text_buffer.lines[line_index].size();
            if (line_index == first.row) {
                sel_from = first.col;
            }
            if (line_index == last.row) {
                sel_to = last.col;
            }
            has_newline = line_index < last.row;
        }
    }
    List<MDV_model.Span> out = [];
    int run_start = 0;
    int run_style = -1;
    int size = text.size();
    for (int index in 0 .. size + 1) {
        int style = -1;
        if (index < size) {
            if ((text.byte_at(index) & 192) == 128) {
                continue;
            }
            int at_col = row.col + index;
            int class_value = 0;
            if (at_col < classes.size()) {
                class_value = classes[at_col];
            }
            style = MDV_model.RAW;
            if (class_value > 0) {
                style = style | MDV_model.syntax_style(class_value);
            }
            if (at_col >= sel_from && at_col < sel_to) {
                style = style | MDV_model.SELECTED;
            }
        }
        if (style != run_style) {
            if (run_style >= 0 && index > run_start) {
                out.push(MDV_model.Span(text.substr(run_start, index), style: run_style));
            }
            run_start = index;
            run_style = style;
        }
    }
    bool is_last_piece = row.col + size >= viewer.buffer.lines[line_index].size();
    if (has_newline && is_last_piece) {
        out.push(MDV_model.Span(" ", style: MDV_model.RAW | MDV_model.SELECTED));
    }
    if (out.size() == 0) {
        out.push(MDV_model.Span("", style: MDV_model.RAW));
    }
    return out;
}

/// The caret: the cell it is on, reversed (a space after the text at the end
/// of a line).
void Screen.draw_caret(TUI_buffer.Buffer buffer, int x, int y, MDV_model.Row row) {
    str text = row.spans[0].text;
    int relative = viewer.buffer.caret.col - row.col;
    if (relative < 0) {
        relative = 0;
    }
    if (relative > text.size()) {
        relative = text.size();
    }
    int caret_x = x + TUI_text.width(text.substr(0, relative));
    if (caret_x >= buffer.area().width) {
        return;
    }
    if (relative >= text.size()) {
        buffer.set_str(caret_x, y, " ", TUI_style.Style(foreground: MDV_theme.base_style(theme).foreground, background: MDV_theme.base_style(theme).background, attrs: TUI_style.REVERSE));
        return;
    }
    TUI_buffer.Cell here = buffer.get(caret_x, y);
    buffer.set_style(caret_x, y, here.style.with_attrs(here.style.attrs ^ TUI_style.REVERSE));
}

/// Mark columns `first` up to `stop` of row `y` as a link (OSC 8) the terminal
/// should know about. Whatever is drawn over them later takes the mark off.
void Screen.note_link(TUI_buffer.Buffer buffer, MDV_model.Span span, int first, int stop, int y) {
    if (caps.has_links && span.link >= 0 && span.has_bits(MDV_model.LINK) && stop > first && MDV_cat.is_openable(viewer.layout.links[span.link].href)) {
        buffer.link(TUI_geometry.Rect(first, y, stop - first, 1), viewer.layout.links[span.link].href);
    }
}

str Screen.file_marker() {
    match (viewer.files.index_of(viewer.name)) {
        case Some(int slot): {
            if (viewer.files.size() > 1) {
                return " [" + str(slot + 1) + "/" + str(viewer.files.size()) + "]";
            }
        }
        case None: {
        }
    }
    return "";
}

void Screen.draw_status(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int y = area.y + area.height - 1;
    TUI_style.Style style = MDV_theme.status_style(theme);
    buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", style);
    str pane_label = MDV_viewer.pane_name(viewer.pane);
    str right = count_text(viewer) + pane_label + "  " + str(viewer.percent()) + "%";
    if (viewer.is_editing()) {
        right = pane_label + "  Ln " + str(viewer.buffer.caret.row + 1) + ", Col " + str(MDV_edit.display_col(viewer.buffer.lines[viewer.buffer.caret.row], viewer.buffer.caret.col) + 1) + "  " + str(viewer.words()) + " words  " + theme.name;
    } else if (viewer.total() > 0) {
        int bottom = viewer.top + viewer.height();
        if (bottom > viewer.total()) {
            bottom = viewer.total();
        }
        right = count_text(viewer) + pane_label + "  " + str(bottom) + "/" + str(viewer.total()) + "  " + str(viewer.percent()) + "%";
    }
    int right_width = TUI_text.width(right);
    str left = "";
    bool is_prompt = false;
    match (viewer.mode) {
        case Search: {
            left = "/" + viewer.query;
        }
        case Prompt: {
            left = viewer.prompt_line();
            is_prompt = true;
        }
        case Normal: {
            if (viewer.message.size() > 0) {
                left = viewer.message;
            } else if (viewer.hover_link >= 0) {
                left = viewer.layout.links[viewer.hover_link].href;
            } else if (viewer.link >= 0) {
                left = viewer.layout.links[viewer.link].href;
            } else {
                left = viewer.name + file_marker();
                if (viewer.buffer.is_dirty()) {
                    left = "\u{25cf} " + left;
                }
                if (viewer.needle.size() > 0 && viewer.hits.size() > 0 && viewer.hit >= 0) {
                    left = left + "  /" + viewer.needle + " " + str(viewer.hit + 1) + "/" + str(viewer.hits.size());
                }
            }
        }
        case Outline: {
            left = "outline: j/k move, l/h open/close, Enter go, Esc close";
        }
        case Help: {
            left = "any key closes";
        }
        case Find: {
            left = viewer.name;
            if (viewer.message.size() > 0) {
                left = viewer.message;
            }
        }
        case Palette: {
            left = "type to filter, Up/Down choose, Enter run, Esc close";
        }
    }
    int room = area.width - right_width - 3;
    if (room < 4 || is_prompt) {
        room = area.width - 1;
        right = "";
    }
    TUI_style.Style left_style = style;
    if (is_prompt) {
        left_style = MDV_theme.accent_style(theme);
        buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", left_style);
    }
    buffer.set_str(area.x + 1, y, TUI_text.truncate(left, room), left_style);
    if (right.size() > 0) {
        buffer.set_str(area.x + area.width - right_width - 1, y, right, style);
    }
    match (viewer.mode) {
        case Search: {
            int cursor_x = area.x + 1 + TUI_text.width(left);
            if (cursor_x < area.x + area.width) {
                buffer.set_str(cursor_x, y, " ", TUI_style.Style(attrs: TUI_style.REVERSE));
            }
        }
        case Prompt: {
            if (viewer.prompt_kind == "saveas") {
                int cursor_x = area.x + 1 + TUI_text.width(left);
                if (cursor_x < area.x + area.width) {
                    buffer.set_str(cursor_x, y, " ", TUI_style.Style(attrs: TUI_style.REVERSE));
                }
            }
        }
        case Normal: {
        }
        case Outline: {
        }
        case Help: {
        }
        case Find: {
        }
        case Palette: {
        }
    }
}

void Screen.draw_outline(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_geometry.Rect box = popup_area(area, 64, area.height * 3 / 4);
    TUI_style.Style style = MDV_theme.popup_style(theme);
    buffer.fill(box, " ", style);
    TUI_widget.Block frame = TUI_widget.Block(borders: TUI_widget.Borders.Rounded, title: " Outline ", style: style, title_style: style.with_attrs(TUI_style.BOLD));
    frame.render(buffer, box);
    viewer.outline.style = style;
    viewer.outline.render(buffer, frame.inner(box));
}

void Screen.draw_help(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    List<TUI_menu.Item> all = help_items();
    int room = area.height - 4;
    if (room < 3) {
        room = 3;
    }
    int first = viewer.help_top;
    int most = all.size() - room;
    if (most < 0) {
        most = 0;
    }
    if (first > most) {
        first = most;
        viewer.help_top = most;
    }
    List<TUI_menu.Item> shown = [];
    for (int index in first .. all.size()) {
        if (shown.size() >= room) {
            break;
        }
        shown.push(all[index]);
    }
    TUI_style.Style style = MDV_theme.popup_style(theme);
    TUI_menu.WhichKey menu = TUI_menu.WhichKey("Keys", shown, style: style, title_style: style.with_attrs(TUI_style.BOLD));
    menu.render(buffer, area);
}

/// The top row: the outline button, the breadcrumb of headings above the
/// window, and on the right the three panes and the theme button.
void Screen.draw_header(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int y = area.y;
    TUI_style.Style bar = MDV_theme.status_style(theme);
    TUI_style.Style quiet = MDV_theme.quiet_style(theme);
    TUI_style.Style accent = MDV_theme.accent_style(theme);
    buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", bar);
    viewer.buttons = [];
    int column = area.x;
    TUI_style.Style side_button = bar;
    if (viewer.is_side_open) {
        side_button = accent;
    }
    column = column + buffer.set_str(column, y, " \u{2261} ", side_button);
    viewer.buttons.push(MDV_viewer.Button(0, column, MDV_actions.SIDEBAR));
    column = column + 1;
    str label = " " + theme.name + " ";
    int label_width = TUI_text.width(label) + 2;
    int tabs_width = 0;
    bool has_tabs = area.width >= 64;
    if (has_tabs) {
        tabs_width = 25;
    }
    int right_start = area.x + area.width - label_width - tabs_width - 1;
    int room = right_start - column - 1;
    if (viewer.buffer.is_dirty()) {
        column = column + buffer.set_str(column, y, "\u{25cf} ", bar.with_attrs(bar.attrs | TUI_style.BOLD));
        room = room - 2;
    }
    List<str> crumbs = viewer.crumbs();
    if (crumbs.size() == 0 || viewer.is_editing() && room < 30) {
        buffer.set_str(column, y, TUI_text.truncate(viewer.name, room), bar.with_attrs(bar.attrs | TUI_style.BOLD));
    } else {
        int used = 0;
        for (int index in 0 .. crumbs.size()) {
            if (index > 0 && used + 3 < room) {
                used = used + buffer.set_str(column + used, y, " \u{203a} ", quiet);
            }
            int left_over = room - used;
            if (left_over < 2) {
                break;
            }
            TUI_style.Style piece = bar;
            if (index + 1 == crumbs.size()) {
                piece = bar.with_attrs(bar.attrs | TUI_style.BOLD);
            }
            used = used + buffer.set_str(column + used, y, TUI_text.truncate(crumbs[index], left_over), piece);
        }
    }
    int start = right_start;
    if (has_tabs && start > column) {
        List<MDV_viewer.Pane> panes = [MDV_viewer.Pane.Preview, MDV_viewer.Pane.Source, MDV_viewer.Pane.Live];
        List<int> ids = [MDV_actions.PREVIEW, MDV_actions.SOURCE, MDV_actions.LIVE];
        int at_x = start;
        for (int index in 0 .. panes.size()) {
            str title = " " + MDV_viewer.pane_name(panes[index]) + " ";
            TUI_style.Style tab_style = bar;
            if (MDV_viewer.pane_name(panes[index]) == MDV_viewer.pane_name(viewer.pane)) {
                tab_style = accent;
            }
            int wide = buffer.set_str(at_x, y, title, tab_style);
            viewer.buttons.push(MDV_viewer.Button(at_x - area.x, at_x - area.x + wide, ids[index]));
            at_x = at_x + wide + 1;
        }
        start = at_x;
    }
    if (start > column) {
        buffer.set_str(start, y, "\u{25d0}" + label, accent);
        viewer.buttons.push(MDV_viewer.Button(start - area.x, area.width, MDV_actions.NEXT_THEME));
    }
}

/// The formatting toolbar of the editing panes: one clickable button for each
/// of the most used commands.
void Screen.draw_toolbar(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int y = area.y + 1;
    TUI_style.Style bar = MDV_theme.side_style(theme);
    TUI_style.Style quiet = MDV_theme.quiet_style(theme);
    buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", bar);
    viewer.tools = [];
    List<str> labels = ["B", "I", "S", "<>", "link", "H1", "H2", "\u{2022}", "1.", "\u{2610}", "\u{275d}", "\u{25a6}", "img", "```"];
    List<int> ids = [MDV_actions.BOLD, MDV_actions.ITALIC, MDV_actions.STRIKE, MDV_actions.CODE, MDV_actions.LINK, MDV_actions.HEADING_1, MDV_actions.HEADING_2, MDV_actions.BULLETS, MDV_actions.NUMBERS, MDV_actions.TASKS, MDV_actions.QUOTE, MDV_actions.TABLE, MDV_actions.IMAGE, MDV_actions.CODE_BLOCK];
    int column = area.x + 1;
    for (int index in 0 .. labels.size()) {
        str text = " " + labels[index] + " ";
        int wide = TUI_text.width(text);
        if (column + wide >= area.x + area.width) {
            break;
        }
        TUI_style.Style look = bar.with_attrs(bar.attrs | TUI_style.BOLD);
        if (ids[index] == MDV_actions.ITALIC) {
            look = bar.with_attrs(bar.attrs | TUI_style.ITALIC);
        } else if (ids[index] == MDV_actions.STRIKE) {
            look = bar.with_attrs(bar.attrs | TUI_style.STRIKE);
        } else if (ids[index] > MDV_actions.STRIKE && ids[index] != MDV_actions.CODE) {
            look = bar;
        }
        buffer.set_str(column, y, text, look);
        viewer.tools.push(MDV_viewer.Button(column - area.x, column - area.x + wide, ids[index]));
        column = column + wide;
        if (index == 3 || index == 4 || index == 6 || index == 10) {
            buffer.set_str(column, y, "\u{2502}", quiet.with_background(bar.background));
            column = column + 1;
        }
    }
}

/// The find bar (and the replace row) above the status line.
void Screen.draw_find(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int rows_needed = viewer.bar_rows();
    if (rows_needed == 0) {
        return;
    }
    int first_y = area.y + area.height - 1 - rows_needed;
    TUI_style.Style bar = MDV_theme.popup_style(theme);
    TUI_style.Style accent = MDV_theme.accent_style(theme);
    TUI_style.Style quiet = MDV_theme.quiet_style(theme).with_background(bar.background);
    buffer.fill(TUI_geometry.Rect(area.x, first_y, area.width, rows_needed), " ", bar);
    int found = viewer.finder.matches.size();
    int position = viewer.finder.current + 1;
    if (!viewer.is_editing()) {
        found = viewer.hits.size();
        position = viewer.hit + 1;
    }
    str count = "no results";
    if (found > 0 && position > 0) {
        count = str(position) + " of " + str(found);
    } else if (found > 0) {
        count = str(found) + " found";
    }
    if (viewer.finder.needle.size() == 0) {
        count = "";
    }
    str field = " Find: ";
    int column = area.x + buffer.set_str(area.x, first_y, field, quiet);
    TUI_style.Style typed = bar;
    if (!viewer.is_replace_focused) {
        typed = bar.with_attrs(bar.attrs | TUI_style.UNDERLINE);
    }
    column = column + buffer.set_str(column, first_y, viewer.finder.needle, typed);
    if (!viewer.is_replace_focused) {
        buffer.set_str(column, first_y, " ", TUI_style.Style(attrs: TUI_style.REVERSE));
    }
    str hint = count + "  Aa:alt-c  next:Enter  prev:Up  close:Esc ";
    int hint_x = area.x + area.width - TUI_text.width(hint);
    if (hint_x > column + 2) {
        buffer.set_str(hint_x, first_y, count, accent);
        buffer.set_str(hint_x + TUI_text.width(count), first_y, "  Aa:alt-c  next:Enter  prev:Up  close:Esc ", quiet);
    }
    if (viewer.is_replace) {
        int second_y = first_y + 1;
        int at_x = area.x + buffer.set_str(area.x, second_y, " Replace: ", quiet);
        TUI_style.Style replace_style = bar;
        if (viewer.is_replace_focused) {
            replace_style = bar.with_attrs(bar.attrs | TUI_style.UNDERLINE);
        }
        at_x = at_x + buffer.set_str(at_x, second_y, viewer.finder.replacement, replace_style);
        if (viewer.is_replace_focused) {
            buffer.set_str(at_x, second_y, " ", TUI_style.Style(attrs: TUI_style.REVERSE));
        }
        str hint2 = "replace:Enter  all:alt-a  switch:Tab ";
        int hint2_x = area.x + area.width - TUI_text.width(hint2);
        if (hint2_x > at_x + 2) {
            buffer.set_str(hint2_x, second_y, hint2, quiet);
        }
    }
}

/// The command palette: a box near the top with a query line and the
/// matching actions, the chosen one marked; where it was drawn is kept on
/// the viewer so a click can find a row.
void Screen.draw_palette(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    List<MDV_actions.Action> items = viewer.palette_items();
    int wide = 64;
    if (wide > area.width - 4) {
        wide = area.width - 4;
    }
    if (wide < 20) {
        return;
    }
    int tall = items.size();
    int limit = area.height - 6;
    if (limit > 12) {
        limit = 12;
    }
    if (limit < 3) {
        limit = 3;
    }
    if (tall > limit) {
        tall = limit;
    }
    int box_x = area.x + (area.width - wide) / 2;
    int box_y = area.y + 2;
    TUI_style.Style style = MDV_theme.popup_style(theme);
    TUI_style.Style accent = MDV_theme.accent_style(theme);
    TUI_style.Style quiet = MDV_theme.quiet_style(theme).with_background(style.background);
    TUI_geometry.Rect box = TUI_geometry.Rect(box_x, box_y, wide, tall + 3);
    buffer.fill(box, " ", style);
    TUI_widget.Block frame = TUI_widget.Block(borders: TUI_widget.Borders.Rounded, title: " Command palette ", style: style, title_style: style.with_attrs(TUI_style.BOLD));
    frame.render(buffer, box);
    int inner_x = box_x + 1;
    int inner_w = wide - 2;
    buffer.set_str(inner_x, box_y + 1, TUI_text.truncate("> " + viewer.query, inner_w - 1), style);
    buffer.set_str(inner_x + TUI_text.width("> " + viewer.query), box_y + 1, " ", TUI_style.Style(attrs: TUI_style.REVERSE));
    // Keep the chosen row in view.
    int first_item = 0;
    if (viewer.palette_pick >= tall) {
        first_item = viewer.palette_pick - tall + 1;
    }
    viewer.palette_y = box_y + 2;
    viewer.palette_x0 = box_x;
    viewer.palette_x1 = box_x + wide;
    viewer.palette_rows = tall;
    viewer.palette_first = first_item;
    for (int line in 0 .. tall) {
        int index = first_item + line;
        if (index >= items.size()) {
            break;
        }
        MDV_actions.Action each = items[index];
        TUI_style.Style row_style = style;
        TUI_style.Style keys_style = quiet;
        if (index == viewer.palette_pick) {
            row_style = accent;
            keys_style = accent;
            buffer.fill(TUI_geometry.Rect(inner_x, box_y + 2 + line, inner_w, 1), " ", accent);
        }
        buffer.set_str(inner_x + 1, box_y + 2 + line, TUI_text.truncate(each.title, inner_w - 14), row_style);
        if (each.keys.size() > 0) {
            int keys_width = TUI_text.width(each.keys);
            buffer.set_str(inner_x + inner_w - keys_width - 1, box_y + 2 + line, each.keys, keys_style);
        }
    }
    if (items.size() == 0) {
        buffer.set_str(inner_x + 1, box_y + 2, "no matching command", quiet);
    }
}

/// The docked outline: every heading, indented by level, the one the window
/// is in marked; a click on a row goes there.
void Screen.draw_side(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int wide = viewer.side_width();
    if (wide == 0) {
        return;
    }
    int height = viewer.height();
    int first_y = area.y + viewer.top_rows();
    TUI_style.Style style = MDV_theme.side_style(theme);
    buffer.fill(TUI_geometry.Rect(area.x, first_y, wide, height), " ", style);
    TUI_style.Style rule = MDV_theme.thumb_style(theme, false);
    for (int line in 0 .. height) {
        buffer.set_str(area.x + wide - 1, first_y + line, "\u{2502}", rule);
    }
    int current = viewer.heading_at(viewer.top);
    // Scroll the list so the current heading is on screen.
    if (current >= 0) {
        if (current < viewer.side_top) {
            viewer.side_top = current;
        }
        if (current >= viewer.side_top + height) {
            viewer.side_top = current - height + 1;
        }
    }
    int count = viewer.layout.headings.size();
    if (viewer.side_top > count - 1) {
        viewer.side_top = 0;
    }
    for (int line in 0 .. height) {
        int index = viewer.side_top + line;
        if (index >= count) {
            break;
        }
        MDV_model.Heading head = viewer.layout.headings[index];
        int pad = 2 * (head.level - 1);
        if (pad > wide / 2) {
            pad = wide / 2;
        }
        TUI_style.Style entry = style;
        str mark = "  ";
        if (index == current) {
            entry = MDV_theme.accent_style(theme);
            mark = "\u{25b8} ";
            buffer.fill(TUI_geometry.Rect(area.x, first_y + line, wide - 1, 1), " ", entry);
        } else if (head.level == 1) {
            entry = style.with_attrs(style.attrs | TUI_style.BOLD);
        }
        int room = wide - 1 - pad - 2;
        buffer.set_str(area.x + pad, first_y + line, mark + TUI_text.truncate(head.text, room), entry);
    }
}

/// A one-column scrollbar at the right edge: the thumb is the window.
void Screen.draw_scrollbar(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    int height = viewer.height();
    int x = area.x + area.width - 1;
    int total = viewer.total();
    int thumb = height;
    int start = 0;
    if (total > height) {
        thumb = height * height / total;
        if (thumb < 1) {
            thumb = 1;
        }
        int travel = height - thumb;
        if (viewer.max_top() > 0) {
            start = viewer.top * travel / viewer.max_top();
        }
    }
    for (int line in 0 .. height) {
        bool is_thumb = line >= start && line < start + thumb;
        str glyph = "\u{2502}";
        if (is_thumb) {
            glyph = "\u{2503}";
        }
        buffer.set_str(x, area.y + viewer.top_rows() + line, glyph, MDV_theme.thumb_style(theme, is_thumb));
    }
}

/// Queue the scaled headings, which are not cells, to be written after the
/// frame (`Loop.queue_output`: the loop has no hook after a frame).
void Screen.build_overlay() {
    bytes out = [];
    for (Region region in regions) {
        TUI_diff.move_to(out, region.x, region.y);
        TUI_style.sgr(out, TUI_style.RESET_STYLE, region.style, caps.depth);
        out.extend(MDV_cat.scaled_sequence(region.scale, region.text).to_bytes());
        TUI_style.push_reset(out);
    }
    if (out.size() > 0) {
        loop.queue_output(out);
    }
}

pub void Screen.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    if (viewer.new_theme.size() > 0) {
        if (viewer.new_theme == "next") {
            theme = MDV_theme.next_after(theme);
        } else {
            theme = MDV_theme.named(viewer.new_theme).or(theme);
        }
        viewer.new_theme = "";
    }
    regions = [];
    viewer.resize(area.width, area.height);
    buffer.fill(area, " ", MDV_theme.base_style(theme));
    int height = viewer.height();
    int x = area.x + viewer.left();
    int first_y = area.y + viewer.top_rows();
    int last_y = first_y + height - 1;
    caret_index = -1;
    if (viewer.is_editing()) {
        caret_index = viewer.caret_row();
    }
    for (int line in 0 .. height) {
        int index = viewer.top + line;
        if (index >= viewer.total()) {
            break;
        }
        draw_row(buffer, x, first_y + line, index, viewer.layout.rows[index], last_y);
    }
    draw_side(buffer, area);
    draw_scrollbar(buffer, area);
    draw_header(buffer, area);
    if (viewer.is_editing()) {
        draw_toolbar(buffer, area);
    }
    draw_find(buffer, area);
    draw_status(buffer, area);
    match (viewer.mode) {
        case Outline: {
            draw_outline(buffer, area);
        }
        case Help: {
            draw_help(buffer, area);
        }
        case Palette: {
            draw_palette(buffer, area);
        }
        case Normal: {
        }
        case Search: {
        }
        case Find: {
        }
        case Prompt: {
        }
    }
    build_overlay();
}

str count_text(MDV_viewer.Viewer viewer) {
    if (viewer.pending.size() > 0 && viewer.count > 0) {
        return str(viewer.count) + viewer.pending + " ";
    }
    if (viewer.pending.size() > 0) {
        return viewer.pending + " ";
    }
    if (viewer.count > 0) {
        return str(viewer.count) + " ";
    }
    return "";
}

TUI_geometry.Rect popup_area(TUI_geometry.Rect area, int wide, int tall) {
    int width = wide;
    if (width > area.width - 2) {
        width = area.width - 2;
    }
    int height = tall;
    if (height > area.height - 2) {
        height = area.height - 2;
    }
    if (width < 1) {
        width = 1;
    }
    if (height < 1) {
        height = 1;
    }
    return TUI_geometry.Rect(area.x + (area.width - width) / 2, area.y + (area.height - height) / 2, width, height);
}

pub List<TUI_menu.Item> help_items() {
    return [TUI_menu.Item("j k", "scroll a line (counts work: 5j)"), TUI_menu.Item("C-d C-u", "half a page down / up"), TUI_menu.Item("C-f C-b", "a page down / up (also Space, PgDn)"), TUI_menu.Item("gg G", "top / bottom (12G is row 12)"), TUI_menu.Item("]] [[", "next / previous heading"), TUI_menu.Item("/", "search; Enter runs it, Esc cancels"), TUI_menu.Item("n N", "next / previous match"), TUI_menu.Item("o", "outline of the headings"), TUI_menu.Item("Tab S-Tab", "focus the next / previous link"), TUI_menu.Item("Enter", "follow the focused link"), TUI_menu.Item("C-o Bksp", "back to where you were"), TUI_menu.Item("y", "yank the link, or the paragraph (OSC 52)"), TUI_menu.Item("r", "reload the file"), TUI_menu.Item("> <", "next / previous file"), TUI_menu.Item("Esc", "clear search, link focus, count"), TUI_menu.Item("?", "this help"), TUI_menu.Item("q", "quit")];
}
