// The terminal loop: `TUI_app.Loop.run` with three additions.
//
//   - a `Host` instead of a bare handler, so the program can be told when a
//     read timed out (`tick`, which is how a file changing on disk is noticed
//     with no key pressed) and can hand back raw bytes to write (`take_output`,
//     which is how an OSC 52 clipboard sequence gets to the terminal without
//     going through the cell buffer);
//   - an input descriptor that is not always 0: a viewer fed from a pipe
//     (`cat x.md | tui-markdown`) has no terminal on standard input, so keys
//     are read from standard output's terminal instead -- one tty file is both;
//   - otherwise as `TUI_app.Loop.run` documents: raw mode in, the terminal
//     restored on every path out by the `Session`'s destructor, resize noticed
//     once per tick, the first frame and every resized one drawn with
//     `TUI_diff.full`, the rest as a diff against the frame before.

import io;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.app.TUI_diff;
import tui.core.TUI_widget;

/// How long a read waits, which is also how long a held ESC waits for the
/// rest of a key sequence.
pub const int ESCAPE_WAIT_MS = 50;

/// What the loop asks of the program.
pub interface Host {
    /// One decoded event.
    TUI_app.Action handle(term.Event event);
    /// Called once per timed-out read. True: something changed, redraw.
    bool needs_redraw();
    /// Bytes to write to the terminal as they are, and forget; empty for none.
    bytes take_output();
}

/// The descriptor keys are read from: standard input if it is a terminal,
/// otherwise standard output if that is (a pipe on the left of a viewer), and
/// -1 when neither is.
pub int input_fd() {
    if (term.is_terminal(0)) {
        return 0;
    }
    if (term.is_terminal(1)) {
        return 1;
    }
    return -1;
}

pub Result<int, term.Error> run(TUI_app.Loop loop, TUI_widget.Widget view, Host host) {
    int in_fd = input_fd();
    if (in_fd < 0 || !term.is_terminal(1)) {
        return Result<int, term.Error>.Err(term.Error.NotATerminal);
    }
    match (term.raw(in_fd: in_fd, out_fd: 1)) {
        case Err(term.Error error): {
            return Result<int, term.Error>.Err(error);
        }
        case Ok(term.Session session): {
            session.on_exit(loop.leave);
            term.Writer writer = term.writer(io.stdout());
            writer.put(loop.enter);
            term.Reader reader = term.reader(descriptor: in_fd);
            term.Size window_size = TUI_app.screen_size();
            TUI_buffer.Buffer previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            TUI_buffer.Buffer next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            view.render(previous, previous.area());
            writer.put_bytes(TUI_diff.full(previous, loop.depth));
            flush(writer);
            bool is_running = true;
            int idle = 0;
            while (is_running) {
                bool should_redraw = false;
                // A lone Escape is only told from the start of an arrow key by
                // nothing following it, and `Reader.read` resolves it only when
                // a wait runs out -- so the wait is always short, and the idle
                // tick is counted out of those short waits.
                int wait = ESCAPE_WAIT_MS;
                match (reader.read(wait)) {
                    case Ok(term.Input inp): {
                        match (inp) {
                            case Got(term.Event event): {
                                match (host.handle(event)) {
                                    case Continue: {
                                    }
                                    case Redraw: {
                                        should_redraw = true;
                                    }
                                    case Quit: {
                                        is_running = false;
                                    }
                                }
                            }
                            case Timeout: {
                                idle = idle + ESCAPE_WAIT_MS;
                                if (idle >= loop.tick_ms) {
                                    idle = 0;
                                    if (host.needs_redraw()) {
                                        should_redraw = true;
                                    }
                                }
                            }
                            case End: {
                                is_running = false;
                            }
                        }
                    }
                    case Err(term.Error error): {
                        is_running = false;
                    }
                }
                bytes extra = host.take_output();
                if (extra.size() > 0) {
                    writer.put_bytes(extra);
                    flush(writer);
                }
                if (is_running) {
                    term.Size now = TUI_app.screen_size();
                    bool did_resize = TUI_app.has_resized(window_size, now);
                    window_size = now;
                    if (should_redraw || did_resize) {
                        if (did_resize) {
                            next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                            previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                        } else {
                            next.clear();
                        }
                        view.render(next, next.area());
                        if (did_resize) {
                            writer.put_bytes(TUI_diff.full(next, loop.depth));
                        } else {
                            writer.put_bytes(TUI_diff.diff(previous, next, loop.depth));
                        }
                        flush(writer);
                        TUI_buffer.Buffer shown = previous;
                        previous = next;
                        next = shown;
                    }
                }
            }
        }
    }
    return Result<int, term.Error>.Ok(0);
}

void flush(term.Writer writer) {
    match (writer.flush()) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}
